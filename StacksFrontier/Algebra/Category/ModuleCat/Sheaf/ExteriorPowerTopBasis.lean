module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.LinearAlgebra.Basis.Prod
public import Mathlib.LinearAlgebra.Determinant
public import Mathlib.LinearAlgebra.ExteriorPower.Basis
public import Mathlib.RingTheory.FiniteType
public import Mathlib.RingTheory.Length
import StacksCore.Tactic.StacksAttribute

/-!
# The top exterior power of a finite free module, and the top wedge of a split exact sequence

Let `R` be a commutative ring and `M` a free `R`-module with a basis indexed by `Fin n`. The
exterior power `⋀ⁿ M` is then free of rank one, on the single wedge `b₀ ∧ ⋯ ∧ b_{n-1}` of the
basis. For a short exact sequence `0 → M' → M → M'' → 0` of finite free modules with ordered
bases on the two ends, `M` has an ordered basis of the concatenated shape
`f(b'₀), …, f(b'_{r-1}), w₀, …, w_{m-1}`, so `⋀^{r+m} M` is generated by the single wedge
`f(b'₀) ∧ ⋯ ∧ f(b'_{r-1}) ∧ w₀ ∧ ⋯ ∧ w_{m-1}`.

## Main definitions

* `Stacks.ExteriorPower.topBasis`: the basis of `⋀ⁿ M` with the single member
  `b₀ ∧ ⋯ ∧ b_{n-1}`, for `b` an ordered basis of `M` of length `n`.
* `Stacks.ExteriorPower.splitEquiv`: the isomorphism `M' × M'' ≅ M` determined by a retraction
  of the quotient map of a short exact sequence.
* `Stacks.ExteriorPower.topEquiv`: the resulting identification `R ≅ ⋀ⁿ M`, sending `1` to that
  wedge.
* `Stacks.ExteriorPower.quotientRangeMapEquiv`: the cokernel of `⋀ⁿ f`, for `f` a map of free
  modules of rank `n`, identified with `R/(det f)`.

## Main results

* `Stacks.ExteriorPower.topBasis_apply`: the member of that basis is the wedge of the given
  basis.
* `Stacks.ExteriorPower.span_ιMulti_eq_top`: consequently `⋀ⁿ M` is generated by that single
  wedge.
* `Stacks.ExteriorPower.exists_basis_append`: an ordered basis of the middle term of a short
  exact sequence of free modules, of the concatenated shape described above.
* `Stacks.ExteriorPower.exists_span_ιMulti_append_eq_top`: the two combined — the top exterior
  power of the middle term is generated by one wedge of that shape.
* `Stacks.ExteriorPower.injective_of_surjective_of_basis_fin_one`: a surjection between free
  modules of rank one over a commutative ring is injective.
* `Stacks.ExteriorPower.surjective_of_span_singleton_eq_top`: a linear map whose image contains
  a generator of its target is surjective.
* `Stacks.ExteriorPower.map_ιMulti_eq_det_smul`: **the top exterior power of a map of free
  modules of rank `n` is multiplication by its determinant**, on the wedges of two ordered
  bases.
* `Stacks.ExteriorPower.length_quotient_range_map`: consequently the cokernel of `⋀ⁿ f` has the
  length of `R/(det f)` — the order of vanishing of the determinant.

## References

* [Stacks Project, Tag 0B38](https://stacks.math.columbia.edu/tag/0B38)
-/

@[expose] public section

universe u v

namespace Stacks.ExteriorPower

variable (R : Type u) [CommRing R] (n : ℕ) {M : Type v} [AddCommGroup M] [Module R M]

/-! ### The single index at the top degree -/

/-- The whole of `Fin n` is a subset of cardinality `n`. -/
theorem univ_mem_powersetCard : (Finset.univ : Finset (Fin n)) ∈ Set.powersetCard (Fin n) n :=
  Set.powersetCard.mem_iff.2 (by rw [Finset.card_univ, Fintype.card_fin])

/-- The unique subset of `Fin n` of cardinality `n`. -/
def topIndex : Set.powersetCard (Fin n) n := ⟨Finset.univ, univ_mem_powersetCard n⟩

/-- A subset of `Fin n` of cardinality `n` is the whole of it. -/
theorem coe_eq_univ (s : Set.powersetCard (Fin n) n) :
    (s : Finset (Fin n)) = Finset.univ :=
  Finset.eq_univ_of_card _ (by rw [Set.powersetCard.card_eq s, Fintype.card_fin])

/-- At the top degree the index set of the exterior-power basis is a singleton. -/
def topIndexEquiv : Set.powersetCard (Fin n) n ≃ Fin 1 where
  toFun _ := 0
  invFun _ := topIndex n
  left_inv s := Subtype.ext (coe_eq_univ n s).symm
  right_inv _ := Subsingleton.elim _ _

/-- The monotone enumeration of the whole of `Fin n` is the identity. -/
theorem ofFinEmbEquiv_symm_topIndex_apply (i : Fin n) :
    Set.powersetCard.ofFinEmbEquiv.symm (topIndex n) i = i :=
  (OrderEmbedding.strictMono _).apply_eq

/-! ### The top exterior power of a finite free module -/

variable {R n}

/-- **The top exterior power of a free module of rank `n` is free of rank one**, on the wedge of
the given ordered basis. -/
noncomputable def topBasis (b : Module.Basis (Fin n) R M) :
    Module.Basis (Fin 1) R (⋀[R]^n M) :=
  (b.exteriorPower n).reindex (topIndexEquiv n)

/-- The single member of `Stacks.ExteriorPower.topBasis` is the wedge of the given basis. -/
theorem topBasis_apply (b : Module.Basis (Fin n) R M) :
    topBasis b 0 = exteriorPower.ιMulti R n (b : Fin n → M) := by
  rw [topBasis, Module.Basis.reindex_apply, exteriorPower.basis_apply]
  exact congrArg (exteriorPower.ιMulti R n)
    (funext fun i => congrArg b (ofFinEmbEquiv_symm_topIndex_apply n i))

/-- **The top exterior power of a free module of rank `n` is generated by the wedge of an
ordered basis.** -/
theorem span_ιMulti_eq_top (b : Module.Basis (Fin n) R M) :
    Submodule.span R {exteriorPower.ιMulti R n (b : Fin n → M)} = ⊤ := by
  rw [← topBasis_apply b, ← (topBasis b).span_eq]
  exact congrArg _ Set.range_unique.symm

/-! ### The top exterior power of a map of free modules of rank `n` -/

section Determinant

variable {N : Type*} [AddCommGroup N] [Module R N]

/-- The determinant of the matrix of `f` is the value of the determinant form of the target
basis on the images of the source basis. -/
theorem basis_det_comp (b : Module.Basis (Fin n) R M) (b' : Module.Basis (Fin n) R N)
    (f : M →ₗ[R] N) : b'.det (⇑f ∘ ⇑b) = (LinearMap.toMatrix b b' f).det := by
  rw [Module.Basis.det_apply]
  refine congrArg Matrix.det (Matrix.ext fun i j => ?_)
  rw [Module.Basis.toMatrix_apply, LinearMap.toMatrix_apply, Function.comp_apply]

/-- **The top exterior power of a map of free modules of rank `n` is multiplication by its
determinant.** It carries the wedge of an ordered basis of the source to `det f` times the
wedge of an ordered basis of the target. -/
theorem map_ιMulti_eq_det_smul (b : Module.Basis (Fin n) R M)
    (b' : Module.Basis (Fin n) R N) (f : M →ₗ[R] N) :
    exteriorPower.map n f (exteriorPower.ιMulti R n (b : Fin n → M)) =
      (LinearMap.toMatrix b b' f).det • exteriorPower.ιMulti R n (b' : Fin n → N) := by
  rw [exteriorPower.map_apply_ιMulti]
  obtain ⟨c, hc⟩ : ∃ c : R, c • exteriorPower.ιMulti R n (b' : Fin n → N) =
      exteriorPower.ιMulti R n (⇑f ∘ ⇑b) :=
    Submodule.mem_span_singleton.mp (by rw [span_ιMulti_eq_top b']; trivial)
  have hL := congrArg (exteriorPower.alternatingMapLinearEquiv b'.det) hc
  rw [map_smul, exteriorPower.alternatingMapLinearEquiv_apply_ιMulti,
    exteriorPower.alternatingMapLinearEquiv_apply_ιMulti, Module.Basis.det_self,
    smul_eq_mul, mul_one, basis_det_comp b b' f] at hL
  rw [← hc, hL]

/-- The identification of the top exterior power of a free module of rank `n` with the ring,
carrying `1` to the wedge of the given ordered basis. -/
noncomputable def topEquiv (b' : Module.Basis (Fin n) R N) : R ≃ₗ[R] ⋀[R]^n N :=
  (Module.Basis.singleton (Fin 1) R).equiv (topBasis b') (Equiv.refl (Fin 1))

/-- `Stacks.ExteriorPower.topEquiv` carries `1` to the wedge of the basis. -/
theorem topEquiv_apply_one (b' : Module.Basis (Fin n) R N) :
    topEquiv b' 1 = exteriorPower.ιMulti R n (b' : Fin n → N) := by
  have h1 : (1 : R) = Module.Basis.singleton (Fin 1) R 0 := by
    rw [Module.Basis.singleton_apply]
  rw [h1, topEquiv, Module.Basis.equiv_apply, Equiv.refl_apply, topBasis_apply]

/-- `Stacks.ExteriorPower.topEquiv` carries a scalar to that multiple of the wedge. -/
theorem topEquiv_apply (b' : Module.Basis (Fin n) R N) (c : R) :
    topEquiv b' c = c • exteriorPower.ιMulti R n (b' : Fin n → N) := by
  rw [← topEquiv_apply_one b', ← map_smul, smul_eq_mul, mul_one]

/-- **The image of the top exterior power of `f` is the determinant ideal**, read through the
rank-one identification of the target with the ring. -/
theorem range_map_eq_map_span (b : Module.Basis (Fin n) R M)
    (b' : Module.Basis (Fin n) R N) (f : M →ₗ[R] N) :
    LinearMap.range (exteriorPower.map n f) =
      Submodule.map (topEquiv b').toLinearMap
        (Ideal.span {(LinearMap.toMatrix b b' f).det}) := by
  rw [LinearMap.range_eq_map, ← span_ιMulti_eq_top b, Submodule.map_span, Submodule.map_span,
    Set.image_singleton, Set.image_singleton, map_ιMulti_eq_det_smul b b' f,
    LinearEquiv.coe_coe, topEquiv_apply]

/-- **The cokernel of the top exterior power of a map of free modules of rank `n` is the
quotient of the ring by the determinant.** -/
noncomputable def quotientRangeMapEquiv (b : Module.Basis (Fin n) R M)
    (b' : Module.Basis (Fin n) R N) (f : M →ₗ[R] N) :
    (R ⧸ Ideal.span {(LinearMap.toMatrix b b' f).det}) ≃ₗ[R]
      (⋀[R]^n N ⧸ LinearMap.range (exteriorPower.map n f)) :=
  Submodule.Quotient.equiv _ _ (topEquiv b') (range_map_eq_map_span b b' f).symm

/-- **The cokernel of the top exterior power of `f` has the length of `R/(det f)`**, which over
a discrete valuation ring is the order of vanishing of the determinant. -/
theorem length_quotient_range_map (b : Module.Basis (Fin n) R M)
    (b' : Module.Basis (Fin n) R N) (f : M →ₗ[R] N) :
    Module.length R (⋀[R]^n N ⧸ LinearMap.range (exteriorPower.map n f)) =
      Module.length R (R ⧸ Ideal.span {(LinearMap.toMatrix b b' f).det}) :=
  (quotientRangeMapEquiv b b' f).length_eq.symm

end Determinant

/-! ### Rank-one modules -/

/-- The product of two singletons is a singleton. -/
def finOneProdEquiv : Fin 1 × Fin 1 ≃ Fin 1 where
  toFun _ := 0
  invFun _ := (0, 0)
  left_inv _ := Prod.ext (Subsingleton.elim _ _) (Subsingleton.elim _ _)
  right_inv _ := Subsingleton.elim _ _

/-- **A surjection between free modules of rank one is injective.** -/
theorem injective_of_surjective_of_basis_fin_one {R : Type u} [CommRing R]
    {L N : Type*} [AddCommGroup L] [Module R L] [AddCommGroup N] [Module R N]
    (bL : Module.Basis (Fin 1) R L) (bN : Module.Basis (Fin 1) R N)
    (φ : L →ₗ[R] N) (hφ : Function.Surjective φ) : Function.Injective φ :=
  have : Module.Finite R N := Module.Finite.of_basis bN
  OrzechProperty.injective_of_surjective_of_injective
    (bL.equiv bN (Equiv.refl (Fin 1))).toLinearMap φ
    (bL.equiv bN (Equiv.refl (Fin 1))).injective hφ

/-- **A linear map whose image contains a generator of its target is surjective.** The target is
identified through an isomorphism `e`, and the generator is a single element spanning everything.
-/
theorem surjective_of_span_singleton_eq_top {R : Type u} [CommRing R]
    {L N P : Type*} [AddCommGroup L] [Module R L] [AddCommGroup N] [Module R N]
    [AddCommGroup P] [Module R P] (ψ : L →ₗ[R] N) (e : N ≃ₗ[R] P) {v : P}
    (hv : Submodule.span R {v} = ⊤) (ξ : L) (hξ : e (ψ ξ) = v) :
    Function.Surjective ψ := by
  intro ζ
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 (Submodule.eq_top_iff'.1 hv (e ζ))
  refine ⟨c • ξ, e.injective ?_⟩
  rw [map_smul, map_smul, hξ, hc]

/-! ### An ordered basis of the middle term of a short exact sequence -/

section SplitExact

variable {R : Type u} [CommRing R] {M' M M'' : Type u}
  [AddCommGroup M'] [Module R M'] [AddCommGroup M] [Module R M]
  [AddCommGroup M''] [Module R M'']

/-- The isomorphism `M' × M'' ≅ M` determined by a retraction of the quotient map of a short
exact sequence `0 → M' → M → M'' → 0`. -/
noncomputable def splitEquiv (fl : M' →ₗ[R] M) (gl : M →ₗ[R] M'') (σ : M'' →ₗ[R] M)
    (hf : Function.Injective fl) (hex : LinearMap.range fl = LinearMap.ker gl)
    (hσ : ∀ c, gl (σ c) = c) :
    (M' × M'') ≃ₗ[R] M := by
  refine LinearEquiv.ofBijective (fl.coprod σ) ⟨fun p q hpq => ?_, fun y => ?_⟩
  · have hgf : ∀ x, gl (fl x) = 0 := fun x => by
      rw [← LinearMap.mem_ker, ← hex]
      exact ⟨x, rfl⟩
    have h2 : p.2 = q.2 := by simpa [hgf, hσ] using congrArg gl hpq
    exact Prod.ext (hf (by simpa [h2] using hpq)) h2
  · have hy : y - σ (gl y) ∈ LinearMap.ker gl := by
      rw [LinearMap.mem_ker, map_sub, hσ, sub_self]
    obtain ⟨a, ha⟩ := hex ▸ hy
    exact ⟨(a, gl y), by rw [LinearMap.coprod_apply, ha]; abel⟩

/-- **An ordered basis of the middle term of a short exact sequence of free modules.** Its first
`r` members are the images of the given basis of the sub, and its last `m` members are the
images of the given basis of the quotient under a retraction. -/
theorem exists_basis_append (fl : M' →ₗ[R] M) (gl : M →ₗ[R] M'')
    (hf : Function.Injective fl) (hg : Function.Surjective gl)
    (hex : LinearMap.range fl = LinearMap.ker gl)
    {r m : ℕ} (b' : Module.Basis (Fin r) R M') (b'' : Module.Basis (Fin m) R M'') :
    ∃ (w : Fin m → M) (bM : Module.Basis (Fin (r + m)) R M),
      (bM : Fin (r + m) → M) = Fin.append (fun i => fl (b' i)) w := by
  have hfree : Module.Free R M'' := Module.Free.of_basis b''
  have hproj : Module.Projective R M'' := Module.Projective.of_free
  obtain ⟨σ, hσ⟩ := Module.projective_lifting_property gl (LinearMap.id (R := R) (M := M'')) hg
  set e := splitEquiv fl gl σ hf hex fun c => LinearMap.congr_fun hσ c
  have he : ∀ p, e p = fl p.1 + σ p.2 := fun p => LinearMap.coprod_apply _ _ p
  refine ⟨fun j => σ (b'' j), ((b'.prod b'').map e).reindex finSumFinEquiv, funext fun i => ?_⟩
  refine Fin.addCases (fun i => ?_) (fun j => ?_) i <;> simp [he]

/-- **The top exterior power of the middle term of a short exact sequence of free modules is
generated by a single wedge of the concatenated shape.** The first `r` factors are the images of
a basis of the sub, and the last `m` are arbitrary. -/
theorem exists_span_ιMulti_append_eq_top (fl : M' →ₗ[R] M) (gl : M →ₗ[R] M'')
    (hf : Function.Injective fl) (hg : Function.Surjective gl)
    (hex : LinearMap.range fl = LinearMap.ker gl)
    {r m : ℕ} (b' : Module.Basis (Fin r) R M') (b'' : Module.Basis (Fin m) R M'') :
    ∃ (w : Fin m → M) (bM : Module.Basis (Fin (r + m)) R M),
      (bM : Fin (r + m) → M) = Fin.append (fun i => fl (b' i)) w ∧
        Submodule.span R {exteriorPower.ιMulti R (r + m) (Fin.append (fun i => fl (b' i)) w)}
          = ⊤ := by
  obtain ⟨w, bM, hbM⟩ := exists_basis_append fl gl hf hg hex b' b''
  exact ⟨w, bM, hbM, hbM ▸ span_ιMulti_eq_top bM⟩

end SplitExact

end Stacks.ExteriorPower

end
