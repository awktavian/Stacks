module

public import Mathlib.Topology.Spectral.ConstructibleTopology
public import Mathlib.Topology.Spectral.Basic
public import Mathlib.Topology.WithTopology
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The constructible topology on a spectral space

The constructible topology `constructibleTopology X` is generated by the quasi-compact opens
and their complements; `WithConstructibleTopology X` is the type synonym carrying it, and it is
quasi-compact (`compactSpace_withConstructibleTopology`, Stacks 0901).

This module adds the separation and functoriality facts:

* `t2Space_withConstructibleTopology`: on a spectral space the constructible topology is
  Hausdorff. Spectral spaces are Kolmogorov and have a basis of quasi-compact opens, so two
  distinct points are separated by a quasi-compact open `U`; both `U` and `Uᶜ` are
  constructible-open, and they are disjoint.
* `IsSpectralMap.continuous_withConstructibleTopology`: a spectral map is continuous for the
  constructible topologies. Only the subbasis has to be checked, and a spectral map pulls a
  quasi-compact open back to a quasi-compact open.

Two consequences of these that consumers reach for constantly are also here:
`IsSpectralMap.isClosedMap_constructibleTopology` (a spectral map is closed for the
constructible topologies, since the source is quasi-compact and the target Hausdorff) and
`exists_isClopen_constructibleTopology_of_mem_isOpen`, which turns an open set separating two
points of a prespectral space into a constructible-clopen one; the latter is the engine of both
the Hausdorff and the totally-separated halves of Stacks 0901.

Further utilities that the same arguments need are collected here rather than repeated:
`constructibleTopology_le`, saying the constructible topology refines the original one on a
prespectral space (so constructible-compactness implies compactness, which is
`IsClosed.isCompact_constructibleTopology` and `IsClosed.isCompact_of_constructibleTopology`), and
`Topology.exists_forall_isCompact_isOpen_mem_iff`, which produces for every ultrafilter `𝒰` on
a spectral space a point lying exactly in the quasi-compact opens belonging to `𝒰`. The latter
is the sober-space limit point of `𝒰`, obtained by taking the generic point of the closed
irreducible set `⋂ {Uᶜ | U quasi-compact open, U ∉ 𝒰}`; it is the workhorse behind every
compactness argument for the constructible topology in Stacks 5.24.

Each statement is given both in the `WithConstructibleTopology` spelling, which is the
idiomatic one, and — where downstream files build product and limit topologies out of
`constructibleTopology` by hand — in the explicit `@... (constructibleTopology X)` spelling.

## Implementation notes

`WithConstructibleTopology X` is Mathlib's `WithTopology X (constructibleTopology X)`, a
one-field structure wrapping `X`, so it is *not* definitionally `X`. Following the idiom of
`Topology.WithLower`/`Topology.WithUpper` and of `CofiniteTopology.of`, the identity
equivalences between the two types are named and used explicitly:
`WithConstructibleTopology.toConstructible : X ≃ WithConstructibleTopology X` and its inverse
`WithConstructibleTopology.ofConstructible`, packaged as the homeomorphism
`WithConstructibleTopology.homeomorph` onto `X` carrying the constructible topology, and used
to transport a map through `WithConstructibleTopology.map`. A set `s : Set X` is carried over as
`ofConstructible ⁻¹' s`, and `isOpen_preimage_ofConstructible` /
`isClosed_preimage_ofConstructible` say that this preserves openness and closedness in both
directions.

The instance-implicit `TopologicalSpace` argument of a lemma like `Homeomorph.symm`,
`IsClopen.compl` or `Continuous.comp` is synthesized *before* it is unified with a supplied
non-instance topology, so every call site below that feeds it `constructibleTopology X` is
written with an explicit `@` and pinned topologies. Dot notation on a hypothesis whose topology
is `constructibleTopology X` fails for the same reason.
-/

@[expose] public section

open Set Topology TopologicalSpace

/-- A set that is compact for a finer topology is compact for any coarser one. Recall that
`t₁ ≤ t₂` means that every `t₂`-open set is `t₁`-open, i.e. that `t₁` is the finer topology. -/
theorem isCompact_of_le_of_isCompact {X : Type*} {t₁ t₂ : TopologicalSpace X} (h : t₁ ≤ t₂)
    {s : Set X} (hs : @IsCompact X t₁ s) : @IsCompact X t₂ s :=
  @isCompact_of_finite_subcover X t₂ s fun {ι} U hUo hsU =>
    @IsCompact.elim_finite_subcover X t₁ s ι hs U (fun i => h _ (hUo i)) hsU

variable {X : Type*} [TopologicalSpace X] {Y : Type*} [TopologicalSpace Y]

namespace WithConstructibleTopology

/-- `ofConstructible` is the identity equivalence from the constructible-topology copy of `X`
back to `X`. -/
def ofConstructible : WithConstructibleTopology X ≃ X :=
  WithTopology.equiv X (constructibleTopology X)

/-- `toConstructible` is the identity equivalence from `X` onto its constructible-topology
copy. -/
def toConstructible : X ≃ WithConstructibleTopology X :=
  (ofConstructible (X := X)).symm

/-- The inverse of `ofConstructible` is `toConstructible`. -/
@[simp] lemma ofConstructible_symm : (ofConstructible (X := X)).symm = toConstructible := rfl

/-- The inverse of `toConstructible` is `ofConstructible`. -/
@[simp] lemma toConstructible_symm : (toConstructible (X := X)).symm = ofConstructible := rfl

/-- `ofConstructible` undoes `toConstructible`. -/
@[simp] lemma ofConstructible_toConstructible (x : X) : ofConstructible (toConstructible x) = x :=
  rfl

/-- `toConstructible` undoes `ofConstructible`. -/
@[simp] lemma toConstructible_ofConstructible (x : WithConstructibleTopology X) :
    toConstructible (ofConstructible x) = x := rfl

/-- A set of `X` is carried to `WithConstructibleTopology X` by taking its preimage under
`ofConstructible`, and this is open exactly when the original set is constructible-open. -/
lemma isOpen_preimage_ofConstructible {s : Set X} :
    IsOpen (ofConstructible ⁻¹' s : Set (WithConstructibleTopology X)) ↔
      IsOpen[constructibleTopology X] s :=
  WithConstructibleTopology.isOpen_iff

/-- The companion of `isOpen_preimage_ofConstructible` for closed sets: carrying a set of `X`
over to `WithConstructibleTopology X` preserves closedness in both directions. -/
lemma isClosed_preimage_ofConstructible {s : Set X} :
    IsClosed (ofConstructible ⁻¹' s : Set (WithConstructibleTopology X)) ↔
      IsClosed[constructibleTopology X] s :=
  WithConstructibleTopology.isClosed_iff

variable (X) in
/-- `WithConstructibleTopology X` is homeomorphic to `X` carrying the constructible topology;
the underlying map is the identity. This is what transports statements between the two
spellings. -/
def homeomorph : @Homeomorph (WithConstructibleTopology X) X _ (constructibleTopology X) :=
  @Homeomorph.mk (WithConstructibleTopology X) X _ (constructibleTopology X) ofConstructible
    (WithTopology.continuous_ofTopology _) (WithTopology.continuous_toTopology _)

/-- `f : X → Y` read as a map between the constructible-topology copies of `X` and `Y`. -/
def map (f : X → Y) : WithConstructibleTopology X → WithConstructibleTopology Y :=
  toConstructible ∘ f ∘ ofConstructible

/-- `map f` sends `x` to `toConstructible (f (ofConstructible x))`. -/
@[simp] lemma map_apply (f : X → Y) (x : WithConstructibleTopology X) :
    map f x = toConstructible (f (ofConstructible x)) := rfl

end WithConstructibleTopology

/-- On a prespectral space the constructible topology refines the original topology: every
open set is constructible-open, because the quasi-compact opens form a basis and each of them
is a subbasic constructible open. -/
@[ega "IV 1.9.14" "(i)"]
theorem constructibleTopology_le (X : Type*) [t : TopologicalSpace X] [PrespectralSpace X] :
    constructibleTopology X ≤ t := by
  intro U hU
  rw [(PrespectralSpace.isTopologicalBasis (X := X)).open_eq_sUnion' hU]
  refine @isOpen_sUnion X (constructibleTopology X) _ fun V hV => ?_
  obtain ⟨⟨hVo, hVc⟩, -⟩ := hV
  exact hVc.isOpen_constructibleTopology_of_isOpen hVo

/-- On a prespectral space a closed set is closed in the constructible topology, since the
constructible topology refines the original one. -/
theorem IsClosed.isClosed_constructibleTopology [PrespectralSpace X] {s : Set X}
    (hs : IsClosed s) : @IsClosed X (constructibleTopology X) s :=
  (@isOpen_compl_iff X s (constructibleTopology X)).mp
    (constructibleTopology_le X _ hs.isOpen_compl)

/-- A quasi-compact open set is clopen in the constructible topology: it is a subbasic open, and
so is its complement. -/
theorem IsCompact.isClopen_constructibleTopology {s : Set X} (hs : IsCompact s) (ho : IsOpen s) :
    @IsClopen X (constructibleTopology X) s :=
  ⟨(@isOpen_compl_iff X s (constructibleTopology X)).mp
      (IsCompact.isOpen_constructibleTopology_of_isClosed (s := sᶜ) (by rwa [compl_compl])
        ho.isClosed_compl),
    hs.isOpen_constructibleTopology_of_isOpen ho⟩

/-- In a prespectral space, an open neighbourhood of a point contains a quasi-compact open one. -/
private theorem exists_isOpen_isCompact_mem_subset [PrespectralSpace X] {U : Set X}
    (hU : IsOpen U) {z : X} (hz : z ∈ U) : ∃ V : Set X, (IsOpen V ∧ IsCompact V) ∧ z ∈ V ∧ V ⊆ U :=
  (PrespectralSpace.isTopologicalBasis (X := X)).exists_subset_of_mem_open hz hU

/-- On a prespectral space, two points separated by an open set are separated by a set that is
clopen for the constructible topology: shrink the open set to a quasi-compact open one using the
basis, and a quasi-compact open set is constructible-clopen. -/
theorem exists_isClopen_constructibleTopology_of_mem_isOpen [PrespectralSpace X] {U : Set X}
    (hU : IsOpen U) {z w : X} (hz : z ∈ U) (hw : w ∉ U) :
    ∃ V : Set X, @IsClopen X (constructibleTopology X) V ∧ z ∈ V ∧ w ∉ V := by
  obtain ⟨V, ⟨hVo, hVc⟩, hzV, hVU⟩ := exists_isOpen_isCompact_mem_subset hU hz
  exact ⟨V, hVc.isClopen_constructibleTopology hVo, hzV, fun h => hw (hVU h)⟩

open WithConstructibleTopology in
/-- The constructible topology is Hausdorff. Together with
`compactSpace_withConstructibleTopology` this is Stacks 0901.

Only `T0Space` and `PrespectralSpace` are needed, not the full `SpectralSpace`: the proof
uses just a quasi-compact-open basis and the separation of two distinct points by an open
set. Both follow from `SpectralSpace`, so this fires wherever the spectral version would. -/
@[ega "IV 1.9.15" "(ii), (iii)"]
instance t2Space_withConstructibleTopology [T0Space X] [PrespectralSpace X] :
    T2Space (WithConstructibleTopology X) where
  t2 x y hxy := by
    obtain ⟨U, hUo, hU⟩ := exists_isOpen_xor_mem (X := X)
      (show ofConstructible x ≠ ofConstructible y from fun h => hxy (ofConstructible.injective h))
    -- The separating pair is `V` and `Vᶜ`, carried across by `ofConstructible ⁻¹' _`.
    rcases hU with ⟨hx, hy⟩ | ⟨hy, hx⟩
    · obtain ⟨V, hV, hxV, hyV⟩ := exists_isClopen_constructibleTopology_of_mem_isOpen hUo hx hy
      exact ⟨ofConstructible ⁻¹' V, ofConstructible ⁻¹' Vᶜ,
        isOpen_preimage_ofConstructible.mpr hV.2,
        isOpen_preimage_ofConstructible.mpr (@IsClopen.compl X (constructibleTopology X) V hV).2,
        hxV, hyV, disjoint_compl_right.preimage _⟩
    · obtain ⟨V, hV, hyV, hxV⟩ := exists_isClopen_constructibleTopology_of_mem_isOpen hUo hy hx
      exact ⟨ofConstructible ⁻¹' Vᶜ, ofConstructible ⁻¹' V,
        isOpen_preimage_ofConstructible.mpr (@IsClopen.compl X (constructibleTopology X) V hV).2,
        isOpen_preimage_ofConstructible.mpr hV.2,
        hxV, hyV, disjoint_compl_left.preimage _⟩

/-- `t2Space_withConstructibleTopology` in the explicit-topology spelling, for use where the
constructible topology is fed to `Pi.topologicalSpace` or `TopologicalSpace.induced`. It is
transported along the homeomorphism `WithConstructibleTopology.homeomorph`. -/
theorem t2Space_constructibleTopology (X : Type*) [TopologicalSpace X] [SpectralSpace X] :
    @T2Space X (constructibleTopology X) :=
  @Homeomorph.t2Space (WithConstructibleTopology X) X _ (constructibleTopology X) _
    (WithConstructibleTopology.homeomorph X)

/-- `compactSpace_withConstructibleTopology` in the explicit-topology spelling, transported
along the same homeomorphism. -/
theorem compactSpace_constructibleTopology (X : Type*) [TopologicalSpace X] [SpectralSpace X] :
    @CompactSpace X (constructibleTopology X) :=
  @Homeomorph.compactSpace (WithConstructibleTopology X) X _ (constructibleTopology X) _
    (WithConstructibleTopology.homeomorph X)

/-- A constructibly closed subset of a spectral space is quasi-compact for the constructible
topology, that topology being quasi-compact. -/
@[ega "IV 1.9.15" "(i), special case"]
theorem IsClosed.isCompact_constructibleTopology [SpectralSpace X] {s : Set X}
    (hs : @IsClosed X (constructibleTopology X) s) : @IsCompact X (constructibleTopology X) s :=
  @IsClosed.isCompact X (constructibleTopology X) s (compactSpace_constructibleTopology X) hs

/-- A constructibly closed subset of a spectral space is quasi-compact for the original topology
as well, since the constructible topology is the finer of the two. -/
theorem IsClosed.isCompact_of_constructibleTopology [SpectralSpace X] {s : Set X}
    (hs : @IsClosed X (constructibleTopology X) s) : IsCompact s :=
  isCompact_of_le_of_isCompact (constructibleTopology_le X) hs.isCompact_constructibleTopology

/-- A spectral map is continuous for the constructible topologies: it suffices to pull back the
subbasis, and a spectral map pulls a quasi-compact open back to a quasi-compact open. -/
theorem IsSpectralMap.continuous_constructibleTopology {f : X → Y} (hf : IsSpectralMap f) :
    @Continuous X Y (constructibleTopology X) (constructibleTopology Y) f := by
  rw [show constructibleTopology Y = .generateFrom (constructibleTopologySubbasis Y) from rfl,
    @continuous_generateFrom_iff X Y f (constructibleTopology X)]
  rintro s (⟨hso, hsc⟩ | ⟨hsc, hsc'⟩)
  · exact (hf.isCompact_preimage_of_isOpen hso hsc).isOpen_constructibleTopology_of_isOpen
      (hf.continuous.isOpen_preimage s hso)
  · refine IsCompact.isOpen_constructibleTopology_of_isClosed ?_ (hsc.preimage hf.continuous)
    rw [← preimage_compl]
    exact hf.isCompact_preimage_of_isOpen hsc.isOpen_compl hsc'

/-- A spectral map between spectral spaces is a closed map for the constructible topologies: it
is continuous for them, the source is quasi-compact and the target is Hausdorff. -/
@[ega "IV 1.9.14" "(iv), first assertion"]
theorem IsSpectralMap.isClosedMap_constructibleTopology [SpectralSpace X] [SpectralSpace Y]
    {f : X → Y} (hf : IsSpectralMap f) :
    @IsClosedMap X Y (constructibleTopology X) (constructibleTopology Y) f := fun s hs =>
  @IsCompact.isClosed Y (constructibleTopology Y) (t2Space_constructibleTopology Y) _
    (@IsCompact.image X Y (constructibleTopology X) (constructibleTopology Y) s f
      hs.isCompact_constructibleTopology hf.continuous_constructibleTopology)

/-- `IsSpectralMap.continuous_constructibleTopology` in the `WithConstructibleTopology`
spelling: `f` read as a map `WithConstructibleTopology X → WithConstructibleTopology Y` is
continuous. -/
theorem IsSpectralMap.continuous_withConstructibleTopology {f : X → Y} (hf : IsSpectralMap f) :
    Continuous (WithConstructibleTopology.map f) :=
  -- The topologies of the two `Continuous.comp`s have to be supplied, since the intermediate
  -- ones are the constructible topologies rather than the ambient instances.
  @Continuous.comp (WithConstructibleTopology X) Y (WithConstructibleTopology Y) _
    (constructibleTopology Y) _ _ _ (WithTopology.continuous_toTopology _)
    (@Continuous.comp (WithConstructibleTopology X) X Y _ (constructibleTopology X)
      (constructibleTopology Y) _ _ hf.continuous_constructibleTopology
      (WithTopology.continuous_ofTopology _))

namespace Topology

/-- Every ultrafilter `𝒰` on a spectral space has a point that belongs to exactly the
quasi-compact opens lying in `𝒰`. Take `Z = ⋂ {Uᶜ | U quasi-compact open, U ∉ 𝒰}`; it is closed,
and irreducible because the quasi-compact opens meeting it are closed under intersection along
`𝒰`. Its generic point, supplied by soberness, is the required point. -/
theorem exists_forall_isCompact_isOpen_mem_iff (X : Type*) [TopologicalSpace X] [SpectralSpace X]
    (𝒰 : Ultrafilter X) :
    ∃ x : X, ∀ U : Set X, IsOpen U → IsCompact U → (x ∈ U ↔ U ∈ 𝒰.1) := by
  set Z : Set X := ⋂ (U : Set X) (_ : IsOpen U ∧ IsCompact U ∧ U ∉ 𝒰.1), Uᶜ with hZ_def
  have hZ_closed : IsClosed Z :=
    isClosed_iInter fun _ => isClosed_iInter fun ⟨hUo, _, _⟩ => hUo.isClosed_compl
  have hZ_mem' : ∀ x, x ∈ Z ↔ ∀ U, IsOpen U → IsCompact U → x ∈ U → U ∈ 𝒰.1 := by
    intro x
    simp only [Z, Set.mem_iInter, Set.mem_compl_iff]
    exact ⟨fun h U hUo hUc hxU => by by_contra hU; exact h U ⟨hUo, hUc, hU⟩ hxU,
      fun h U ⟨hUo, hUc, hU⟩ hxU => hU (h U hUo hUc hxU)⟩
  have hFinUnion : ∀ (S : Finset {V : Set X // IsOpen V ∧ IsCompact V ∧ V ∉ 𝒰.1}),
      (⋃ i ∈ S, (i : Set X)) ∉ 𝒰.1 := by
    intro S
    induction S using Finset.induction_on with
    | empty => simp
    | @insert a S' _ ih =>
      obtain ⟨-, -, ha⟩ := a.2
      rw [Finset.set_biUnion_insert]
      exact fun h => (Ultrafilter.union_mem_iff.mp h).elim ha ih
  have hZ_meets : ∀ U, IsOpen U → IsCompact U → U ∈ 𝒰.1 → (Z ∩ U).Nonempty := by
    intro U hUo hUc hU_mem
    rw [Set.inter_comm, show Z = ⋂ (i : {V : Set X // IsOpen V ∧ IsCompact V ∧ V ∉ 𝒰.1}),
      (i : Set X)ᶜ from by ext x; simp [Z, Set.mem_iInter]]
    refine hUc.inter_iInter_nonempty _ (fun ⟨_, hVo, _, _⟩ => hVo.isClosed_compl) fun S => ?_
    rw [show U ∩ ⋂ i ∈ S, (i : Set X)ᶜ = U \ ⋃ i ∈ S, (i : Set X) from by
      ext x; simp [Set.mem_inter_iff, Set.mem_iInter, Set.mem_compl_iff, Set.mem_iUnion]]
    exact 𝒰.nonempty_of_mem
      (𝒰.1.inter_mem hU_mem (Ultrafilter.compl_mem_iff_notMem.mpr (hFinUnion S)))
  have hZ_irred : IsIrreducible Z := by
    refine ⟨?_, fun V₁ V₂ hV₁o hV₂o ⟨z₁, hz₁Z, hz₁V₁⟩ ⟨z₂, hz₂Z, hz₂V₂⟩ => ?_⟩
    · simpa using hZ_meets Set.univ isOpen_univ isCompact_univ 𝒰.1.univ_mem
    · obtain ⟨W₁, ⟨hW₁o, hW₁c⟩, hz₁W₁, hW₁V₁⟩ := exists_isOpen_isCompact_mem_subset hV₁o hz₁V₁
      obtain ⟨W₂, ⟨hW₂o, hW₂c⟩, hz₂W₂, hW₂V₂⟩ := exists_isOpen_isCompact_mem_subset hV₂o hz₂V₂
      refine (hZ_meets (W₁ ∩ W₂) (hW₁o.inter hW₂o) (hW₁c.inter_of_isOpen hW₂c hW₁o hW₂o)
        (𝒰.1.inter_mem ((hZ_mem' z₁).mp hz₁Z W₁ hW₁o hW₁c hz₁W₁)
          ((hZ_mem' z₂).mp hz₂Z W₂ hW₂o hW₂c hz₂W₂))).mono ?_
      rintro _ ⟨hxZ, hxW₁, hxW₂⟩
      exact ⟨hxZ, hW₁V₁ hxW₁, hW₂V₂ hxW₂⟩
  obtain ⟨x, hx_gen⟩ := QuasiSober.sober hZ_irred hZ_closed
  refine ⟨x, fun U hUo hUc => ⟨fun hxU => (hZ_mem' x).mp hx_gen.mem U hUo hUc hxU, fun hU => ?_⟩⟩
  rw [hx_gen.mem_open_set_iff hUo]
  exact hZ_meets U hUo hUc hU

end Topology
