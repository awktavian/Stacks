/-!
# A generating submodule of a finite free module contains a basis

Let `R` be a local ring with maximal ideal `m` and infinite residue field `k = R / m`,
let `R → S` be a ring map, let `M` be an `S`-module and let `N ⊆ M` be an
`R`-submodule. Assume that `S` is semi-local with `m S` contained in the Jacobson
radical of `S`, that `M` is a finite free `S`-module, and that `N` generates `M` as an
`S`-module. Then `N` contains an `S`-basis of `M`: there are a natural number `n` (the
rank of `M` over `S`) and elements `m₁, …, mₙ ∈ N` forming an `S`-basis of `M`.

## Formalization conventions

Two ring actions on `M` are in play: the `S`-action, under which `M` is free, and the
restricted `R`-action, under which `N` is a submodule. The ring map `R → S` is modelled
by an `Algebra R S` instance, and the fact that the `R`-action is the restriction of
the `S`-action along `R → S` by an `IsScalarTower R S M` instance. The submodule `N` is
an `R`-submodule, i.e. a term of type `Submodule R M`; it need not be an `S`-submodule.

* "Local ring with maximal ideal `m`" is `[IsLocalRing R]`, with
  `m = IsLocalRing.maximalIdeal R` and residue field `k = IsLocalRing.ResidueField R`.
* "Infinite residue field" is `[Infinite (IsLocalRing.ResidueField R)]`.
* "Jacobson radical of `S`" is `Ring.jacobson S`, the intersection of all maximal
  ideals of `S`.
* "`S` is semi-local", i.e. it has only finitely many maximal ideals, is
  `Finite (MaximalSpectrum S)`.
* "`m S`", the ideal of `S` generated by the image of `m`, is
  `Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R)`.
* "`M` is a finite free `S`-module" is `[Module.Free S M]` together with
  `[Module.Finite S M]`.
* "`N` generates `M` as an `S`-module" is `Submodule.span S (N : Set M) = ⊤`.
* "`N` contains an `S`-basis of `M`" is the existence of a finite basis
  `b : Module.Basis (Fin n) S M` all of whose elements lie in `N`.

## Main definitions

* `GeneratesAsSModule`: an `R`-submodule `N` of `M` generates `M` as an `S`-module.
* `ContainsSBasis`: an `R`-submodule `N` of `M` contains an `S`-basis of `M`.

## Main results

* `contains_sBasis_of_generates`: a generating `R`-submodule of a finite free `S`-module
  contains an `S`-basis.
* `exists_coeffs_basis_each_factor`: over an infinite field `k`, finitely many vectors spanning
  `K i ^ n` in each of finitely many `k`-algebra fields `K i` have `n` `k`-linear combinations
  spanning every factor simultaneously.
* `eq_top_of_sup_smul_top_eq_top`: Nakayama's lemma in the form `P ⊔ J • ⊤ = ⊤ → P = ⊤`.
-/

@[expose] public section

/-- `N` (an `R`-submodule of the `S`-module `M`) generates `M` as an
`S`-module: the smallest `S`-submodule of `M` containing `N` is all of `M`. -/
@[sga "3 V 4.2"]
def GeneratesAsSModule
    {R : Type*} (S : Type*) {M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
    (N : Submodule R M) : Prop :=
  Submodule.span S (N : Set M) = ⊤

/-- `N` (an `R`-submodule of the `S`-module `M`) contains an `S`-basis of `M`:
there exists a finite `S`-basis `b : Module.Basis (Fin n) S M` of `M` all of
whose elements lie in `N`. -/
@[sga "3 V 4.2"]
def ContainsSBasis
    {R : Type*} (S : Type*) {M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
    (N : Submodule R M) : Prop :=
  ∃ (n : ℕ) (b : Module.Basis (Fin n) S M), ∀ i, b i ∈ N

/-- A "top" form of Nakayama's lemma: if `M` is a finite `S`-module, `J` is an
ideal contained in the Jacobson radical of `S`, and a submodule `P` together
with `J • ⊤` spans all of `M`, then `P = ⊤`. -/
@[ega "0 1.7.5" "Nakayama step",
  ega "0 7.1.13" "more general",
  ega "III 7.6.11" "partial",
  ega "IV 2.5.8.8" "Nakayama step, partial", sga "3 V 4.1.3" "more general"]
theorem eq_top_of_sup_smul_top_eq_top
    {S M : Type*} [CommRing S] [AddCommGroup M] [Module S M]
    [Module.Finite S M] (P : Submodule S M) (J : Ideal S)
    (hJ : J ≤ Ring.jacobson S) (h : P ⊔ J • ⊤ = ⊤) : P = ⊤ := by
  have hmaptop : Submodule.map P.mkQ ⊤ = (⊤ : Submodule S (M ⧸ P)) := by
    rw [Submodule.map_top, P.range_mkQ]
  have hJtop : (J • ⊤ : Submodule S (M ⧸ P)) = ⊤ := by
    have h2 := congrArg (Submodule.map P.mkQ) h
    rwa [Submodule.map_sup, Submodule.map_smul'', hmaptop, Submodule.mkQ_map_self,
      bot_sup_eq] at h2
  have key : (⊤ : Submodule S (M ⧸ P)) = ⊥ := by
    apply Submodule.eq_bot_of_le_smul_of_le_jacobson_bot J ⊤ Module.Finite.fg_top
    · rw [hJtop]
    · rwa [Ideal.jacobson_bot]
  rw [Submodule.eq_top_iff']
  intro x
  have hx : P.mkQ x ∈ (⊤ : Submodule S (M ⧸ P)) := trivial
  rw [key, Submodule.mem_bot] at hx
  rwa [P.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hx

/-- For a surjective `S`-linear map `π : M → M̄`, a submodule `P ⊆ M` satisfies
`P ⊔ ker π = ⊤` iff its image `map π P` is all of `M̄`. -/
theorem sup_ker_eq_top_iff_map_eq_top
    {S M Mbar : Type*} [CommRing S] [AddCommGroup M] [Module S M]
    [AddCommGroup Mbar] [Module S Mbar] (π : M →ₗ[S] Mbar)
    (hπ : Function.Surjective π) (P : Submodule S M) :
    P ⊔ LinearMap.ker π = ⊤ ↔ Submodule.map π P = ⊤ := by
  exact (LinearMap.map_eq_top_iff (LinearMap.range_eq_top.mpr hπ)).symm

open MvPolynomial Matrix in
/-- `n` vectors in `K^n` span iff the matrix they form has nonzero
determinant (square case, where spanning ⟺ basis ⟺ invertible). -/
private theorem aux_span_iff_det {K : Type*} [Field K] {n : ℕ} (v : Fin n → (Fin n → K)) :
    Submodule.span K (Set.range v) = ⊤ ↔ (Matrix.of v).det ≠ 0 := by
  have hcard : Fintype.card (Fin n) = Module.finrank K (Fin n → K) := by simp
  have hli : Submodule.span K (Set.range v) = ⊤ ↔ LinearIndependent K v := by
    constructor
    · intro h
      exact linearIndependent_of_top_le_span_of_card_eq_finrank (by rw [h]) hcard
    · intro h
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        exact Subsingleton.elim _ _
      · have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
        exact h.span_eq_top_of_card_eq_finrank hcard
  rw [hli]
  have hrow : LinearIndependent K v ↔ LinearIndependent K (Matrix.of v).row := Iff.rfl
  rw [hrow, Matrix.linearIndependent_rows_iff_isUnit, Matrix.isUnit_iff_isUnit_det,
    isUnit_iff_ne_zero]

open MvPolynomial Matrix in
/-- From a spanning family of size `Nidx` in `K^n`, one can choose `n`
`K`-linear combinations of it that span `K^n`. -/
private theorem aux_exists_Kcoeffs {K : Type*} [Field K] {n Nidx : ℕ} (w : Fin Nidx → (Fin n → K))
    (hspan : Submodule.span K (Set.range w) = ⊤) :
    ∃ c' : Fin n → Fin Nidx → K,
      Submodule.span K (Set.range (fun a => ∑ j, c' a j • w j)) = ⊤ := by
  set L : (Fin Nidx → K) →ₗ[K] (Fin n → K) :=
    { toFun := fun e => ∑ j, e j • w j
      map_add' := by intro a b; simp [add_smul, Finset.sum_add_distrib]
      map_smul' := by intro r a; simp [smul_smul, Finset.smul_sum] } with hL
  have hrange : LinearMap.range L = ⊤ := by
    rw [eq_top_iff, ← hspan, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact ⟨Pi.single j 1, by simp [L, Pi.single_apply]⟩
  have hsurj : Function.Surjective L := LinearMap.range_eq_top.mp hrange
  choose e he using fun a => hsurj (Pi.single a 1)
  refine ⟨e, ?_⟩
  have hrw : (fun a => ∑ j, e a j • w j) = fun a => Pi.single a (1:K) := funext he
  have : (fun a => Pi.single a (1:K)) = ⇑(Pi.basisFun K (Fin n)) := by
    funext a; simp [Pi.basisFun_apply]
  rw [hrw, eq_top_iff, this, (Pi.basisFun K (Fin n)).span_eq]

open MvPolynomial in
/-- Evaluating the coordinate-mapped polynomial `mapRange φ P` at a
`k`-point equals applying the `k`-linear functional `φ` to the value of `P` at
the `algebraMap`-image of that point. -/
private theorem aux_eval_mapRange {k K σ : Type*} [Field k] [CommRing K] [Algebra k K]
    [Finite σ] (φ : K →ₗ[k] k) (P : MvPolynomial σ K) (c : σ → k) :
    MvPolynomial.eval c (AddMonoidAlgebra.map φ.toAddMonoidHom P)
      = φ (MvPolynomial.eval (fun s => algebraMap k K (c s)) P) := by
  classical
  let := Fintype.ofFinite σ
  set Q : MvPolynomial σ k := AddMonoidAlgebra.map φ.toAddMonoidHom P with hQ
  have hcoeff : ∀ d, Q.coeff d = φ (P.coeff d) := fun d => rfl
  have hsub : Q.support ⊆ P.support := by
    intro d hd
    rw [MvPolynomial.mem_support_iff, hcoeff d] at hd
    rw [MvPolynomial.mem_support_iff]
    exact fun hP => hd (by rw [hP, map_zero])
  rw [MvPolynomial.eval_eq', MvPolynomial.eval_eq', map_sum]
  have hRHS : ∀ d ∈ P.support,
      φ (P.coeff d * ∏ s, (algebraMap k K (c s)) ^ d s)
        = Q.coeff d * ∏ s, c s ^ d s := by
    intro d _
    have hprod : (∏ s, (algebraMap k K (c s)) ^ d s) = algebraMap k K (∏ s, c s ^ d s) := by
      rw [map_prod]; simp [map_pow]
    rw [hprod, mul_comm, ← Algebra.smul_def, map_smul, smul_eq_mul, hcoeff, mul_comm]
  rw [Finset.sum_congr rfl hRHS]
  apply Finset.sum_subset hsub
  intro d _ hd
  rw [MvPolynomial.notMem_support_iff.mp hd, zero_mul]

/-- A nonzero multivariate polynomial over an infinite field has a point
where it does not vanish. -/
private theorem aux_eval_ne {K σ : Type*} [Field K] [Infinite K]
    (P : MvPolynomial σ K) (hP : P ≠ 0) :
    ∃ c : σ → K, MvPolynomial.eval c P ≠ 0 := by
  by_contra h
  push Not at h
  exact hP (MvPolynomial.funext (fun y => by simp [h y]))

open MvPolynomial Matrix in
/-- Let `k` be an infinite field, `K i` a finite family of `k`-algebra fields, and
`x j : ∀ i, (Fin n → K i)` finitely many vectors whose `i`-th components span
`Fin n → K i` over each `K i`. Then there are `k`-coefficients
`c : Fin n → Fin Nidx → k` such that in every factor `i` the `n` combinations
`fun a => ∑ j, (c a j) • x j i` span `Fin n → K i` over `K i`. -/
@[sga "3 V 4.2" "Reduced case, partial"]
theorem exists_coeffs_basis_each_factor
    {k : Type*} [Field k] [Infinite k]
    {ι : Type*} [Finite ι] (K : ι → Type*) [∀ i, Field (K i)] [∀ i, Algebra k (K i)]
    (n Nidx : ℕ)
    (x : Fin Nidx → ∀ i, (Fin n → K i))
    (hspan : ∀ i, Submodule.span (K i) (Set.range (fun j => x j i)) = ⊤) :
    ∃ c : Fin n → Fin Nidx → k,
      ∀ i, Submodule.span (K i)
        (Set.range (fun a => ∑ j, algebraMap k (K i) (c a j) • x j i)) = ⊤ := by
  classical
  let := Fintype.ofFinite ι
  set Mi : ∀ i, Matrix (Fin n) (Fin n) (MvPolynomial (Fin n × Fin Nidx) (K i)) :=
    fun i => Matrix.of (fun a b => ∑ j, MvPolynomial.X (a, j) * MvPolynomial.C (x j i b)) with hMi
  set P : ∀ i, MvPolynomial (Fin n × Fin Nidx) (K i) := fun i => (Mi i).det with hP
  have hevalP : ∀ (i : ι) (q : (Fin n × Fin Nidx) → K i),
      MvPolynomial.eval q (P i)
        = (Matrix.of (fun (a : Fin n) (b : Fin n) => ∑ j, q (a, j) * x j i b)).det := by
    intro i q
    rw [hP]
    simp only
    rw [RingHom.map_det]
    congr 1
    ext a b
    simp [hMi, RingHom.mapMatrix_apply, map_sum]
  have hPne : ∀ i, P i ≠ 0 := by
    intro i
    obtain ⟨c', hc'⟩ := aux_exists_Kcoeffs (fun j => x j i) (hspan i)
    set q : (Fin n × Fin Nidx) → K i := fun p => c' p.fst p.snd with hq
    have hdet : (Matrix.of (fun (a : Fin n) (b : Fin n) => ∑ j, q (a, j) * x j i b)).det ≠ 0 := by
      rw [← aux_span_iff_det]
      convert hc' using 3
      funext a b
      simp only [hq]
      simp [Finset.sum_apply, mul_comm]
    intro hzero
    have he := hevalP i q
    rw [hzero] at he
    simp at he
    exact hdet he.symm
  have hφ : ∀ i, ∃ (dd : (Fin n × Fin Nidx) →₀ ℕ) (φ : (K i) →ₗ[k] k),
      φ ((P i).coeff dd) ≠ 0 := by
    intro i
    obtain ⟨dd, hd⟩ : ∃ dd, (P i).coeff dd ≠ 0 := by
      by_contra h
      push Not at h
      exact hPne i (MvPolynomial.ext _ _ (fun dd => by simp [h dd]))
    exact ⟨dd, Module.Projective.exists_dual_ne_zero k hd⟩
  choose dd φ hdφ using hφ
  set Q : ∀ i, MvPolynomial (Fin n × Fin Nidx) k :=
    fun i => AddMonoidAlgebra.map (φ i).toAddMonoidHom (P i) with hQdef
  have hQne : ∀ i, Q i ≠ 0 := by
    intro i hz
    have hco : (Q i).coeff (dd i) = 0 := by rw [hz]; simp
    rw [hQdef] at hco
    exact hdφ i hco
  set G : MvPolynomial (Fin n × Fin Nidx) k := ∏ i, Q i with hG
  have hGne : G ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hQne i)
  obtain ⟨c, hc⟩ := aux_eval_ne G hGne
  have hQc : ∀ i, MvPolynomial.eval c (Q i) ≠ 0 := by
    have hprodeval : MvPolynomial.eval c G = ∏ i, MvPolynomial.eval c (Q i) := by
      rw [hG, map_prod]
    rw [hprodeval] at hc
    exact fun i => Finset.prod_ne_zero_iff.mp hc i (Finset.mem_univ i)
  refine ⟨fun a j => c (a, j), fun i => ?_⟩
  have hPc : MvPolynomial.eval (fun (s : Fin n × Fin Nidx) => algebraMap k (K i) (c s)) (P i)
      ≠ 0 := by
    intro hz
    apply hQc i
    rw [hQdef, aux_eval_mapRange (φ i) (P i) c, hz, map_zero]
  rw [aux_span_iff_det]
  have hpt : MvPolynomial.eval (fun (s : Fin n × Fin Nidx) => algebraMap k (K i) (c s)) (P i)
      = (Matrix.of (fun (a : Fin n) (b : Fin n) =>
          (∑ j, algebraMap k (K i) (c (a, j)) • x j i) b)).det := by
    rw [hevalP]
    congr 1
    funext a b
    simp [Finset.sum_apply, Algebra.smul_def, mul_comm]
  rwa [← hpt]

/-- Semilinear projection from a product module onto one factor. -/
private def aux_piProj {ι : Type*} (K : ι → Type*) [∀ i, CommRing (K i)]
    (V : ι → Type*) [∀ i, AddCommGroup (V i)] [∀ i, Module (K i) (V i)] (i : ι) :
    (∀ j, V j) →ₛₗ[Pi.evalRingHom K i] V i :=
  { toFun := fun x => x i
    map_add' := by intro a b; rfl
    map_smul' := by intro c a; rfl }

/-- A single-coordinate vector lies in the span of `T` over the product ring as soon as
its coordinate lies in the per-factor span. -/
private theorem aux_single_mem_span {ι : Type*} [DecidableEq ι] (K : ι → Type*)
    [∀ i, CommRing (K i)]
    (V : ι → Type*) [∀ i, AddCommGroup (V i)] [∀ i, Module (K i) (V i)]
    (T : Set (∀ i, V i)) (i : ι) (xi : V i)
    (hxi : xi ∈ Submodule.span (K i) ((fun y => y i) '' T)) :
    Pi.single i xi ∈ Submodule.span (∀ j, K j) T := by
  induction hxi using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨t, ht, rfl⟩ := hy
      have : Pi.single i (t i) = (Pi.single i (1 : K i) : ∀ j, K j) • t := by
        funext j
        rcases eq_or_ne j i with rfl | hj
        · simp [Pi.single_eq_same]
        · simp [Pi.single_eq_of_ne hj]
      rw [this]; exact Submodule.smul_mem _ _ (Submodule.subset_span ht)
  | zero => rw [Pi.single_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [Pi.single_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha =>
      rw [Pi.single_smul₀]; exact Submodule.smul_mem _ _ ha

-- needed: `aux_span_pi`'s `Pi.single` manipulations leave a goal that closes only with defeq
-- unfolding the product module structure past the default transparency
set_option backward.isDefEq.respectTransparency false in
/-- **Product-span criterion.** A set `T` spans a finite product module `∀ i, V i` over the
product ring `∀ i, K i` iff each coordinate-projection of `T` spans the factor `V i` over `K i`. -/
private theorem aux_span_pi {ι : Type*} [Finite ι] (K : ι → Type*) [∀ i, CommRing (K i)]
    (V : ι → Type*) [∀ i, AddCommGroup (V i)] [∀ i, Module (K i) (V i)]
    (T : Set (∀ i, V i)) :
    Submodule.span (∀ i, K i) T = ⊤ ↔
      ∀ i, Submodule.span (K i) ((fun x => x i) '' T) = ⊤ := by
  classical
  let := Fintype.ofFinite ι
  constructor
  · intro h i
    have hmap := Submodule.map_span (aux_piProj K V i) T
    have h2 : Submodule.map (aux_piProj K V i) (Submodule.span (∀ j, K j) T) = ⊤ := by
      rw [h, Submodule.map_top, LinearMap.range_eq_top]
      intro y; exact ⟨Pi.single i y, by simp [aux_piProj, Pi.single_eq_same]⟩
    rw [hmap] at h2
    have himg : ⇑(aux_piProj K V i) '' T = (fun x => x i) '' T := rfl
    rwa [himg] at h2
  · intro h
    rw [eq_top_iff]
    intro x _
    have hx : x = ∑ i, Pi.single i (x i) := by
      funext j; simp [Finset.sum_apply]
    rw [hx]
    apply Submodule.sum_mem
    intro i _
    have hxi : x i ∈ Submodule.span (K i) ((fun y => y i) '' T) := by rw [h i]; trivial
    exact aux_single_mem_span K V T i (x i) hxi

/-- Spanning is preserved by a semilinear map sending a spanning family to a spanning family. -/
private theorem aux_span_top_map {A B Ma Mb : Type*} [CommRing A] [CommRing B]
    [AddCommGroup Ma] [AddCommGroup Mb] [Module A Ma] [Module B Mb]
    {σ : A →+* B} {σ' : B →+* A} [RingHomInvPair σ σ'] [RingHomInvPair σ' σ]
    (f : Ma ≃ₛₗ[σ] Mb) {Nidx : ℕ} (z : Fin Nidx → Ma)
    (h : Submodule.span A (Set.range z) = ⊤) :
    Submodule.span B (Set.range (fun j => f (z j))) = ⊤ := by
  have hr : Set.range (fun j => f (z j)) = ⇑f.toLinearMap '' Set.range z := by
    exact Set.range_comp _ _
  rw [hr, ← Submodule.map_span f.toLinearMap, h, Submodule.map_top, LinearEquiv.range]

/-- Spanning equivalence under a semilinear equivalence. -/
private theorem aux_span_top_equiv {A B Ma Mb : Type*} [CommRing A] [CommRing B]
    [AddCommGroup Ma] [AddCommGroup Mb] [Module A Ma] [Module B Mb]
    {σ : A →+* B} {σ' : B →+* A} [RingHomInvPair σ σ'] [RingHomInvPair σ' σ]
    (f : Ma ≃ₛₗ[σ] Mb) {Nidx : ℕ} (z : Fin Nidx → Ma) :
    Submodule.span A (Set.range z) = ⊤ ↔ Submodule.span B (Set.range (fun j => f (z j))) = ⊤ := by
  refine ⟨aux_span_top_map f z, fun h => ?_⟩
  simpa using aux_span_top_map f.symm (fun j => f (z j)) h

/-- The component semilinear equivalence `(Fin n → Sbar) ≃ₛₗ[e] (∀ i, Fin n → K i)` induced by a
ring isomorphism `e : Sbar ≃+* ∀ i, K i`. -/
noncomputable def aux_piEquiv {ι : Type*} [Fintype ι] (Sbar : Type*) [CommRing Sbar]
    (K : ι → Type*) [∀ i, CommRing (K i)] (e : Sbar ≃+* (∀ i, K i)) (n : ℕ) :
    haveI := RingHomInvPair.of_ringEquiv e
    haveI := RingHomInvPair.of_ringEquiv e.symm
    (Fin n → Sbar) ≃ₛₗ[(e : Sbar →+* (∀ i, K i))] (∀ i, Fin n → K i) :=
  haveI := RingHomInvPair.of_ringEquiv e
  haveI := RingHomInvPair.of_ringEquiv e.symm
  { toFun := fun f => fun i a => e (f a) i
    map_add' := fun f g => by funext i a; simp
    map_smul' := fun c f => by funext i a; simp [Pi.smul_apply]
    invFun := fun g => fun a => e.symm (fun i => g i a)
    left_inv := fun f => by funext a; simp
    right_inv := fun g => by funext i a; simp }

-- needed: `exists_gens_mod_jacobson_pi` transports spans across `aux_piEquiv`, and the
-- semilinear coordinate maps only apply with defeq unfolding past the default transparency
set_option backward.isDefEq.respectTransparency false in
/-- Let `J` be an ideal of `S` and `e : S ⧸ J ≃+* ∀ i, K i` an isomorphism with a finite
product of fields, each a `k`-algebra for `k` the residue field of `R`, such that `e` carries the
image of `r ∈ R` to the image of the residue of `r` in every factor. Then there are
`n = finrank S M` elements of `N` whose images span `M ⧸ (J • ⊤)` over `S`. -/
private theorem exists_gens_mod_jacobson_pi
    {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
    [IsLocalRing R] [Infinite (IsLocalRing.ResidueField R)]
    [Module.Free S M] [Module.Finite S M]
    (N : Submodule R M) (hN : GeneratesAsSModule S N)
    (J : Ideal S)
    {ι : Type*} [Finite ι] (K : ι → Type*) [∀ i, Field (K i)]
    [∀ i, Algebra (IsLocalRing.ResidueField R) (K i)]
    (e : (S ⧸ J) ≃+* (∀ i, K i))
    (he : ∀ (i : ι) (r : R),
        e (Submodule.Quotient.mk (algebraMap R S r)) i
          = algebraMap (IsLocalRing.ResidueField R) (K i) (IsLocalRing.residue R r)) :
    ∃ v : Fin (Module.finrank S M) → M, (∀ i, v i ∈ N) ∧
      Submodule.map ((J • (⊤ : Submodule S M)).mkQ)
        (Submodule.span S (Set.range v)) = ⊤ := by
  classical
  let := Fintype.ofFinite ι
  set π := (J • (⊤ : Submodule S M)).mkQ with hπ
  have hB3 : ∃ (Nidx : ℕ) (x : Fin Nidx → M), (∀ j, x j ∈ N) ∧
      Submodule.span S (Set.range (fun j => π (x j))) = ⊤ := by
    have htop_fg : (Submodule.span S (N : Set M)).FG := by rw [hN]; exact Module.Finite.fg_top
    obtain ⟨s', hsub, hsp⟩ := (Submodule.fg_span_iff_fg_span_finset_subset (N : Set M)).mp htop_fg
    rw [hN] at hsp
    refine ⟨s'.card, fun j => (s'.equivFin.symm j : M), ?_, ?_⟩
    · intro j; exact hsub (s'.equivFin.symm j).property
    · have hrange : Set.range (fun j => π ((s'.equivFin.symm j : M)))
          = π '' (s' : Set M) := by
        ext y
        simp only [Set.mem_range, Set.mem_image, Finset.mem_coe]
        constructor
        · rintro ⟨j, rfl⟩; exact ⟨_, (s'.equivFin.symm j).property, rfl⟩
        · rintro ⟨m, hm, rfl⟩
          exact ⟨s'.equivFin ⟨m, hm⟩, by simp⟩
      rw [hrange, ← Submodule.map_span, ← hsp, Submodule.map_top, Submodule.range_mkQ]
  obtain ⟨Nidx, x, hxN, hxspan⟩ := hB3
  rcases subsingleton_or_nontrivial S with hSss | hSnt
  · have : Subsingleton M := Module.subsingleton S M
    refine ⟨fun _ => 0, fun i => ?_, ?_⟩
    · rw [Subsingleton.elim (0 : M) _]; exact N.zero_mem
    · exact Subsingleton.elim _ _
  set Sbar := S ⧸ J with hSbar
  set Mbar := M ⧸ J • (⊤ : Submodule S M) with hMbar
  set n := Module.finrank S M with hn
  have hsurj : Function.Surjective (algebraMap S Sbar) := Ideal.Quotient.mk_surjective
  set b : Module.Basis (Fin n) S M := Module.finBasis S M with hb
  set B : Module.Basis (Fin n) Sbar (TensorProduct S Sbar M) := Module.Basis.baseChange Sbar b with
      hB
  set eqT : (TensorProduct S Sbar M) ≃ₗ[Sbar] Mbar :=
    { TensorProduct.quotTensorEquivQuotSMul M J with
      map_smul' := by
        intro c p
        obtain ⟨s, rfl⟩ := hsurj c
        show (TensorProduct.quotTensorEquivQuotSMul M J) ((algebraMap S Sbar s) • p)
          = (algebraMap S Sbar s) • (TensorProduct.quotTensorEquivQuotSMul M J) p
        rw [algebraMap_smul, algebraMap_smul, map_smul] } with heqT
  set bMbar : Module.Basis (Fin n) Sbar Mbar := B.map eqT with hbMbar
  set θ : Mbar ≃ₗ[Sbar] (Fin n → Sbar) :=
    bMbar.repr.trans (Finsupp.linearEquivFunOnFinite Sbar Sbar (Fin n)) with hθ
  have := RingHomInvPair.of_ringEquiv e
  have := RingHomInvPair.of_ringEquiv e.symm
  set Φ : Mbar ≃ₛₗ[(e : Sbar →+* (∀ i, K i))] (∀ i, Fin n → K i) :=
    θ.trans (aux_piEquiv Sbar K e n) with hΦ
  have hspanSbar : ∀ (T : Set Mbar),
      Submodule.span S T = ⊤ → Submodule.span Sbar T = ⊤ := by
    intro T h
    rw [eq_top_iff] at h ⊢
    exact fun y _ => Submodule.span_le_restrictScalars S Sbar T (h Submodule.mem_top)
  have hspanS : ∀ (T : Set Mbar),
      Submodule.span Sbar T = ⊤ → Submodule.span S T = ⊤ := by
    intro T h
    rw [eq_top_iff]
    intro y hytop
    have hy : y ∈ Submodule.span Sbar T := h ▸ Submodule.mem_top
    clear h hytop
    induction hy using Submodule.span_induction with
    | mem z hz => exact Submodule.subset_span hz
    | zero => exact Submodule.zero_mem _
    | add a b _ _ ha hb => exact Submodule.add_mem _ ha hb
    | smul c a _ ha =>
        obtain ⟨s, rfl⟩ := hsurj c
        rw [algebraMap_smul]
        exact Submodule.smul_mem _ _ ha
  set xf : Fin Nidx → ∀ i, (Fin n → K i) := fun j => Φ (π (x j)) with hxf
  have hxspan_pi : Submodule.span (∀ i, K i) (Set.range xf) = ⊤ :=
    (aux_span_top_equiv Φ (fun j => π (x j))).mp (hspanSbar _ hxspan)
  have hspan_each : ∀ i, Submodule.span (K i)
      (Set.range (fun j => xf j i)) = ⊤ := by
    have hpi := (aux_span_pi K (fun i => Fin n → K i) (Set.range xf)).mp hxspan_pi
    intro i
    have hi := hpi i
    have himg : (fun (x : ∀ i, Fin n → K i) => x i) '' Set.range xf
        = Set.range (fun j => xf j i) := by
      exact (Set.range_comp _ _).symm
    rwa [himg] at hi
  obtain ⟨c, hc⟩ := exists_coeffs_basis_each_factor (k := IsLocalRing.ResidueField R)
    K n Nidx xf hspan_each
  choose r hr using fun (a : Fin n) (j : Fin Nidx) => IsLocalRing.residue_surjective (c a j)
  refine ⟨fun a => ∑ j, r a j • x j, fun a => Submodule.sum_mem N fun j _ =>
    Submodule.smul_mem N (r a j) (hxN j), ?_⟩
  set v : Fin n → M := fun a => ∑ j, r a j • x j with hv
  have hkey : ∀ a, Φ (π (v a)) =
      fun i => ∑ j, algebraMap (IsLocalRing.ResidueField R) (K i) (c a j) • xf j i := by
    intro a
    have hsmul : ∀ j, π (r a j • x j)
        = (Submodule.Quotient.mk (algebraMap R S (r a j)) : Sbar) • π (x j) := by
      intro j
      have e1 : r a j • x j = algebraMap R S (r a j) • x j :=
        (algebraMap_smul S (r a j) (x j)).symm
      rw [e1]
      rfl
    have hπv : π (v a) =
        ∑ j, (Submodule.Quotient.mk (algebraMap R S (r a j)) : Sbar) • π (x j) := by
      rw [hv]
      simp only [map_sum]
      exact Finset.sum_congr rfl (fun j _ => hsmul j)
    rw [hπv, map_sum]
    funext i
    rw [Finset.sum_apply]
    apply Finset.sum_congr rfl
    intro j _
    rw [map_smulₛₗ]
    show (e (Submodule.Quotient.mk (algebraMap R S (r a j)))) i • (Φ (π (x j))) i = _
    rw [he i (r a j), hr a j]
  rw [Submodule.map_span]
  have hrange_v : ⇑π '' Set.range v = Set.range (fun a => π (v a)) := by
    exact (Set.range_comp _ _).symm
  rw [hrange_v]
  apply hspanS
  apply (aux_span_top_equiv Φ (fun a => π (v a))).mpr
  apply (aux_span_pi K (fun i => Fin n → K i) (Set.range (fun a => Φ (π (v a))))).mpr
  intro i
  have himg2 : (fun (z : ∀ i, Fin n → K i) => z i) '' Set.range (fun a => Φ (π (v a)))
      = Set.range (fun a => (Φ (π (v a))) i) := by
    exact (Set.range_comp _ _).symm
  rw [himg2]
  have heq : (fun a => (Φ (π (v a))) i)
      = (fun a => ∑ j, algebraMap (IsLocalRing.ResidueField R) (K i) (c a j) • xf j i) :=
    funext fun a => by rw [hkey a]
  rw [heq]
  exact hc i

universe u v w
/-- Under the hypotheses of `contains_sBasis_of_generates`, with `J` the Jacobson radical of
`S`, there are `n = finrank S M` elements of `N` whose images in the quotient
`M̄ = M / (J • ⊤)` span `M̄` over `S`. -/
theorem exists_gens_mod_jacobson
    {R : Type u} {S : Type v} {M : Type w} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
    [IsLocalRing R] [Infinite (IsLocalRing.ResidueField R)]
    (hSsemilocal : Finite (MaximalSpectrum S))
    (hmS : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ≤ Ring.jacobson S)
    [Module.Free S M] [Module.Finite S M]
    (N : Submodule R M)
    (hN : GeneratesAsSModule S N) :
    ∃ v : Fin (Module.finrank S M) → M, (∀ i, v i ∈ N) ∧
      Submodule.map ((Ring.jacobson S • (⊤ : Submodule S M)).mkQ)
        (Submodule.span S (Set.range v)) = ⊤ := by
  classical
  set J : Ideal S := Ring.jacobson S with hJdef
  let : Fintype (MaximalSpectrum S) := Fintype.ofFinite _
  have hbridge :
      ∃ K : MaximalSpectrum S → Type v, ∃ _ : ∀ i, Field (K i),
        ∃ _ : ∀ i, Algebra (IsLocalRing.ResidueField R) (K i),
          ∃ e : (S ⧸ J) ≃+* (∀ i, K i),
            ∀ (i : MaximalSpectrum S) (r : R),
              e (Submodule.Quotient.mk (algebraMap R S r)) i
                = algebraMap (IsLocalRing.ResidueField R) (K i) (IsLocalRing.residue R r) := by
    have : ∀ i : MaximalSpectrum S, (i.asIdeal).IsMaximal := fun i => i.isMaximal
    set f : MaximalSpectrum S → Ideal S := fun i => i.asIdeal with hf
    have hJinf : J = ⨅ (i : MaximalSpectrum S), f i := by
      rw [hJdef, Ring.jacobson_eq_sInf_isMaximal]
      exact le_antisymm (le_iInf fun i => sInf_le i.isMaximal)
        (le_sInf fun I hI => iInf_le f (⟨I, hI⟩ : MaximalSpectrum S))
    have hcomap : ∀ i : MaximalSpectrum S,
        IsLocalRing.maximalIdeal R ≤ Ideal.comap (algebraMap R S) (f i) := by
      intro i
      rw [← Ideal.map_le_iff_le_comap]
      refine le_trans hmS ?_
      rw [hJinf]
      exact iInf_le f i
    have hcop : Pairwise (Function.onFun IsCoprime f) := fun i j hij =>
      Ideal.isCoprime_of_isMaximal (I := f i) (J := f j) fun h => hij (MaximalSpectrum.ext h)
    exact ⟨fun i => S ⧸ f i, fun i => Ideal.Quotient.field (f i),
      fun i => (Ideal.Quotient.lift (IsLocalRing.maximalIdeal R)
        ((Ideal.Quotient.mk (f i)).comp (algebraMap R S))
        (fun a ha => (Ideal.Quotient.eq_zero_iff_mem).mpr ((hcomap i) ha))).toAlgebra,
      (Ideal.quotEquivOfEq hJinf).trans
        (Ideal.quotientInfRingEquivPiQuotient f hcop), fun _ _ => rfl⟩
  obtain ⟨K, hKfield, hKalg, e, he⟩ := hbridge
  exact exists_gens_mod_jacobson_pi N hN J K e he

/-- Under the hypotheses of `contains_sBasis_of_generates`, there are `n = finrank S M`
elements of `N` whose `S`-span, together with `J • ⊤` for `J` the Jacobson radical of `S`, is
all of `M`. -/
theorem exists_generators_in_submodule
    {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
    [IsLocalRing R] [Infinite (IsLocalRing.ResidueField R)]
    (hSsemilocal : Finite (MaximalSpectrum S))
    (hmS : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ≤ Ring.jacobson S)
    [Module.Free S M] [Module.Finite S M]
    (N : Submodule R M)
    (hN : GeneratesAsSModule S N) :
    ∃ v : Fin (Module.finrank S M) → M, (∀ i, v i ∈ N) ∧
      Submodule.span S (Set.range v) ⊔ (Ring.jacobson S) • ⊤ = ⊤ := by
  obtain ⟨v, hvN, hmap⟩ := exists_gens_mod_jacobson hSsemilocal hmS N hN
  refine ⟨v, hvN, ?_⟩
  set P := Submodule.span S (Set.range v)
  have hker : LinearMap.ker (Ring.jacobson S • (⊤ : Submodule S M)).mkQ
      = Ring.jacobson S • (⊤ : Submodule S M) := Submodule.ker_mkQ _
  rw [← hker]
  exact (sup_ker_eq_top_iff_map_eq_top _ (Submodule.mkQ_surjective _) P).mpr hmap

/-- Let `R` be a local ring with maximal ideal `m` and infinite residue field.
Let `R → S` be a ring map, `M` an `S`-module, and `N ⊆ M` an `R`-submodule.
If `S` is semi-local with `m S ⊆ Jac(S)`, `M` is finite free over `S`, and
`N` generates `M` as an `S`-module, then `N` contains an `S`-basis of `M`. -/
@[stacks 03C1, sga "3 V 4.2"]
theorem contains_sBasis_of_generates
    {R S M : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M]
    [IsLocalRing R] [Infinite (IsLocalRing.ResidueField R)]
    (hSsemilocal : Finite (MaximalSpectrum S))
    (hmS : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ≤ Ring.jacobson S)
    [Module.Free S M] [Module.Finite S M]
    (N : Submodule R M)
    (hN : GeneratesAsSModule S N) :
    ContainsSBasis S N := by
  set n := Module.finrank S M with hn
  set J : Ideal S := Ring.jacobson S with hJdef
  obtain ⟨v, hvN, hvspan⟩ :=
    exists_generators_in_submodule hSsemilocal hmS N hN
  have hspan : Submodule.span S (Set.range v) = ⊤ :=
    eq_top_of_sup_smul_top_eq_top _ J (le_refl _) hvspan
  refine ⟨n, basisOfTopLeSpanOfCardEqFinrank v hspan.ge ?_, ?_⟩
  · simp [hn]
  · intro i; simpa [basisOfTopLeSpanOfCardEqFinrank] using hvN i
