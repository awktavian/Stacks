module

public import Mathlib.RingTheory.Ideal.CotangentBaseChange
public import Mathlib.RingTheory.TensorProduct.Quotient
import StacksCore.Tactic.EgaSgaAttribute

@[expose] public section

/-!
# The conormal module of an extended ideal, over a flat base change

Let `A → B` be a flat algebra and let `I` be an ideal of `A`. Mathlib's
`Ideal.tensorCotangentEquiv` identifies `B ⊗[A] I/I²` with the conormal module of the ideal
generated by `I` inside `B ⊗[A] A`. This file transports that identification along the
canonical isomorphism `B ⊗[A] A ≃ₐ[A] B`, so that the target becomes the conormal module of
`I B = Ideal.map (algebraMap A B) I` itself, and then rewrites the source as a tensor product
over `A ⧸ I` rather than over `A`.

## Main definitions

* `Ideal.cotangentEquivOfAlgEquiv`: an algebra isomorphism carrying one ideal onto another
  induces an isomorphism of their conormal modules.
* `Ideal.tensorCotangentEquivMap`: for `B` flat over `A`, the `B`-linear isomorphism
  `B ⊗[A] I/I² ≃ (I B)/(I B)²`.
* `Ideal.quotientTensorCotangentEquivMap`: the same isomorphism with the base change taken over
  `A ⧸ I`, that is `(B ⧸ I B) ⊗[A ⧸ I] I/I² ≃ (I B)/(I B)²`.

## Implementation notes

The rings are left in arbitrary and independent universes, and
`Ideal.tensorCotangentEquivMap` is stated as an isomorphism of `B`-modules rather than only of
`A`-modules; both are needed by the consumers, which instantiate `B` at localizations and at
faithfully flat extensions.

`Ideal.quotientTensorCotangentEquivMap` is obtained by exhibiting the composite of base-change
isomorphisms as the map induced by `Ideal.mapCotangent` through
`LinearMap.extendScalarsOfSurjective`, which is what makes it `B ⧸ I B`-linear; the scalar
tower instances on `(I B)/(I B)²` over `A`, `A ⧸ I` and `B ⧸ I B` are built in the proof
because the `A ⧸ I`-action is the one restricted along `A ⧸ I → B ⧸ I B`.
-/

open scoped TensorProduct

namespace Ideal

/-- An isomorphism `e : A ≃ₐ[R] B` of `R`-algebras carrying an ideal `I` of `A` onto an ideal
`J` of `B` induces an isomorphism `I/I² ≃ J/J²` of conormal modules, given by
`Ideal.mapCotangent` in both directions. -/
noncomputable def cotangentEquivOfAlgEquiv
    {R A B : Type*} [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra R B]
    (e : A ≃ₐ[R] B) (I : Ideal A) (J : Ideal B) (h : I.map e.toRingHom = J) :
    I.Cotangent ≃ₗ[R] J.Cotangent := by
  have h₁ : I ≤ J.comap e.toAlgHom := (Ideal.map_le_iff_le_comap).mp h.le
  have h₂ : J ≤ I.comap e.symm.toAlgHom := by
    rw [← h]
    intro y hy
    rcases (Ideal.mem_map_iff_of_surjective e.toRingHom e.surjective).mp hy with ⟨x, hx, rfl⟩
    simpa using hx
  exact
    { __ := I.mapCotangent J e.toAlgHom h₁
      invFun := J.mapCotangent I e.symm.toAlgHom h₂
      left_inv := fun x => by
        obtain ⟨x, rfl⟩ := I.toCotangent_surjective x
        change I.toCotangent ⟨e.symm (e x), _⟩ = I.toCotangent x
        congr 1
        exact Subtype.ext (e.symm_apply_apply x)
      right_inv := fun x => by
        obtain ⟨x, rfl⟩ := J.toCotangent_surjective x
        change J.toCotangent ⟨e (e.symm x), _⟩ = J.toCotangent x
        congr 1
        exact Subtype.ext (e.apply_symm_apply x) }

/-- **The conormal module of an extended ideal over a flat base.** For `B` flat over `A` and
`I` an ideal of `A`, the `B`-linear isomorphism `B ⊗[A] I/I² ≃ (I B)/(I B)²`, where
`I B = Ideal.map (algebraMap A B) I`. This is `Ideal.tensorCotangentEquiv` read through the
isomorphism `B ⊗[A] A ≃ₐ[A] B`, which replaces the ideal generated by `I` in `B ⊗[A] A` by
`I B`. -/
@[sga "3 III 4.13" "more general"]
noncomputable def tensorCotangentEquivMap
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
    (I : Ideal A) : B ⊗[A] I.Cotangent ≃ₗ[B] (I.map (algebraMap A B)).Cotangent :=
  (I.tensorCotangentEquiv A B).trans
    (cotangentEquivOfAlgEquiv (Algebra.TensorProduct.rid A B B)
      (I.map Algebra.TensorProduct.includeRight.toRingHom) (I.map (algebraMap A B)) (by
        rw [Ideal.map_map]
        congr 1
        ext a
        simp [Algebra.smul_def]))

/-- `Ideal.tensorCotangentEquivMap` carries `b ⊗ (x + I²)` to `b · (f x + (I B)²)`, where `f`
is the structure map `A → B`. -/
lemma tensorCotangentEquivMap_tmul
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
    (I : Ideal A) (b : B) (x : I) :
    tensorCotangentEquivMap I (b ⊗ₜ[A] I.toCotangent x) =
      b • (I.map (algebraMap A B)).toCotangent ⟨algebraMap A B x, Ideal.mem_map_of_mem _ x.2⟩ := by
  simp only [tensorCotangentEquivMap, LinearEquiv.trans_apply, Ideal.tensorCotangentEquiv_tmul,
    map_smul]
  congr 1
  unfold cotangentEquivOfAlgEquiv
  change
      (I.map Algebra.TensorProduct.includeRight.toRingHom).mapCotangent
          (I.map (algebraMap A B)) (Algebra.TensorProduct.rid A B B).toAlgHom _
          ((I.map Algebra.TensorProduct.includeRight.toRingHom).toCotangent
            ⟨1 ⊗ₜ[A] (x : A), _⟩) = _
  rw [Ideal.mapCotangent_toCotangent]
  simp [Algebra.smul_def]

/-- **The conormal module of an extended ideal as a base change over the quotient.** For `B`
flat over `A` and `I` an ideal of `A`, the `B ⧸ I B`-linear isomorphism
`(B ⧸ I B) ⊗[A ⧸ I] I/I² ≃ (I B)/(I B)²`. This is `Ideal.tensorCotangentEquivMap` with the
base change taken over `A ⧸ I`, which is the form in which freeness and projectivity of the
conormal module base-change along `A → B`. -/
@[sga "3 III 4.13" "more general"]
noncomputable def quotientTensorCotangentEquivMap
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
    (I : Ideal A) :
    (B ⧸ I.map (algebraMap A B)) ⊗[A ⧸ I] I.Cotangent ≃ₗ[B ⧸ I.map (algebraMap A B)]
      (I.map (algebraMap A B)).Cotangent := by
  let J := I.map (algebraMap A B)
  let e₁ := Algebra.TensorProduct.quotIdealMapEquivQuotTensor B I
  let e₂ := TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ I) (A ⧸ I) I.Cotangent B
  let e₃ := (TensorProduct.comm (A ⧸ I) (B ⧸ J) I.Cotangent).trans
    ((e₁.toLinearEquiv.lTensor I.Cotangent).trans e₂)
  let e₄ := ((e₃.restrictScalars A).trans (TensorProduct.comm A I.Cotangent B)).trans
    ((tensorCotangentEquivMap I).restrictScalars A)
  have : IsScalarTower A (B ⧸ J) J.Cotangent := .of_algebraMap_smul fun a x => by
    rw [IsScalarTower.algebraMap_apply A B (B ⧸ J), IsScalarTower.algebraMap_smul (B ⧸ J),
      IsScalarTower.algebraMap_smul B]
  let : Module (A ⧸ I) J.Cotangent :=
    Module.compHom J.Cotangent (algebraMap (A ⧸ I) (B ⧸ J))
  have : IsScalarTower (A ⧸ I) (B ⧸ J) J.Cotangent :=
    IsScalarTower.of_compHom (A ⧸ I) (B ⧸ J) J.Cotangent
  have : IsScalarTower A (A ⧸ I) J.Cotangent := .of_algebraMap_smul fun a x => by
    change algebraMap (A ⧸ I) (B ⧸ J) (algebraMap A (A ⧸ I) a) • x = a • x
    rw [← IsScalarTower.algebraMap_apply]
    exact IsScalarTower.algebraMap_smul (B ⧸ J) a x
  let l : I.Cotangent →ₗ[A ⧸ I] J.Cotangent :=
    LinearMap.extendScalarsOfSurjective Ideal.Quotient.mk_surjective
      (I.mapCotangent J (Algebra.ofId A B) Ideal.le_comap_map)
  let L := LinearMap.liftBaseChange (B ⧸ J) l
  have h : ⇑L = ⇑e₄ := by
    funext z
    induction z with
    | add x y hx hy => simp [hx, hy]
    | tmul b m =>
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
      obtain ⟨m, rfl⟩ := I.toCotangent_surjective m
      have he₃ : e₃ ((Ideal.Quotient.mk J b) ⊗ₜ[A ⧸ I] I.toCotangent m) =
          I.toCotangent m ⊗ₜ[A] b := by
        change e₂ (I.toCotangent m ⊗ₜ[A ⧸ I] ((1 : A ⧸ I) ⊗ₜ[A] b)) = _
        simp only [e₂, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul]
      have he₄ : e₄ ((Ideal.Quotient.mk J b) ⊗ₜ[A ⧸ I] I.toCotangent m) =
          b • J.toCotangent ⟨algebraMap A B m, Ideal.mem_map_of_mem _ m.2⟩ :=
        (congrArg (fun z => tensorCotangentEquivMap I
          (TensorProduct.comm A I.Cotangent B z)) he₃).trans
            (tensorCotangentEquivMap_tmul I b m)
      rw [he₄]
      change (Ideal.Quotient.mk J b) • J.toCotangent ⟨algebraMap A B m, _⟩ = _
      exact IsScalarTower.algebraMap_smul (B ⧸ J) b _
  exact LinearEquiv.ofBijective L (h ▸ e₄.bijective)

end Ideal

end
