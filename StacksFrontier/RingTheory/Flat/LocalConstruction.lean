/-!
# Constructing flat local ring maps with a prescribed residue field extension

Given a local ring `(R, m, k)` with `k = ResidueField R` and a field extension `K / k`, one seeks
a local ring `(R', m', k')` and a flat local ring map `φ : R →+* R'` with `m' = m R'` and `k'`
isomorphic to `K` as an extension of `k`.

A ring map is local iff `IsLocalHom φ`, and flat iff `Module.Flat R R'` for the `R`-module
structure `φ.toAlgebra`. The extended ideal `m R'` is `Ideal.map φ (maximalIdeal R)`, and the
induced map on residue fields is `IsLocalRing.ResidueField.map φ`. "Isomorphic to `K` as an
extension of `k`" means a ring isomorphism `σ : ResidueField R' ≃+* K` with
`σ.toRingHom.comp (ResidueField.map φ) = algebraMap (ResidueField R) K`.

## Main definitions

* `GoodLift R K`: a flat local `R`-algebra `A` with `m_A = m·A` together with a `k`-embedding
  `ι : ResidueField A →+* K`.
* `GoodLiftLE g h`: a morphism of good lifts, i.e. a flat local `m`-extension map of carriers
  commuting with the structure maps and with the embeddings into `K`.
* `goodLift_trivial R K`: `R` itself as a good lift.
* `FreeRingColim G f`: a `FreeCommRing`/`RingQuot` model of the colimit of a family of rings
  along arbitrary transition maps.

## Main results

* `exists_flat_localRing_residueField_of_transcendental`,
  `exists_flat_isLocalHom_residueField_equiv`: a simple extension `κ⟮α⟯` of the residue field,
  transcendental or algebraic, is realized by a flat local extension of the ring.
* `flat_and_maximalIdeal_eq_map_comp`: flat local `m`-extensions compose.
* `flat_directLimit_of_flat`: flatness passes to directed colimits of modules.
* `goodLift_colimit_directed`, `goodLift_colimit_chosen`: a coherent directed system of good
  lifts has a good-lift upper bound, in existential and in chosen-data form.
* `goodLift_monogenic_step`: any `α : K` can be adjoined to a good lift.
* `goodLift_step_over`: a coherent directed system of good lifts has an upper bound whose
  residue embedding reaches a given `α : K`.
* `freeRingColimEquivDirectLimit`: for a directed system, the free colimit is
  `Ring.DirectLimit`.
-/

@[expose] public section

universe u

open IsLocalRing

open Polynomial in
/-- Let `A` be a local ring with residue field `κ`, and let `F` be a field extension of `κ`
generated by a single element `α` transcendental over `κ`. Then there is a flat local
`A`-algebra `A'` with `m_{A'} = m_A A'` and `ResidueField A'` isomorphic to `F` over `κ`. -/
@[ega "0 10.3.1.1" "partial"]
theorem exists_flat_localRing_residueField_of_transcendental
    (A : Type u) [CommRing A] [IsLocalRing A]
    (F : Type u) [Field F] [Algebra (ResidueField A) F]
    (α : F) (hα : Transcendental (ResidueField A) α)
    (hgen : (IntermediateField.adjoin (ResidueField A) {α})
        = (⊤ : IntermediateField (ResidueField A) F)) :
    ∃ (A' : Type u) (_ : CommRing A') (_ : IsLocalRing A') (φ : A →+* A')
      (hφ : IsLocalHom φ),
      (letI : Algebra A A' := φ.toAlgebra; Module.Flat A A') ∧
      (maximalIdeal A' = Ideal.map φ (maximalIdeal A)) ∧
      (∃ σ : ResidueField A' ≃+* F,
        (σ : ResidueField A' →+* F).comp (@ResidueField.map A A' _ _ _ _ φ hφ)
          = algebraMap (ResidueField A) F) := by
  let P : Ideal A[X] := Ideal.map (Polynomial.C : A →+* A[X]) (maximalIdeal A)
  let A' := Localization.AtPrime P
  let e : (ResidueField A)[X] ≃+* A[X] ⧸ P :=
    Ideal.polynomialQuotientEquivQuotientPolynomial (maximalIdeal A)
  let φ : A →+* A' := algebraMap A A'
  have hφval : φ = algebraMap A A' := rfl
  have hφeq : (φ : A →+* A') = (algebraMap A[X] A').comp (Polynomial.C : A →+* A[X]) := rfl
  clear_value φ
  have hcomapC : Ideal.comap (Polynomial.C : A →+* A[X]) P = maximalIdeal A := by
    ext a
    rw [Ideal.mem_comap, Ideal.mem_map_C_iff]
    constructor
    · intro h; simpa using h 0
    · intro h n; rcases n with _ | n
      · simpa using h
      · simp
  have hmax : maximalIdeal A' = Ideal.map φ (maximalIdeal A) := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P A', hφeq, Ideal.map_map]
  have hcomeqmax : Ideal.comap φ (maximalIdeal A') = maximalIdeal A := by
    have hc : Ideal.comap (algebraMap A[X] A') (maximalIdeal A') = P :=
      IsLocalization.AtPrime.under_maximalIdeal A' P
    rw [hφeq, ← Ideal.comap_comap, hc, hcomapC]
  have hφ : IsLocalHom φ := ((IsLocalRing.local_hom_TFAE φ).out 1 5).mpr hcomeqmax
  let algInst : Algebra (ResidueField A)[X] (ResidueField A') :=
    ((algebraMap (A[X] ⧸ P) P.ResidueField).comp e.toRingHom).toAlgebra
  have hfr : IsFractionRing (ResidueField A)[X] (ResidueField A') := by
    apply IsFractionRing.of_ringEquiv_left e; intro x; rfl
  have hkey : ∀ a : A, algebraMap (ResidueField A)[X] (ResidueField A') (Polynomial.C (residue A a))
      = residue A' (φ a) := by
    intro a
    rw [hφeq]
    show (algebraMap (A[X] ⧸ P) P.ResidueField)
        ((Ideal.polynomialQuotientEquivQuotientPolynomial (maximalIdeal A)) (Polynomial.C (residue
            A a))) = _
    rw [IsLocalRing.residue_def, ← Polynomial.map_C,
        Ideal.polynomialQuotientEquivQuotientPolynomial_map_mk]
    rfl
  let σ1 : ResidueField A' ≃ₐ[(ResidueField A)[X]] RatFunc (ResidueField A) :=
    IsLocalization.algEquiv (nonZeroDivisors (ResidueField A)[X]) (ResidueField A') (RatFunc
        (ResidueField A))
  let σ2 : RatFunc (ResidueField A) ≃ₐ[ResidueField A] (IntermediateField.adjoin (ResidueField A)
      {α}) :=
    RatFunc.algEquivOfTranscendental α hα
  let σ3 : (IntermediateField.adjoin (ResidueField A) {α}) ≃ₐ[ResidueField A] (⊤ :
      IntermediateField (ResidueField A) F) :=
    IntermediateField.equivOfEq hgen
  let σ4 : (⊤ : IntermediateField (ResidueField A) F) ≃ₐ[ResidueField A] F :=
    IntermediateField.topEquiv
  let σ : ResidueField A' ≃+* F :=
    σ1.toRingEquiv.trans (σ2.toRingEquiv.trans (σ3.toRingEquiv.trans σ4.toRingEquiv))
  refine ⟨A', inferInstance, inferInstance, φ, hφ, ?_, hmax, σ, ?_⟩
  · have : Module.Flat A A[X] := Module.Flat.of_free
    have hamb : Module.Flat A A' := inferInstance
    have halg : φ.toAlgebra = (inferInstance : Algebra A A') :=
      Algebra.algebra_ext _ _ (fun r => by rw [hφval]; rfl)
    exact halg ▸ hamb
  apply RingHom.ext
  intro x
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
  rw [RingHom.comp_apply, IsLocalRing.ResidueField.map_residue]
  rw [← hkey a]
  show σ4 (σ3 (σ2 (σ1 (algebraMap (ResidueField A)[X] (ResidueField A') (Polynomial.C (residue A
      a)))))) = _
  rw [σ1.commutes]
  have hsc : algebraMap (ResidueField A)[X] (RatFunc (ResidueField A)) (Polynomial.C (residue A a))
      = algebraMap (ResidueField A) (RatFunc (ResidueField A)) (residue A a) := by
    rw [IsScalarTower.algebraMap_apply (ResidueField A) (ResidueField A)[X] (RatFunc (ResidueField
        A))]
    rfl
  rw [hsc, σ2.commutes, σ3.commutes, σ4.commutes]

-- the quotients by `Ideal.span {pbar}` need `(Ideal.span {pbar}).IsTwoSided`, which is not
-- synthesized at default transparency
set_option backward.isDefEq.respectTransparency false in
/-- Let `A` be a local ring with residue field `κ`, and let `F` be an algebraic extension of `κ`
generated by a single element `α`. Then there is a flat local `A`-algebra `A'` with
`m_{A'} = m_A A'` and `ResidueField A'` isomorphic to `F` over `κ`. -/
@[sga "3 V 4.1.2" "special case"]
theorem exists_flat_isLocalHom_residueField_equiv
    (A : Type u) [CommRing A] [IsLocalRing A]
    (F : Type u) [Field F] [Algebra (ResidueField A) F]
    [Algebra.IsAlgebraic (ResidueField A) F]
    (α : F) (hgen : (IntermediateField.adjoin (ResidueField A) {α})
        = (⊤ : IntermediateField (ResidueField A) F)) :
    ∃ (A' : Type u) (_ : CommRing A') (_ : IsLocalRing A') (φ : A →+* A')
      (hφ : IsLocalHom φ),
      (letI : Algebra A A' := φ.toAlgebra; Module.Flat A A') ∧
      (maximalIdeal A' = Ideal.map φ (maximalIdeal A)) ∧
      (∃ σ : ResidueField A' ≃+* F,
        (σ : ResidueField A' →+* F).comp (@ResidueField.map A A' _ _ _ _ φ hφ)
          = algebraMap (ResidueField A) F) := by
  have hint : IsIntegral (ResidueField A) α := Algebra.IsIntegral.isIntegral α
  set pbar := minpoly (ResidueField A) α with hpbar
  have hirr : Irreducible pbar := minpoly.irreducible hint
  have hmonic_bar : pbar.Monic := minpoly.monic hint
  have hsurj : Function.Surjective (IsLocalRing.residue A) := IsLocalRing.residue_surjective
  have hlifts : pbar ∈ Polynomial.lifts (IsLocalRing.residue A) := by
    rw [Polynomial.lifts_iff_coeff_lifts]; intro n; exact hsurj _
  obtain ⟨p, hpmap, hpdeg, hpmonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic hlifts hmonic_bar
  have hpmap' : p.map (Ideal.Quotient.mk (maximalIdeal A)) = pbar := hpmap
  have hspanmax0 : (Ideal.span {pbar}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible hirr
  have hspanmax : (Ideal.span {p.map (Ideal.Quotient.mk (maximalIdeal A))}).IsMaximal := by
    rwa [hpmap']
  have hiso := AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot (maximalIdeal A) p
  have htgtfield : IsField (Polynomial (A ⧸ maximalIdeal A) ⧸
      Ideal.span {p.map (Ideal.Quotient.mk (maximalIdeal A))}) :=
    (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp hspanmax
  have hfieldquot : IsField (AdjoinRoot p ⧸ (Ideal.map (AdjoinRoot.of p) (maximalIdeal A))) :=
    MulEquiv.isField htgtfield hiso.toMulEquiv
  have hmax : (Ideal.map (AdjoinRoot.of p) (maximalIdeal A)).IsMaximal :=
    Ideal.Quotient.maximal_of_isField _ hfieldquot
  have hfin : Module.Finite A (AdjoinRoot p) := hpmonic.finite_adjoinRoot
  have hintg : Algebra.IsIntegral A (AdjoinRoot p) := Algebra.IsIntegral.of_finite A (AdjoinRoot p)
  have hlocal : IsLocalRing (AdjoinRoot p) := by
    apply IsLocalRing.of_unique_max_ideal
    refine ⟨Ideal.map (AdjoinRoot.of p) (maximalIdeal A), hmax, ?_⟩
    intro Q hQ
    have hcomap : (Q.comap (algebraMap A (AdjoinRoot p))).IsMaximal := by
      haveI : Q.IsMaximal := hQ
      refine Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A (AdjoinRoot p)) ?_ Q
      exact fun x => hintg.isIntegral x
    have hcomeq : Q.comap (algebraMap A (AdjoinRoot p)) = maximalIdeal A :=
      (IsLocalRing.isMaximal_iff _).mp hcomap
    have hsub : Ideal.map (AdjoinRoot.of p) (maximalIdeal A) ≤ Q :=
      Ideal.map_le_iff_le_comap.mpr hcomeq.ge
    exact (hmax.eq_of_le hQ.ne_top hsub).symm
  have hmaxeq : maximalIdeal (AdjoinRoot p) = Ideal.map (AdjoinRoot.of p) (maximalIdeal A) :=
    ((IsLocalRing.isMaximal_iff _).mp hmax).symm
  have hcomeqmax : (maximalIdeal (AdjoinRoot p)).comap (AdjoinRoot.of p) = maximalIdeal A := by
    haveI : IsLocalRing (AdjoinRoot p) := hlocal
    have hcm : ((maximalIdeal (AdjoinRoot p)).comap (algebraMap A (AdjoinRoot p))).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A (AdjoinRoot p))
        (fun x => hintg.isIntegral x) (maximalIdeal (AdjoinRoot p))
    exact (IsLocalRing.isMaximal_iff _).mp hcm
  have hφ : IsLocalHom (AdjoinRoot.of p) :=
    ((IsLocalRing.local_hom_TFAE (AdjoinRoot.of p)).out 1 5).mpr hcomeqmax
  let e1 : AdjoinRoot pbar ≃ₐ[ResidueField A] IntermediateField.adjoin (ResidueField A) {α} :=
    IntermediateField.adjoinRootEquivAdjoin (ResidueField A) hint
  let e2 : IntermediateField.adjoin (ResidueField A) {α}
      ≃ₐ[ResidueField A] (⊤ : IntermediateField (ResidueField A) F) :=
    IntermediateField.equivOfEq hgen
  let e3 : (⊤ : IntermediateField (ResidueField A) F) ≃ₐ[ResidueField A] F :=
    IntermediateField.topEquiv
  let e : AdjoinRoot pbar ≃ₐ[ResidueField A] F := (e1.trans e2).trans e3
  have hspaneq : Ideal.span {p.map (Ideal.Quotient.mk (maximalIdeal A))} = Ideal.span {pbar} :=
    congrArg (fun q => Ideal.span {q}) hpmap'
  let s1 : ResidueField (AdjoinRoot p)
      ≃+* (AdjoinRoot p ⧸ Ideal.map (AdjoinRoot.of p) (maximalIdeal A)) :=
    Ideal.quotEquivOfEq hmaxeq
  let s3 : (Polynomial (A ⧸ maximalIdeal A) ⧸
      Ideal.span {p.map (Ideal.Quotient.mk (maximalIdeal A))}) ≃+* AdjoinRoot pbar :=
    Ideal.quotEquivOfEq hspaneq
  refine ⟨AdjoinRoot p, inferInstance, hlocal, AdjoinRoot.of p, hφ, ?_, ?_, ?_⟩
  · rw [show ((AdjoinRoot.of p).toAlgebra) = AdjoinRoot.instAlgebra p from by
      apply Algebra.algebra_ext; intro r; rfl]
    have hfree : Module.Free A (AdjoinRoot p) := hpmonic.free_adjoinRoot
    exact Module.Flat.of_free
  · exact hmaxeq
  · refine ⟨((s1.trans (AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot (maximalIdeal A) p)).trans
      s3).trans e.toRingEquiv, ?_⟩
    have hcompute : ∀ a : A,
        (Ideal.quotEquivOfEq hspaneq
          ((AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot (maximalIdeal A) p)
            (Ideal.quotEquivOfEq hmaxeq (IsLocalRing.residue (AdjoinRoot p) (AdjoinRoot.of p a)))))
          = algebraMap (ResidueField A) (AdjoinRoot pbar) (IsLocalRing.residue A a) := by
      intro a
      rw [IsLocalRing.residue_def, Ideal.quotEquivOfEq_mk hmaxeq]
      rw [show (AdjoinRoot.of p a) = AdjoinRoot.mk p (Polynomial.C a) from rfl,
        AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot_mk_of]
      rw [Ideal.quotEquivOfEq_mk hspaneq, Polynomial.map_C]
      rfl
    apply RingHom.ext
    intro x
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
    rw [RingHom.comp_apply, IsLocalRing.ResidueField.map_residue]
    rw [RingHom.coe_coe, RingEquiv.trans_apply, RingEquiv.trans_apply, RingEquiv.trans_apply]
    have hs1 : s1 = Ideal.quotEquivOfEq hmaxeq := rfl
    have hs3 : s3 = Ideal.quotEquivOfEq hspaneq := rfl
    rw [hs1, hs3]
    exact (congrArg e.toRingEquiv (hcompute a)).trans (e.commutes _)

/-- If `φ : A →+* A'` and `ψ : A' →+* A''` are flat with `m_{A'} = m_A A'` and
`m_{A''} = m_{A'} A''`, then `ψ.comp φ` is flat and `m_{A''} = m_A A''`. -/
theorem flat_and_maximalIdeal_eq_map_comp
    (A : Type u) [CommRing A] [IsLocalRing A]
    (A' : Type u) [CommRing A'] [IsLocalRing A']
    (A'' : Type u) [CommRing A''] [IsLocalRing A'']
    (φ : A →+* A') (ψ : A' →+* A'')
    (hφflat : letI : Algebra A A' := φ.toAlgebra; Module.Flat A A')
    (hψflat : letI : Algebra A' A'' := ψ.toAlgebra; Module.Flat A' A'')
    (hφm : maximalIdeal A' = Ideal.map φ (maximalIdeal A))
    (hψm : maximalIdeal A'' = Ideal.map ψ (maximalIdeal A')) :
    (letI : Algebra A A'' := (ψ.comp φ).toAlgebra; Module.Flat A A'') ∧
      (maximalIdeal A'' = Ideal.map (ψ.comp φ) (maximalIdeal A)) := by
  exact ⟨(RingHom.Flat.comp (f := φ) (g := ψ) hφflat hψflat : RingHom.Flat (ψ.comp φ)),
    by rw [← Ideal.map_map, ← hφm, ← hψm]⟩

/-- Injectivity of the induced map on directed colimits: if each component map
`g i : G i → G' i` of a morphism of directed systems is injective, then the induced
map `Module.DirectLimit.map g hg` on the colimits is injective. -/
private theorem map_directLimit_injective_aux
    (R : Type u) [CommRing R]
    {ι : Type u} [DecidableEq ι] [Preorder ι] [IsDirected ι (· ≤ ·)] [Nonempty ι]
    (G : ι → Type u) [∀ i, AddCommGroup (G i)] [∀ i, Module R (G i)]
    (f : ∀ i j, i ≤ j → G i →ₗ[R] G j)
    [DirectedSystem G fun i j h => f i j h]
    (G' : ι → Type u) [∀ i, AddCommGroup (G' i)] [∀ i, Module R (G' i)]
    (f' : ∀ i j, i ≤ j → G' i →ₗ[R] G' j)
    [DirectedSystem G' fun i j h => f' i j h]
    (g : ∀ i, G i →ₗ[R] G' i)
    (hg : ∀ i j h, g j ∘ₗ f i j h = f' i j h ∘ₗ g i)
    (hinj : ∀ i, Function.Injective (g i)) :
    Function.Injective
      (Module.DirectLimit.map (f := fun i j h => f i j h)
        (f' := fun i j h => f' i j h) g hg) := by
  rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
  intro z hz
  simp only [LinearMap.mem_ker] at hz
  obtain ⟨i, x, rfl⟩ := Module.DirectLimit.exists_of z
  rw [Module.DirectLimit.map_apply_of] at hz
  obtain ⟨j, hij, hj⟩ := Module.DirectLimit.of.zero_exact hz
  have hgz : g j (f i j hij x) = 0 := by
    have h2 := congrArg (fun m => m x) (hg i j hij)
    simp only [LinearMap.comp_apply] at h2
    rw [h2]; exact hj
  have hfx : f i j hij x = 0 := hinj j (by simpa using hgz)
  rw [← Module.DirectLimit.of_f (hij := hij), hfx]
  simp

/-- A directed colimit of flat modules is flat. -/
@[ega "0 6.2.3" "constant ring system", sga "3 V 4.1.2" "partial", sga "4 V 1.2" "special case"]
theorem flat_directLimit_of_flat
    (R : Type u) [CommRing R]
    {ι : Type u} [DecidableEq ι] [Preorder ι] [IsDirected ι (· ≤ ·)] [Nonempty ι]
    (G : ι → Type u) [∀ i, AddCommGroup (G i)] [∀ i, Module R (G i)]
    (f : ∀ i j, i ≤ j → G i →ₗ[R] G j)
    [DirectedSystem G fun i j h => f i j h]
    (hflat : ∀ i, Module.Flat R (G i)) :
    Module.Flat R (Module.DirectLimit G fun i j h => f i j h) := by
  rw [Module.Flat.iff_rTensor_injective]
  intro I hI
  set gI := fun i => LinearMap.rTensor (G i) (Submodule.subtype I) with hgI
  have hgI_inj : ∀ i, Function.Injective (gI i) := fun i =>
    Module.Flat.iff_rTensor_injective.mp (hflat i) hI
  have hcompat : ∀ i j (h : i ≤ j),
      (gI j) ∘ₗ (LinearMap.lTensor I (f i j h))
        = (LinearMap.lTensor R (f i j h)) ∘ₗ (gI i) := by
    intro i j h
    apply TensorProduct.ext'
    intro a x
    simp [hgI]
  have hmap_inj :=
    map_directLimit_injective_aux R (fun i => TensorProduct R I (G i))
      (fun i j h => LinearMap.lTensor I (f i j h))
      (fun i => TensorProduct R R (G i))
      (fun i j h => LinearMap.lTensor R (f i j h))
      gI hcompat hgI_inj
  have hfactor :
      LinearMap.rTensor (Module.DirectLimit G fun i j h => f i j h) (Submodule.subtype I)
        = (TensorProduct.directLimitRight (fun i j h => f i j h) R).symm.toLinearMap
            ∘ₗ (Module.DirectLimit.map gI hcompat)
            ∘ₗ (TensorProduct.directLimitRight (fun i j h => f i j h) I).toLinearMap := by
    apply TensorProduct.ext'
    intro a z
    induction z using Module.DirectLimit.induction_on with
    | ih i x =>
      simp only [hgI, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
        LinearMap.rTensor_tmul, Submodule.coe_subtype]
      rw [TensorProduct.directLimitRight_tmul_of, Module.DirectLimit.map_apply_of,
        LinearMap.rTensor_tmul, TensorProduct.directLimitRight_symm_of_tmul]
      rfl
  rw [show ⇑(LinearMap.rTensor (Module.DirectLimit G fun i j h => f i j h)
      (Submodule.subtype I)) = _ from congrArg DFunLike.coe hfactor]
  simp only [LinearMap.coe_comp, LinearEquiv.coe_coe]
  exact (TensorProduct.directLimitRight (fun i j h => f i j h) R).symm.injective.comp
    (hmap_inj.comp (TensorProduct.directLimitRight (fun i j h => f i j h) I).injective)

/-- Let `(A, t)` be a directed system of commutative rings over a directed nonempty index, and let
`B` act on the stages and on the ring colimit so that the transition maps (as `tl i j`) and the
legs (as `ofl i`) are `B`-linear. If every stage is `B`-flat, so is `Ring.DirectLimit A t`. -/
private theorem flat_ringDirectLimit_of_flat_stages
    {B : Type u} [CommRing B]
    {ι : Type u} [Preorder ι] [IsDirected ι (· ≤ ·)] [Nonempty ι]
    (A : ι → Type u) [∀ i, CommRing (A i)] [∀ i, Module B (A i)]
    (t : ∀ i j, i ≤ j → A i →+* A j)
    [DirectedSystem A fun i j h => (t i j h : A i → A j)]
    (tl : ∀ i j, i ≤ j → A i →ₗ[B] A j)
    (htl : ∀ i j (hij : i ≤ j) (x : A i), tl i j hij x = t i j hij x)
    (hflat : ∀ i, Module.Flat B (A i))
    [Module B (Ring.DirectLimit A fun i j h => (t i j h : A i → A j))]
    (ofl : ∀ i, A i →ₗ[B] Ring.DirectLimit A fun i j h => (t i j h : A i → A j))
    (hofl : ∀ i (x : A i),
        ofl i x = Ring.DirectLimit.of A (fun i j h => (t i j h : A i → A j)) i x) :
    Module.Flat B (Ring.DirectLimit A fun i j h => (t i j h : A i → A j)) := by
  classical
  set L := Ring.DirectLimit A (fun i j h => (t i j h : A i → A j)) with hL
  have hdsl : DirectedSystem A (fun i j h => ⇑(tl i j h)) := by
    refine ⟨?_, ?_⟩
    · intro i x
      simp only [htl]
      exact DirectedSystem.map_self (f := fun i j h => ((t i j h : A i → A j))) x
    · intro k j i hij hjk x
      simp only [htl]
      exact DirectedSystem.map_map (f := fun i j h => ((t i j h : A i → A j))) hij hjk x
  have hflatDL := flat_directLimit_of_flat B A tl hflat
  let ofM : ∀ i, A i →ₗ[B] Module.DirectLimit A (fun i j h => tl i j h) :=
    fun i => Module.DirectLimit.of B ι A (fun i j h => tl i j h) i
  have hofl_f : ∀ i j (hij : i ≤ j) (x : A i), ofl j (tl i j hij x) = ofl i x := by
    intro i j hij x
    rw [hofl, htl, hofl]
    exact Ring.DirectLimit.of_f (hij := hij) (x := x)
  let psi : Module.DirectLimit A (fun i j h => tl i j h) →ₗ[B] L :=
    Module.DirectLimit.lift B ι A (fun i j h => tl i j h) ofl hofl_f
  have hpsi_of : ∀ i (x : A i), psi (ofM i x) = ofl i x := fun _ x =>
    Module.DirectLimit.lift_of _ _ x
  have hsurj : Function.Surjective psi := by
    intro z
    induction z using Ring.DirectLimit.induction_on with
    | ih i x => exact ⟨ofM i x, by rw [hpsi_of i x, hofl i x]⟩
  have hinj : Function.Injective psi := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    induction z using Module.DirectLimit.induction_on with
    | ih i x =>
      rw [hpsi_of i x, hofl i x] at hz
      obtain ⟨j, hij, hx⟩ := Ring.DirectLimit.of.zero_exact (f' := t) hz
      have hx' : tl i j hij x = 0 := by simp only [htl]; exact hx
      calc ofM i x = ofM j (tl i j hij x) := (Module.DirectLimit.of_f).symm
        _ = ofM j 0 := by rw [hx']
        _ = 0 := map_zero _
  exact Module.Flat.of_linearEquiv (LinearEquiv.ofBijective psi ⟨hinj, hsurj⟩).symm

/-- A good lift of `R` towards `K`: a flat local `R`-algebra `A` with `m_A = m_R A`, together
with an embedding `ι : ResidueField A →+* K` over `ResidueField R`. -/
structure GoodLift (R : Type u) [CommRing R] [IsLocalRing R]
    (K : Type u) [Field K] [Algebra (ResidueField R) K] where
  /-- The carrier ring `A`. -/
  carrier : Type u
  commRing : CommRing carrier
  isLocalRing : IsLocalRing carrier
  /-- The structure map `φ : R → A`. -/
  φ : R →+* carrier
  hφ : IsLocalHom φ
  /-- `A` is flat over `R` via `φ`. -/
  flat : letI : Algebra R carrier := φ.toAlgebra; Module.Flat R carrier
  /-- `m_A = m·A`. -/
  maxeq : maximalIdeal carrier = Ideal.map φ (maximalIdeal R)
  /-- The `k`-embedding of the residue field of `A` into `K`. -/
  ι : ResidueField carrier →+* K
  /-- `ι` is compatible with the structure maps from `k = ResidueField R`. -/
  hι : ι.comp (@ResidueField.map R carrier _ _ _ _ φ hφ) = algebraMap (ResidueField R) K

attribute [instance] GoodLift.commRing GoodLift.isLocalRing GoodLift.hφ

/-- A morphism of good lifts `g ≤ h`: a flat local ring map `ψ : g.carrier →+* h.carrier` with
`m_h = m_g · h.carrier`, commuting with the structure maps from `R` and with the residue field
embeddings into `K`. -/
def GoodLiftLE {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K] (g h : GoodLift R K) : Prop :=
  ∃ ψ : g.carrier →+* h.carrier,
    ∃ hψ : IsLocalHom ψ,
      (letI : Algebra g.carrier h.carrier := ψ.toAlgebra; Module.Flat g.carrier h.carrier) ∧
      (maximalIdeal h.carrier = Ideal.map ψ (maximalIdeal g.carrier)) ∧
      (ψ.comp g.φ = h.φ) ∧
      (h.ι.comp (@ResidueField.map g.carrier h.carrier _ _ _ _ ψ hψ) = g.ι)

/-- `GoodLiftLE` is reflexive. -/
theorem goodLiftLE_refl {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K] (g : GoodLift R K) :
    GoodLiftLE g g := by
  refine ⟨RingHom.id g.carrier, ?_, ?_, ?_, ?_, ?_⟩
  · exact ⟨fun a ha => ha⟩
  · exact RingHom.Flat.id g.carrier
  · rw [Ideal.map_id]
  · rw [RingHom.id_comp]
  · rw [IsLocalRing.ResidueField.map_id, RingHom.comp_id]

/-- `GoodLiftLE` is transitive. -/
theorem goodLiftLE_trans {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K] {g h l : GoodLift R K}
    (hgh : GoodLiftLE g h) (hhl : GoodLiftLE h l) : GoodLiftLE g l := by
  obtain ⟨ψ, hψ, ψflat, ψmaxeq, ψφ, ψι⟩ := hgh
  obtain ⟨χ, hχ, χflat, χmaxeq, χφ, χι⟩ := hhl
  obtain ⟨hflat, hmax⟩ := flat_and_maximalIdeal_eq_map_comp g.carrier h.carrier l.carrier ψ χ
    ψflat χflat ψmaxeq χmaxeq
  refine ⟨χ.comp ψ, RingHom.isLocalHom_comp χ ψ, hflat, hmax,
    by rw [RingHom.comp_assoc, ψφ, χφ], ?_⟩
  rw [IsLocalRing.ResidueField.map_comp ψ χ, ← RingHom.comp_assoc, χι, ψι]

/-- Ring maps `t i j` satisfying the functoriality identities form a directed system. -/
private theorem directedSystem_of_ringHom {ι : Type u} [Preorder ι]
    {A : ι → Type u} [∀ i, CommRing (A i)] (t : ∀ i j, i ≤ j → A i →+* A j)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (A i))
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk)) :
    DirectedSystem A fun i j h => (t i j h : A i → A j) :=
  ⟨fun i x => by rw [ht_id i]; rfl, fun k j i hij hjk x =>
    congrArg (fun (m : A i →+* A k) => m x) (ht_comp i j k hij hjk)⟩

/-- A ring map commuting with the `B`-algebra structures, as a `B`-linear map. -/
private def ringHomToLinearMap {B S T : Type u} [CommRing B] [CommRing S] [CommRing T]
    [Algebra B S] [Algebra B T] (f : S →+* T)
    (hf : ∀ b, f (algebraMap B S b) = algebraMap B T b) : S →ₗ[B] T where
  toFun := f
  map_add' := map_add f
  map_smul' r x := by simp only [RingHom.id_apply, Algebra.smul_def, map_mul, hf]

/-- In the colimit of a coherent system of good lifts, the images of `(g i).φ r` and
`(g i₀).φ r` agree. -/
private theorem directLimit_of_φ_eq {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {ι : Type u} [Preorder ι] [IsDirected ι (· ≤ ·)]
    (g : ι → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ) (i i₀ : ι) (r : R) :
    Ring.DirectLimit.of (fun i => (g i).carrier)
        (fun i j h => (t i j h : (g i).carrier → (g j).carrier)) i ((g i).φ r) =
      Ring.DirectLimit.of (fun i => (g i).carrier)
        (fun i j h => (t i j h : (g i).carrier → (g j).carrier)) i₀ ((g i₀).φ r) := by
  obtain ⟨k, hik, hi0k⟩ := directed_of (· ≤ ·) i i₀
  rw [← Ring.DirectLimit.of_f hik, ← Ring.DirectLimit.of_f hi0k]
  exact congrArg _ ((congrArg (fun m : R →+* (g k).carrier => m r) (ht_φ i k hik)).trans
    (congrArg (fun m : R →+* (g k).carrier => m r) (ht_φ i₀ k hi0k)).symm)

/-- The colimit of a directed system of good lifts is flat over `R` via
`Ring.DirectLimit.of … i₀ ∘ (g i₀).φ`. -/
@[ega "0 10.3.1.4" "(iii)", ega "0 6.2.3" "special case", sga "3 V 4.1.2" "partial"]
theorem goodLift_colimit_flat_over_R {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {ι : Type u} [Preorder ι] [IsDirected ι (· ≤ ·)] [Nonempty ι]
    (g : ι → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ)
    (i₀ : ι) :
    RingHom.Flat ((Ring.DirectLimit.of (fun i => (g i).carrier)
        (fun i j h => (t i j h : (g i).carrier → (g j).carrier)) i₀).comp (g i₀).φ) := by
  classical
  let algC : ∀ i, Algebra R (g i).carrier := fun i => (g i).φ.toAlgebra
  set A := fun i => (g i).carrier with hA
  have hds := directedSystem_of_ringHom t ht_id ht_comp
  let tfl : ∀ i j, i ≤ j → A i →ₗ[R] A j := fun i j hij =>
    ringHomToLinearMap (t i j hij) fun r => congrArg (fun (m : R →+* A j) => m r) (ht_φ i j hij)
  set L := Ring.DirectLimit A (fun i j h => ⇑(t i j h)) with hL
  let ofL : ∀ i, A i →+* L := fun i => Ring.DirectLimit.of A (fun i j h => ⇑(t i j h)) i
  let phiInf : R →+* L := (ofL i₀).comp (g i₀).φ
  let algL : Algebra R L := phiInf.toAlgebra
  let modL : Module R L := algL.toModule
  let ofLlin : ∀ i, A i →ₗ[R] L := fun i =>
    ringHomToLinearMap (ofL i) fun r => directLimit_of_φ_eq g t ht_φ i i₀ r
  exact flat_ringDirectLimit_of_flat_stages A t tfl (fun _ _ _ _ => rfl)
    (fun i => (g i).flat) ofLlin (fun _ _ => rfl)

/-- If every transition map of a directed system of good lifts is flat, then the colimit is flat
over each stage `(g i).carrier` via `Ring.DirectLimit.of … i`. -/
@[ega "0 10.3.1.3" "partial",
  ega "0 10.3.1.4" "(iii)",
  ega "0 6.2.3" "special case",
  sga "3 V 4.1.2" "partial"]
theorem goodLift_colimit_flat_over_base {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {ι : Type u} [Preorder ι] [IsDirected ι (· ≤ ·)] [Nonempty ι]
    (g : ι → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_flat : ∀ i j (hij : i ≤ j),
        letI : Algebra (g i).carrier (g j).carrier := (t i j hij).toAlgebra
        Module.Flat (g i).carrier (g j).carrier)
    (i : ι) :
    RingHom.Flat (Ring.DirectLimit.of (fun i => (g i).carrier)
        (fun i j h => (t i j h : (g i).carrier → (g j).carrier)) i) := by
  classical
  set A := fun i => (g i).carrier with hA
  let J := {j : ι // i ≤ j}
  have : Nonempty J := ⟨⟨i, le_refl i⟩⟩
  have : IsDirected J (· ≤ ·) := by
    refine ⟨fun a b => ?_⟩
    obtain ⟨k, hak, hbk⟩ := directed_of (· ≤ ·) a.val b.val
    exact ⟨⟨k, le_trans a.property hak⟩, hak, hbk⟩
  let B : Type u := A i
  let AJ : J → Type u := fun a => A a.val
  let tJ : ∀ a b : J, a ≤ b → AJ a →+* AJ b := fun a b hab => t a.val b.val hab
  let tJf : ∀ a b : J, a ≤ b → AJ a → AJ b := fun a b hab => (t a.val b.val hab : AJ a → AJ b)
  let tf : ∀ a b : ι, a ≤ b → A a → A b := fun a b h => (t a b h : A a → A b)
  let L := Ring.DirectLimit A tf
  let ofL : ∀ k, A k →+* L := fun k => Ring.DirectLimit.of A tf k
  let RJ := Ring.DirectLimit AJ tJf
  let ofRJ : ∀ a : J, AJ a →+* RJ := fun a => Ring.DirectLimit.of AJ tJf a
  have hofL_f : ∀ a b (hab : a ≤ b) (x : A a), ofL b (t a b hab x) = ofL a x :=
    fun a b hab x => Ring.DirectLimit.of_f (hij := hab) (x := x)
  have hofRJ_f : ∀ a b (hab : a ≤ b) (x : AJ a), ofRJ b (t a.val b.val hab x) = ofRJ a x :=
    fun a b hab x => Ring.DirectLimit.of_f (hij := hab) (x := x)
  let algBJ : ∀ a : J, Algebra B (AJ a) := fun a => (t i a.val a.property).toAlgebra
  have hdsJ : DirectedSystem AJ (fun a b h => tJf a b h) :=
    directedSystem_of_ringHom tJ (fun a => ht_id a.val)
      (fun a b c hab hbc => ht_comp a.val b.val c.val hab hbc)
  let tflJ : ∀ a b : J, a ≤ b → AJ a →ₗ[B] AJ b := fun a b hab =>
    ringHomToLinearMap (tJ a b hab) fun r =>
      congrArg (fun (m : A i →+* A b.val) => m r) (ht_comp i a.val b.val a.property hab)
  have hflatJ : ∀ a : J, Module.Flat B (AJ a) := fun a => ht_flat i a.val a.property
  have hFcompat : ∀ (a b : J) (hab : a ≤ b) (x : AJ a),
      (ofL b.val) (tJf a b hab x) = (ofL a.val) x :=
    fun a b hab x => hofL_f a.val b.val hab x
  let F : RJ →+* L := Ring.DirectLimit.lift AJ tJf L (fun a => ofL a.val) hFcompat
  have hF_of : ∀ (a : J) (x : AJ a), F (ofRJ a x) = ofL a.val x :=
    fun a x => Ring.DirectLimit.lift_of (G := AJ) (f := tJf) L _ hFcompat a x
  have hch : ∀ k : ι, ∃ d : J, k ≤ d.val := by
    intro k
    obtain ⟨d, hkd, hid⟩ := directed_of (· ≤ ·) k i
    exact ⟨⟨d, hid⟩, hkd⟩
  let c : ι → J := fun k => (hch k).choose
  have hc : ∀ k, k ≤ (c k).val := fun k => (hch k).choose_spec
  let gk : ∀ k, A k →+* RJ := fun k => (ofRJ (c k)).comp (t k (c k).val (hc k))
  have hgk_compat : ∀ k k' (hkk' : k ≤ k') (x : A k), gk k' (t k k' hkk' x) = gk k x := by
    intro k k' hkk' x
    show ofRJ (c k') (t k' (c k').val (hc k') (t k k' hkk' x)) = ofRJ (c k) (t k (c k).val (hc k)
        x)
    obtain ⟨d, hd1, hd2⟩ := directed_of (· ≤ ·) (c k) (c k')
    rw [← hofRJ_f (c k) d hd1 (t k (c k).val (hc k) x)]
    rw [← hofRJ_f (c k') d hd2 (t k' (c k').val (hc k') (t k k' hkk' x))]
    congr 1
    show t (c k').val d.val hd2 (t k' (c k').val (hc k') (t k k' hkk' x))
        = t (c k).val d.val hd1 (t k (c k).val (hc k) x)
    rw [show t (c k').val d.val hd2 (t k' (c k').val (hc k') (t k k' hkk' x))
          = t k' d.val (le_trans (hc k') hd2) (t k k' hkk' x) from
        congrArg (fun (m : A k' →+* A d.val) => m (t k k' hkk' x))
          (ht_comp k' (c k').val d.val (hc k') hd2)]
    rw [show t k' d.val (le_trans (hc k') hd2) (t k k' hkk' x)
          = t k d.val (le_trans hkk' (le_trans (hc k') hd2)) x from
        congrArg (fun (m : A k →+* A d.val) => m x)
          (ht_comp k k' d.val hkk' (le_trans (hc k') hd2))]
    rw [show t (c k).val d.val hd1 (t k (c k).val (hc k) x)
          = t k d.val (le_trans (hc k) hd1) x from
        congrArg (fun (m : A k →+* A d.val) => m x) (ht_comp k (c k).val d.val (hc k) hd1)]
  let G : L →+* RJ := Ring.DirectLimit.lift A tf RJ gk hgk_compat
  have hG_of : ∀ k (x : A k), G (ofL k x) = gk k x :=
    fun k x => Ring.DirectLimit.lift_of (G := A) (f := tf) RJ gk hgk_compat k x
  have hFG : ∀ z : L, F (G z) = z := by
    intro z
    induction z using Ring.DirectLimit.induction_on with
    | ih k x =>
      rw [hG_of k x]
      show F (ofRJ (c k) (t k (c k).val (hc k) x)) = ofL k x
      rw [hF_of (c k) (t k (c k).val (hc k) x)]
      show ofL (c k).val (t k (c k).val (hc k) x) = ofL k x
      exact hofL_f k (c k).val (hc k) x
  have hGF : ∀ z : RJ, G (F z) = z := by
    intro z
    induction z using Ring.DirectLimit.induction_on with
    | ih a x =>
      rw [hF_of a x]
      show G (ofL a.val x) = ofRJ a x
      rw [hG_of a.val x]
      show ofRJ (c a.val) (t a.val (c a.val).val (hc a.val) x) = ofRJ a x
      obtain ⟨d, hd1, hd2⟩ := directed_of (· ≤ ·) a (c a.val)
      rw [← hofRJ_f a d hd1 x]
      rw [← hofRJ_f (c a.val) d hd2 (t a.val (c a.val).val (hc a.val) x)]
      congr 1
      show t (c a.val).val d.val hd2 (t a.val (c a.val).val (hc a.val) x) = t a.val d.val hd1 x
      rw [show t (c a.val).val d.val hd2 (t a.val (c a.val).val (hc a.val) x)
            = t a.val d.val (le_trans (hc a.val) hd2) x from
          congrArg (fun (m : A a.val →+* A d.val) => m x)
            (ht_comp a.val (c a.val).val d.val (hc a.val) hd2)]
  let eRing : RJ ≃+* L :=
    { toFun := F, invFun := G, left_inv := hGF, right_inv := hFG,
      map_mul' := map_mul F, map_add' := map_add F }
  let i₀J : J := ⟨i, le_refl i⟩
  let algRJ : Algebra B RJ := (ofRJ i₀J).toAlgebra
  let modRJ : Module B RJ := algRJ.toModule
  let ofRJlin : ∀ a : J, AJ a →ₗ[B] RJ := fun a =>
    ringHomToLinearMap (ofRJ a) fun r => hofRJ_f i₀J a a.property r
  have hflatRJ : Module.Flat B RJ :=
    flat_ringDirectLimit_of_flat_stages AJ tJ tflJ (fun _ _ _ _ => rfl) hflatJ ofRJlin
      (fun _ _ => rfl)
  let modL : Module B L := (ofL i).toAlgebra.toModule
  have hRingSmul : ∀ (r : B) (w : RJ), eRing (r • w) = r • eRing w := by
    intro r w
    show F (ofRJ i₀J r * w) = ofL i r * F w
    rw [map_mul, hF_of i₀J r]
  let eLinRing : RJ ≃ₗ[B] L :=
    { eRing.toAddEquiv with
      map_smul' := hRingSmul }
  exact Module.Flat.of_linearEquiv (R := B) (M := RJ) (N := L) eLinRing.symm

/-- The colimit of a coherent directed system `(g, t)` of good lifts is a good lift `ub` with
local legs `s i` such that `s j ∘ t i j = s i`, `m_ub = m_{g i} · ub`, and the legs commute
with the structure maps and the embeddings into `K`. Every element of `ub` comes from a stage,
`ub` is universal among compatible families, and if every `t i j` is flat then every `s i` is
flat. -/
@[ega "0 10.3.1.3" "partial", ega "IV 18.8.6" "partial"]
private theorem goodLift_colimit_chosen_core {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I]
    (g : I → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_local : ∀ i j (hij : i ≤ j), IsLocalHom (t i j hij))
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ)
    (ht_ι : ∀ i j (hij : i ≤ j),
        (g j).ι.comp (@ResidueField.map (g i).carrier (g j).carrier _ _ _ _
          (t i j hij) (ht_local i j hij)) = (g i).ι) :
    ∃ (ub : GoodLift R K) (s : ∀ i, (g i).carrier →+* ub.carrier)
      (hs_local : ∀ i, IsLocalHom (s i)),
      (∀ i j (hij : i ≤ j), (s j).comp (t i j hij) = s i) ∧
      (∀ i, maximalIdeal ub.carrier = Ideal.map (s i) (maximalIdeal (g i).carrier)) ∧
      (∀ i, (s i).comp (g i).φ = ub.φ) ∧
      (∀ i, (ub.ι).comp (@ResidueField.map (g i).carrier ub.carrier _ _ _ _
        (s i) (hs_local i)) = (g i).ι) ∧
      (∀ z : ub.carrier, ∃ i x, s i x = z) ∧
      (∀ (T : Type u) [CommRing T] (τ : ∀ i, (g i).carrier →+* T),
        (∀ i j (hij : i ≤ j), (τ j).comp (t i j hij) = τ i) →
        ∃ h : ub.carrier →+* T, ∀ i, h.comp (s i) = τ i) ∧
      ((∀ i j (hij : i ≤ j),
          letI : Algebra (g i).carrier (g j).carrier := (t i j hij).toAlgebra
          Module.Flat (g i).carrier (g j).carrier) →
        ∀ i, letI : Algebra (g i).carrier ub.carrier := (s i).toAlgebra
          Module.Flat (g i).carrier ub.carrier) := by
  classical
  have flatR := goodLift_colimit_flat_over_R g t ht_id ht_comp ht_φ
  set A := fun i => (g i).carrier with hA
  have hds := directedSystem_of_ringHom t ht_id ht_comp
  let tf : ∀ i j, i ≤ j → A i → A j := fun i j h => (t i j h : A i → A j)
  let L := Ring.DirectLimit A tf
  let ofL : ∀ i, A i →+* L := fun i => Ring.DirectLimit.of A tf i
  have hof_f : ∀ i j (hij : i ≤ j) (x : A i), ofL j (t i j hij x) = ofL i x :=
    fun i j hij x => Ring.DirectLimit.of_f (hij := hij) (x := x)
  let RF : I → Type u := fun i => ResidueField (A i)
  let rtf : ∀ i j, i ≤ j → RF i →+* RF j := fun i j h =>
    @ResidueField.map (A i) (A j) _ _ _ _ (t i j h) (ht_local i j h)
  have hdsRF : DirectedSystem RF (fun i j h => (rtf i j h : RF i → RF j)) := by
    refine ⟨?_, ?_⟩
    · intro i x
      show (@ResidueField.map (A i) (A i) _ _ _ _ (t i i (le_refl i)) (ht_local i i (le_refl i)))
          x = x
      have h1 : (@ResidueField.map (A i) (A i) _ _ _ _ (t i i (le_refl i)) (ht_local i i (le_refl
          i)))
          = ResidueField.map (RingHom.id (A i)) := by congr 1; exact ht_id i
      rw [h1, ResidueField.map_id]; rfl
    · intro k j i hij hjk x
      show (rtf j k hjk) ((rtf i j hij) x) = (rtf i k (le_trans hij hjk)) x
      have h2 : (rtf j k hjk).comp (rtf i j hij) = rtf i k (le_trans hij hjk) := by
        show (@ResidueField.map (A j) (A k) _ _ _ _ (t j k hjk) _).comp
              (@ResidueField.map (A i) (A j) _ _ _ _ (t i j hij) _)
            = @ResidueField.map (A i) (A k) _ _ _ _ (t i k (le_trans hij hjk)) _
        rw [← ResidueField.map_comp (t i j hij) (t j k hjk)]; congr 1; exact ht_comp i j k hij hjk
      exact congrArg (fun (m : RF i →+* RF k) => m x) h2
  let rtff : ∀ i j, i ≤ j → RF i → RF j := fun i j h => (rtf i j h : RF i → RF j)
  let RL := Ring.DirectLimit RF rtff
  let ofRL : ∀ i, RF i →+* RL := fun i => Ring.DirectLimit.of RF rtff i
  have hofRL_f : ∀ i j (hij : i ≤ j) (x : RF i), ofRL j (rtf i j hij x) = ofRL i x :=
    fun i j hij x => Ring.DirectLimit.of_f (hij := hij) (x := x)
  have hRLnt : Nontrivial RL := Field.DirectLimit.nontrivial RF rtf
  have hcompat : ∀ i j (hij : i ≤ j) (x : A i),
      ((ofRL j).comp (residue (A j))) (t i j hij x) = ((ofRL i).comp (residue (A i))) x := by
    intro i j hij x
    simp only [RingHom.comp_apply]
    rw [show residue (A j) (t i j hij x) = rtf i j hij (residue (A i) x) from
      (ResidueField.map_residue (t i j hij) x).symm]
    exact hofRL_f i j hij (residue (A i) x)
  let π : L →+* RL := Ring.DirectLimit.lift A tf RL (fun i => (ofRL i).comp (residue (A i))) hcompat
  have hπ_ofL : ∀ i (x : A i), π (ofL i x) = ofRL i (residue (A i) x) := fun i x =>
    Ring.DirectLimit.lift_of (G := A) (f := tf) RL _ hcompat i x
  have hδcompat : ∀ i j (hij : i ≤ j) (x : RF i), (g j).ι (rtf i j hij x) = (g i).ι x :=
    fun i j hij x => congrArg (fun (m : RF i →+* K) => m x) (ht_ι i j hij)
  let δ : RL →+* K := Ring.DirectLimit.lift RF rtff K (fun i => (g i).ι) hδcompat
  have hδ_ofRL : ∀ i (x : RF i), δ (ofRL i x) = (g i).ι x := fun i x =>
    Ring.DirectLimit.lift_of (G := RF) (f := rtff) K _ hδcompat i x
  let i₀ : I := Classical.arbitrary I
  let phiInf : R →+* L := (ofL i₀).comp (g i₀).φ
  have hphiInf : ∀ i, (ofL i).comp (g i).φ = phiInf := by
    intro i
    ext a
    exact directLimit_of_φ_eq g t ht_φ i i₀ a
  let mL : Ideal L := Ideal.map phiInf (maximalIdeal R)
  have hnonunit_mem : ∀ i (x : A i), x ∈ maximalIdeal (A i) → ofL i x ∈ mL := by
    intro i x hxm
    rw [(g i).maxeq] at hxm
    have hmem : ofL i x ∈ Ideal.map (ofL i) (Ideal.map (g i).φ (maximalIdeal R)) :=
      Ideal.mem_map_of_mem _ hxm
    rwa [Ideal.map_map, hphiInf i] at hmem
  have hunit_or : ∀ z : L, IsUnit z ∨ z ∈ mL := by
    intro z
    obtain ⟨i, x, rfl⟩ := Ring.DirectLimit.exists_of (G := A) (f := tf) z
    by_cases hu : IsUnit x
    · exact Or.inl (hu.map (ofL i))
    · exact Or.inr (hnonunit_mem i x (by rwa [mem_maximalIdeal]))
  have hπmL : ∀ z ∈ mL, π z = 0 := by
    have hle : mL ≤ RingHom.ker π := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have hfa : (g i₀).φ a ∈ maximalIdeal (A i₀) := by
        rw [(g i₀).maxeq]; exact Ideal.mem_map_of_mem _ ha
      have hcalc : π (phiInf a) = ofRL i₀ (residue (A i₀) ((g i₀).φ a)) := by
        show π (ofL i₀ ((g i₀).φ a)) = _
        rw [hπ_ofL i₀ ((g i₀).φ a)]
      rw [hcalc, (residue_eq_zero_iff ((g i₀).φ a)).mpr hfa, map_zero]
    intro z hz; exact hle hz
  have h1notmem : (1 : L) ∉ mL := by
    intro h1mem
    have : π 1 = 0 := hπmL 1 h1mem
    rw [map_one] at this; exact one_ne_zero this
  have hmL_nonunits : (mL : Set L) ⊆ nonunits L := by
    intro z hz; rw [mem_nonunits_iff]; intro hu
    exact h1notmem (by
      obtain ⟨zinv, hzinv⟩ := hu.exists_right_inv
      rw [show (1 : L) = z * zinv from hzinv.symm]; exact Ideal.mul_mem_right _ _ hz)
  have hnu_eq : nonunits L = (mL : Set L) := by
    apply Set.Subset.antisymm
    · intro z hz; rcases hunit_or z with hu | hm
      · exact absurd hu (mem_nonunits_iff.mp hz)
      · exact hm
    · exact hmL_nonunits
  have hLnt : Nontrivial L := by
    refine ⟨0, 1, fun h => h1notmem ?_⟩
    rw [← h]; exact Ideal.zero_mem mL
  have hLlocal : IsLocalRing L := by
    apply IsLocalRing.of_nonunits_add
    intro a b ha hb; rw [hnu_eq] at ha hb ⊢; exact Ideal.add_mem mL ha hb
  have hmaxL : maximalIdeal L = mL := by
    apply SetLike.coe_injective; rw [← hnu_eq]; rfl
  have hπker : ∀ z ∈ maximalIdeal L, π z = 0 := by rw [hmaxL]; exact hπmL
  let πbar : ResidueField L →+* RL := Ideal.Quotient.lift (maximalIdeal L) π hπker
  have hπbar_res : ∀ z : L, πbar (residue L z) = π z := fun z => rfl
  let ιL : ResidueField L →+* K := δ.comp πbar
  let ub : GoodLift R K :=
  { carrier := L
    commRing := inferInstance
    isLocalRing := hLlocal
    φ := phiInf
    hφ := by
      refine ⟨fun a hua => ?_⟩
      by_contra hna
      have ham : a ∈ maximalIdeal R := by rw [mem_maximalIdeal]; exact hna
      have hmem : phiInf a ∈ mL := Ideal.mem_map_of_mem _ ham
      have hnu : phiInf a ∈ nonunits L := hnu_eq.symm ▸ hmem
      exact (mem_nonunits_iff.mp hnu) hua
    flat := flatR i₀
    maxeq := hmaxL
    ι := ιL
    hι := by
      apply RingHom.ext
      intro x
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
      rw [RingHom.comp_apply, IsLocalRing.ResidueField.map_residue]
      show ιL (residue L (phiInf a)) = algebraMap (ResidueField R) K (residue R a)
      show δ (πbar (residue L (phiInf a))) = _
      rw [hπbar_res (phiInf a)]
      show δ (π (ofL i₀ ((g i₀).φ a))) = _
      rw [hπ_ofL i₀ ((g i₀).φ a)]
      rw [show residue (A i₀) ((g i₀).φ a) = ResidueField.map (g i₀).φ (residue R a) from
        (IsLocalRing.ResidueField.map_residue (g i₀).φ a).symm]
      rw [hδ_ofRL i₀ (ResidueField.map (g i₀).φ (residue R a))]
      show ((g i₀).ι.comp (ResidueField.map (g i₀).φ)) (residue R a) = _
      rw [(g i₀).hι] }
  have hlocal_ofL : ∀ i, IsLocalHom (ofL i) := by
    intro i
    refine ⟨fun x hux => ?_⟩
    by_contra hnx
    have hnu : ofL i x ∈ nonunits L :=
      hnu_eq.symm ▸ hnonunit_mem i x (by rwa [mem_maximalIdeal])
    exact (mem_nonunits_iff.mp hnu) hux
  refine ⟨ub, ofL, hlocal_ofL, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact fun i j hij => RingHom.ext (hof_f i j hij)
  · intro i
    rw [(g i).maxeq, Ideal.map_map, hphiInf i, hmaxL]
  · intro i
    exact hphiInf i
  · intro i
    apply RingHom.ext
    intro x
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
    show ιL (ResidueField.map (ofL i) (residue (A i) a)) = (g i).ι (residue (A i) a)
    rw [IsLocalRing.ResidueField.map_residue]
    show δ (πbar (residue L (ofL i a))) = _
    rw [hπbar_res (ofL i a), hπ_ofL i a, hδ_ofRL i (residue (A i) a)]
  · exact fun z => Ring.DirectLimit.exists_of (G := A) (f := tf) z
  · intro T _ τ hτ
    have hcompat : ∀ i j (hij : i ≤ j) (x : A i), τ j (t i j hij x) = τ i x :=
      fun i j hij x => congrArg (fun (m : A i →+* T) => m x) (hτ i j hij)
    refine ⟨Ring.DirectLimit.lift A tf T τ hcompat, ?_⟩
    intro i
    apply RingHom.ext
    intro x
    show Ring.DirectLimit.lift A tf T τ hcompat (ofL i x) = τ i x
    exact Ring.DirectLimit.lift_of (G := A) (f := tf) T _ hcompat i x
  · intro ht_flat i
    exact goodLift_colimit_flat_over_base g t ht_id ht_comp ht_flat i

/-- A coherent directed system of good lifts with flat local transition maps has a good lift
dominating every stage. -/
@[sga "3 V 4.1.2" "partial"]
theorem goodLift_colimit_directed {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {ι : Type u} [Preorder ι] [IsDirected ι (· ≤ ·)] [Nonempty ι]
    (g : ι → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_local : ∀ i j (hij : i ≤ j), IsLocalHom (t i j hij))
    (ht_flat : ∀ i j (hij : i ≤ j),
        letI : Algebra (g i).carrier (g j).carrier := (t i j hij).toAlgebra
        Module.Flat (g i).carrier (g j).carrier)
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ)
    (ht_ι : ∀ i j (hij : i ≤ j),
        (g j).ι.comp (@ResidueField.map (g i).carrier (g j).carrier _ _ _ _
          (t i j hij) (ht_local i j hij)) = (g i).ι) :
    ∃ ub : GoodLift R K, ∀ i, GoodLiftLE (g i) ub := by
  obtain ⟨ub, s, hs_local, _, hs_maxeq, hs_φ, hs_ι, _, _, hs_flat⟩ :=
    goodLift_colimit_chosen_core g t ht_id ht_comp ht_local ht_φ ht_ι
  exact ⟨ub, fun i => ⟨s i, hs_local i, hs_flat ht_flat i, hs_maxeq i, hs_φ i, hs_ι i⟩⟩


/-! ### Colimits and monogenic enlargement of good lifts -/

/-- The colimit of a coherent directed system of good lifts with flat transition maps is a good
lift `ub` with legs `s i` such that `s j ∘ t i j = s i`, each leg a morphism of good lifts;
every element of `ub` comes from a stage, and `ub` is universal among compatible families. -/
@[ega "0 10.3.1.3" "partial",
  ega "0 10.3.1.4" "limit stage",
  ega "0 6.2.3" "special case",
  sga "3 V 4.1.2"]
theorem goodLift_colimit_chosen {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I]
    (g : I → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_local : ∀ i j (hij : i ≤ j), IsLocalHom (t i j hij))
    (ht_flat : ∀ i j (hij : i ≤ j),
        letI : Algebra (g i).carrier (g j).carrier := (t i j hij).toAlgebra
        Module.Flat (g i).carrier (g j).carrier)
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ)
    (ht_ι : ∀ i j (hij : i ≤ j),
        (g j).ι.comp (@ResidueField.map (g i).carrier (g j).carrier _ _ _ _
          (t i j hij) (ht_local i j hij)) = (g i).ι) :
    ∃ (ub : GoodLift R K) (s : ∀ i, (g i).carrier →+* ub.carrier)
      (hs_local : ∀ i, IsLocalHom (s i)),
      (∀ i j (hij : i ≤ j), (s j).comp (t i j hij) = s i) ∧
      (∀ i, letI : Algebra (g i).carrier ub.carrier := (s i).toAlgebra
        Module.Flat (g i).carrier ub.carrier) ∧
      (∀ i, maximalIdeal ub.carrier = Ideal.map (s i) (maximalIdeal (g i).carrier)) ∧
      (∀ i, (s i).comp (g i).φ = ub.φ) ∧
      (∀ i, (ub.ι).comp (@ResidueField.map (g i).carrier ub.carrier _ _ _ _
        (s i) (hs_local i)) = (g i).ι) ∧
      (∀ z : ub.carrier, ∃ i x, s i x = z) ∧
      (∀ (T : Type u) [CommRing T] (τ : ∀ i, (g i).carrier →+* T),
        (∀ i j (hij : i ≤ j), (τ j).comp (t i j hij) = τ i) →
        ∃ h : ub.carrier →+* T, ∀ i, h.comp (s i) = τ i) := by
  obtain ⟨ub, s, hs_local, hs_cocycle, hs_maxeq, hs_φ, hs_ι, hs_exh, hs_univ, hs_flat⟩ :=
    goodLift_colimit_chosen_core g t ht_id ht_comp ht_local ht_φ ht_ι
  exact ⟨ub, s, hs_local, hs_cocycle, hs_flat ht_flat, hs_maxeq, hs_φ, hs_ι, hs_exh, hs_univ⟩

/-- The colimit of a coherent directed system of good lifts is a good lift `ub` with local legs
`s i` such that `s j ∘ t i j = s i`, `m_ub = m_{g i} · ub`, and the legs commute with the
structure maps and the embeddings into `K`; every element of `ub` comes from a stage, and `ub`
is universal among compatible families. -/
@[ega "0 10.3.1.3" "partial", ega "0 10.3.1.4" "limit stage", sga "3 V 4.1.2"]
theorem goodLift_colimit_chosen_noflat {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I]
    (g : I → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_local : ∀ i j (hij : i ≤ j), IsLocalHom (t i j hij))
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ)
    (ht_ι : ∀ i j (hij : i ≤ j),
        (g j).ι.comp (@ResidueField.map (g i).carrier (g j).carrier _ _ _ _
          (t i j hij) (ht_local i j hij)) = (g i).ι) :
    ∃ (ub : GoodLift R K) (s : ∀ i, (g i).carrier →+* ub.carrier)
      (hs_local : ∀ i, IsLocalHom (s i)),
      (∀ i j (hij : i ≤ j), (s j).comp (t i j hij) = s i) ∧
      (∀ i, maximalIdeal ub.carrier = Ideal.map (s i) (maximalIdeal (g i).carrier)) ∧
      (∀ i, (s i).comp (g i).φ = ub.φ) ∧
      (∀ i, (ub.ι).comp (@ResidueField.map (g i).carrier ub.carrier _ _ _ _
        (s i) (hs_local i)) = (g i).ι) ∧
      (∀ z : ub.carrier, ∃ i x, s i x = z) ∧
      (∀ (T : Type u) [CommRing T] (τ : ∀ i, (g i).carrier →+* T),
        (∀ i j (hij : i ≤ j), (τ j).comp (t i j hij) = τ i) →
        ∃ h : ub.carrier →+* T, ∀ i, h.comp (s i) = τ i) := by
  obtain ⟨ub, s, hs_local, hs_cocycle, hs_maxeq, hs_φ, hs_ι, hs_exh, hs_univ, _⟩ :=
    goodLift_colimit_chosen_core g t ht_id ht_comp ht_local ht_φ ht_ι
  exact ⟨ub, s, hs_local, hs_cocycle, hs_maxeq, hs_φ, hs_ι, hs_exh, hs_univ⟩

/-- Given a good lift `h` and an element `α : K`, there is a good lift `h'` and a morphism of
good lifts `m : h.carrier →+* h'.carrier` such that `α` lies in the range of `h'.ι`. -/
@[ega "0 10.3.1.4" "successor step", sga "3 V 4.1.2" "monogenic successor step"]
theorem goodLift_monogenic_step {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    (h : GoodLift R K) (α : K) :
    ∃ (h' : GoodLift R K) (m : h.carrier →+* h'.carrier) (hm : IsLocalHom m),
      (letI : Algebra h.carrier h'.carrier := m.toAlgebra; Module.Flat h.carrier h'.carrier) ∧
      (maximalIdeal h'.carrier = Ideal.map m (maximalIdeal h.carrier)) ∧
      (m.comp h.φ = h'.φ) ∧
      (h'.ι.comp (@ResidueField.map h.carrier h'.carrier _ _ _ _ m hm) = h.ι) ∧
      α ∈ Set.range h'.ι := by
  let : Algebra (ResidueField h.carrier) K := h.ι.toAlgebra
  have hamK : algebraMap (ResidueField h.carrier) K = h.ι := RingHom.algebraMap_toAlgebra h.ι
  set F : IntermediateField (ResidueField h.carrier) K :=
    IntermediateField.adjoin (ResidueField h.carrier) {α} with hFdef
  set g : F := IntermediateField.AdjoinSimple.gen (ResidueField h.carrier) α with hgdef
  have hst : IsScalarTower (ResidueField h.carrier) F K := inferInstance
  have hgen : IntermediateField.adjoin (ResidueField h.carrier) {g} = ⊤ := by
    have hli := IntermediateField.lift_adjoin (ResidueField h.carrier) F
      {IntermediateField.AdjoinSimple.gen (ResidueField h.carrier) α}
    simp only [Set.image_singleton, IntermediateField.AdjoinSimple.coe_gen] at hli
    have htop := IntermediateField.lift_top (ResidueField h.carrier) (E := K) F
    exact IntermediateField.lift_injective _ (hli.trans (hFdef ▸ htop.symm))
  have hmono : ∃ (A' : Type u) (_ : CommRing A') (_ : IsLocalRing A') (φ : h.carrier →+* A')
      (hφ : IsLocalHom φ),
      (let : Algebra h.carrier A' := φ.toAlgebra; Module.Flat h.carrier A') ∧
      (maximalIdeal A' = Ideal.map φ (maximalIdeal h.carrier)) ∧
      (∃ σ : ResidueField A' ≃+* F,
        (σ : ResidueField A' →+* F).comp (@ResidueField.map h.carrier A' _ _ _ _ φ hφ)
          = algebraMap (ResidueField h.carrier) F) := by
    by_cases htr : Transcendental (ResidueField h.carrier) g
    · exact exists_flat_localRing_residueField_of_transcendental h.carrier F g htr hgen
    · rw [Transcendental, not_not] at htr
      have hAA : Algebra.IsAlgebraic (ResidueField h.carrier) ↥(IntermediateField.adjoin
          (ResidueField h.carrier) {g}) :=
        IntermediateField.isAlgebraic_adjoin_simple (K := ResidueField h.carrier) (x := g)
            htr.isIntegral
      let e : ↥(IntermediateField.adjoin (ResidueField h.carrier) {g}) ≃ₐ[ResidueField h.carrier] F
          :=
        (IntermediateField.equivOfEq hgen).trans
          (IntermediateField.topEquiv (F := ResidueField h.carrier) (E := F))
      have : Algebra.IsAlgebraic (ResidueField h.carrier) F := e.isAlgebraic
      exact exists_flat_isLocalHom_residueField_equiv h.carrier F g hgen
  obtain ⟨A', crA', lrA', m, hm, mflat, mmaxeq, σ, hσ⟩ := hmono
  let ι' : ResidueField A' →+* K := (algebraMap F K).comp (σ : ResidueField A' →+* F)
  have hcompose :=
    flat_and_maximalIdeal_eq_map_comp R h.carrier A' h.φ m h.flat mflat h.maxeq mmaxeq
  have hι'm : ι'.comp (@ResidueField.map h.carrier A' _ _ _ _ m hm) = h.ι := by
    show ((algebraMap F K).comp (σ : ResidueField A' →+* F)).comp
      (@ResidueField.map h.carrier A' _ _ _ _ m hm) = h.ι
    rw [RingHom.comp_assoc, hσ, ← hamK]
    exact (IsScalarTower.algebraMap_eq (ResidueField h.carrier) F K).symm
  let h' : GoodLift R K :=
    { carrier := A'
      commRing := crA'
      isLocalRing := lrA'
      φ := m.comp h.φ
      hφ := RingHom.isLocalHom_comp m h.φ
      flat := hcompose.left
      maxeq := hcompose.right
      ι := ι'
      hι := by
        rw [IsLocalRing.ResidueField.map_comp h.φ m, ← RingHom.comp_assoc, hι'm]
        exact h.hι }
  refine ⟨h', m, hm, mflat, mmaxeq, rfl, hι'm, ?_⟩
  obtain ⟨z, hz⟩ := σ.surjective g
  refine ⟨z, ?_⟩
  show (algebraMap F K) (σ z) = α
  rw [hz, IntermediateField.algebraMap_apply, hgdef, IntermediateField.AdjoinSimple.coe_gen]

/-- Given a coherent directed system `(g, t)` of good lifts with flat transition maps and an
element `α : K`, there is a good lift `gNew` with legs `s i` such that `s j ∘ t i j = s i`,
each leg a morphism of good lifts, and `α` lies in the range of `gNew.ι`. -/
@[ega "0 10.3.1.4" "partial", sga "3 V 4.1.2" "partial"]
theorem goodLift_step_over {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {J : Type u} [Preorder J] [IsDirected J (· ≤ ·)] [Nonempty J]
    (g : J → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_local : ∀ i j (hij : i ≤ j), IsLocalHom (t i j hij))
    (ht_flat : ∀ i j (hij : i ≤ j),
        letI : Algebra (g i).carrier (g j).carrier := (t i j hij).toAlgebra
        Module.Flat (g i).carrier (g j).carrier)
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ)
    (ht_ι : ∀ i j (hij : i ≤ j),
        (g j).ι.comp (@ResidueField.map (g i).carrier (g j).carrier _ _ _ _
          (t i j hij) (ht_local i j hij)) = (g i).ι)
    (α : K) :
    ∃ (gNew : GoodLift R K) (s : ∀ i, (g i).carrier →+* gNew.carrier)
      (hs_local : ∀ i, IsLocalHom (s i)),
      (∀ i j (hij : i ≤ j), (s j).comp (t i j hij) = s i) ∧
      (∀ i, letI : Algebra (g i).carrier gNew.carrier := (s i).toAlgebra
        Module.Flat (g i).carrier gNew.carrier) ∧
      (∀ i, maximalIdeal gNew.carrier = Ideal.map (s i) (maximalIdeal (g i).carrier)) ∧
      (∀ i, (s i).comp (g i).φ = gNew.φ) ∧
      (∀ i, gNew.ι.comp (@ResidueField.map (g i).carrier gNew.carrier _ _ _ _
        (s i) (hs_local i)) = (g i).ι) ∧
      α ∈ Set.range gNew.ι := by
  classical
  obtain ⟨C, s', hs'_local, hs'_cocycle, hs'_flat, hs'_maxeq, hs'_φ, hs'_ι, _⟩ :=
    goodLift_colimit_chosen g t ht_id ht_comp ht_local ht_flat ht_φ ht_ι
  obtain ⟨gNew, m, hm, mflat, mmaxeq, mφ, mι, hcov⟩ := goodLift_monogenic_step C α
  have hcomp := fun i => flat_and_maximalIdeal_eq_map_comp (g i).carrier C.carrier gNew.carrier
    (s' i) m (hs'_flat i) mflat (hs'_maxeq i) mmaxeq
  refine ⟨gNew, fun i => m.comp (s' i),
    fun i => @RingHom.isLocalHom_comp _ _ _ _ _ _ m (s' i) hm (hs'_local i),
    ?_, ?_, ?_, ?_, ?_, hcov⟩
  · intro i j hij
    rw [RingHom.comp_assoc, hs'_cocycle i j hij]
  · exact fun i => (hcomp i).left
  · exact fun i => (hcomp i).right
  · intro i
    rw [RingHom.comp_assoc, hs'_φ i, mφ]
  · intro i
    rw [IsLocalRing.ResidueField.map_comp (s' i) m, ← RingHom.comp_assoc, mι, hs'_ι i]

/-- If `gι` is not surjective and `enum : I → K` is surjective, then some `enum i` is missing
from the range of `gι`. -/
theorem not_surj_exists_missing_index {K : Type u} [Field K]
    {I : Type u} (enum : I → K) (henum : Function.Surjective enum)
    {C : Type u} (gι : C → K) (hns : ¬ Function.Surjective gι) :
    ∃ i, enum i ∉ Set.range gι := by
  obtain ⟨a, ha⟩ := not_forall.mp hns
  obtain ⟨i, rfl⟩ := henum a
  exact ⟨i, ha⟩

/-- The trivial good lift: `R` itself, with structure map `RingHom.id R` and residue embedding
`algebraMap (ResidueField R) K`. -/
@[ega "0 10.3.1.4"]
noncomputable def goodLift_trivial
    (R : Type u) [CommRing R] [IsLocalRing R]
    (K : Type u) [Field K] [Algebra (ResidueField R) K] : GoodLift R K where
  carrier := R
  commRing := inferInstance
  isLocalRing := inferInstance
  φ := RingHom.id R
  hφ := ⟨fun _ h => h⟩
  flat := by
    let : Algebra R R := (RingHom.id R).toAlgebra
    have h : (RingHom.id R).toAlgebra = Algebra.id R :=
      Algebra.algebra_ext _ _ (fun r => rfl)
    rw [h]; infer_instance
  maxeq := by rw [Ideal.map_id]
  ι := algebraMap (ResidueField R) K
  hι := by rw [IsLocalRing.ResidueField.map_id, RingHom.comp_id]

/-- `goodLift_step_over` without the assumption that the index type is nonempty. -/
@[ega "0 10.3.1.4" "partial", sga "3 V 4.1.2" "partial"]
theorem goodLift_step_over_maybe_empty {R : Type u} [CommRing R] [IsLocalRing R]
    {K : Type u} [Field K] [Algebra (ResidueField R) K]
    {J : Type u} [Preorder J] [IsDirected J (· ≤ ·)]
    (g : J → GoodLift R K)
    (t : ∀ i j, i ≤ j → (g i).carrier →+* (g j).carrier)
    (ht_id : ∀ i, t i i (le_refl i) = RingHom.id (g i).carrier)
    (ht_comp : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k),
        (t j k hjk).comp (t i j hij) = t i k (le_trans hij hjk))
    (ht_local : ∀ i j (hij : i ≤ j), IsLocalHom (t i j hij))
    (ht_flat : ∀ i j (hij : i ≤ j),
        letI : Algebra (g i).carrier (g j).carrier := (t i j hij).toAlgebra
        Module.Flat (g i).carrier (g j).carrier)
    (ht_φ : ∀ i j (hij : i ≤ j), (t i j hij).comp (g i).φ = (g j).φ)
    (ht_ι : ∀ i j (hij : i ≤ j),
        (g j).ι.comp (@ResidueField.map (g i).carrier (g j).carrier _ _ _ _
          (t i j hij) (ht_local i j hij)) = (g i).ι)
    (α : K) :
    ∃ (gNew : GoodLift R K) (s : ∀ i, (g i).carrier →+* gNew.carrier)
      (hs_local : ∀ i, IsLocalHom (s i)),
      (∀ i j (hij : i ≤ j), (s j).comp (t i j hij) = s i) ∧
      (∀ i, letI : Algebra (g i).carrier gNew.carrier := (s i).toAlgebra
        Module.Flat (g i).carrier gNew.carrier) ∧
      (∀ i, maximalIdeal gNew.carrier = Ideal.map (s i) (maximalIdeal (g i).carrier)) ∧
      (∀ i, (s i).comp (g i).φ = gNew.φ) ∧
      (∀ i, gNew.ι.comp (@ResidueField.map (g i).carrier gNew.carrier _ _ _ _
        (s i) (hs_local i)) = (g i).ι) ∧
      α ∈ Set.range gNew.ι := by
  classical
  by_cases hJ : Nonempty J
  · let := hJ
    exact goodLift_step_over g t ht_id ht_comp ht_local ht_flat ht_φ ht_ι α
  · have : IsEmpty J := not_nonempty_iff.mp hJ
    obtain ⟨gNew, -, -, -, -, -, -, hcov⟩ := goodLift_monogenic_step (goodLift_trivial R K) α
    exact ⟨gNew, isEmptyElim, isEmptyElim, isEmptyElim, isEmptyElim, isEmptyElim, isEmptyElim,
      isEmptyElim, hcov⟩

/-!
### Free colimit of rings

A `FreeCommRing`/`RingQuot` model `FreeRingColim G f` of the colimit of a family of commutative
rings `G : ι → Type u` along arbitrary transition maps `f`. Its legs are compatible with the
transition maps for arbitrary `f` (`freeRingColimOf_comp`), and for a directed system over a
directed nonempty index it is isomorphic to `Ring.DirectLimit` (`freeRingColimEquivDirectLimit`).
-/

section FreeRingColim

variable {ι : Type u} [Preorder ι]
variable (G : ι → Type u) [∀ i, CommRing (G i)]
variable (f : ∀ i j, i ≤ j → G i →+* G j)

/-- The relation defining the free colimit of rings: ring-operation generators
identifying `of ⟨i, ·⟩` with the ring structure on `G i`, plus a `trans` generator
identifying `of ⟨i, x⟩` with `of ⟨j, f i j hij x⟩`. -/
inductive FreeRingColimRel : FreeCommRing (Σ i, G i) → FreeCommRing (Σ i, G i) → Prop
  | add (i : ι) (x y : G i) :
      FreeRingColimRel (FreeCommRing.of ⟨i, x + y⟩) (FreeCommRing.of ⟨i, x⟩ + FreeCommRing.of ⟨i,
          y⟩)
  | mul (i : ι) (x y : G i) :
      FreeRingColimRel (FreeCommRing.of ⟨i, x * y⟩) (FreeCommRing.of ⟨i, x⟩ * FreeCommRing.of ⟨i,
          y⟩)
  | one (i : ι) :
      FreeRingColimRel (FreeCommRing.of ⟨i, (1 : G i)⟩) 1
  | zero (i : ι) :
      FreeRingColimRel (FreeCommRing.of ⟨i, (0 : G i)⟩) 0
  | trans (i j : ι) (hij : i ≤ j) (x : G i) :
      FreeRingColimRel (FreeCommRing.of ⟨i, x⟩) (FreeCommRing.of ⟨j, f i j hij x⟩)

/-- The free colimit of the rings `G i` along the maps `f`. -/
abbrev FreeRingColim := RingQuot (FreeRingColimRel G f)

/-- The canonical leg `G i →+* FreeRingColim G f`. -/
noncomputable def freeRingColimOf (i : ι) : G i →+* FreeRingColim G f where
  toFun x := RingQuot.mkRingHom (FreeRingColimRel G f) (FreeCommRing.of ⟨i, x⟩)
  map_one' := by
    rw [← map_one (RingQuot.mkRingHom (FreeRingColimRel G f))]
    exact RingQuot.mkRingHom_rel (FreeRingColimRel.one i)
  map_mul' x y := by
    rw [← map_mul (RingQuot.mkRingHom (FreeRingColimRel G f))]
    exact RingQuot.mkRingHom_rel (FreeRingColimRel.mul i x y)
  map_zero' := by
    rw [← map_zero (RingQuot.mkRingHom (FreeRingColimRel G f))]
    exact RingQuot.mkRingHom_rel (FreeRingColimRel.zero i)
  map_add' x y := by
    rw [← map_add (RingQuot.mkRingHom (FreeRingColimRel G f))]
    exact RingQuot.mkRingHom_rel (FreeRingColimRel.add i x y)

/-- The legs of the free colimit are compatible with the transition maps. -/
theorem freeRingColimOf_comp (i j : ι) (hij : i ≤ j) :
    (freeRingColimOf G f j).comp (f i j hij) = freeRingColimOf G f i := by
  ext x
  simp only [RingHom.comp_apply, freeRingColimOf, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
  exact (RingQuot.mkRingHom_rel (FreeRingColimRel.trans i j hij x)).symm

/-- The universal map out of the free colimit from a compatible family `P`. -/
noncomputable def freeRingColimLift {S : Type u} [CommRing S] (P : ∀ i, G i →+* S)
    (hP : ∀ i j (hij : i ≤ j), (P j).comp (f i j hij) = P i) : FreeRingColim G f →+* S := by
  refine RingQuot.lift ⟨FreeCommRing.lift (fun s : Σ i, G i => P s.fst s.snd), ?_⟩
  intro a b hab
  induction hab with
  | add i x y => simp [map_add]
  | mul i x y => simp [map_mul]
  | one i => simp
  | zero i => simp
  | trans i j hij x =>
      simp only [FreeCommRing.lift_of]
      exact (congrFun (congrArg _ (hP i j hij)) x).symm

/-- Computation rule for `freeRingColimLift` against the legs. -/
theorem freeRingColimLift_of {S : Type u} [CommRing S] (P : ∀ i, G i →+* S)
    (hP : ∀ i j (hij : i ≤ j), (P j).comp (f i j hij) = P i) (i : ι) :
    (freeRingColimLift G f P hP).comp (freeRingColimOf G f i) = P i := by
  ext x
  simp only [RingHom.comp_apply, freeRingColimOf, freeRingColimLift, RingHom.coe_mk,
      MonoidHom.coe_mk, OneHom.coe_mk]
  rw [RingQuot.lift_mkRingHom_apply]
  simp [FreeCommRing.lift_of]

/-- Pointwise computation rule for `freeRingColimLift` against the legs. -/
theorem freeRingColimLift_apply_of {S : Type u} [CommRing S] (P : ∀ i, G i →+* S)
    (hP : ∀ i j (hij : i ≤ j), (P j).comp (f i j hij) = P i) (i : ι) (x : G i) :
    freeRingColimLift G f P hP (freeRingColimOf G f i x) = P i x :=
  congrFun (congrArg DFunLike.coe (freeRingColimLift_of G f P hP i)) x

/-- A leg followed by a transition equals the lower leg, applied to an element
(the pointwise form of `freeRingColimOf_comp`). -/
theorem freeRingColimOf_apply_eq (i j : ι) (hij : i ≤ j) (x : G i) :
    freeRingColimOf G f j (f i j hij x) = freeRingColimOf G f i x := by
  have := freeRingColimOf_comp G f i j hij
  exact congrFun (congrArg (DFunLike.coe) this) x

/-- The leg is, by definition, the quotient map applied to the generator. -/
theorem freeRingColimOf_eq_mk (i : ι) (x : G i) :
    freeRingColimOf G f i x = RingQuot.mkRingHom (FreeRingColimRel G f) (FreeCommRing.of ⟨i, x⟩) :=
        rfl

/-- When the index is directed and nonempty, every element of the free colimit comes from a
single stage. -/
theorem freeRingColimOf_exhaustive [IsDirected ι (· ≤ ·)] [Nonempty ι]
    (z : FreeRingColim G f) : ∃ (i : ι) (x : G i), freeRingColimOf G f i x = z := by
  obtain ⟨w, rfl⟩ := RingQuot.mkRingHom_surjective (FreeRingColimRel G f) z
  induction w using FreeCommRing.induction_on with
  | neg_one =>
      obtain ⟨i⟩ := (inferInstance : Nonempty ι)
      exact ⟨i, -1, by rw [map_neg, map_neg, map_one, map_one]⟩
  | of b =>
      exact ⟨b.fst, b.snd, rfl⟩
  | add x y hx hy =>
      obtain ⟨i, a, ha⟩ := hx
      obtain ⟨j, b, hb⟩ := hy
      obtain ⟨k, hik, hjk⟩ := directed_of (· ≤ ·) i j
      refine ⟨k, f i k hik a + f j k hjk b, ?_⟩
      rw [map_add, freeRingColimOf_apply_eq, freeRingColimOf_apply_eq, ha, hb, ← map_add]
  | mul x y hx hy =>
      obtain ⟨i, a, ha⟩ := hx
      obtain ⟨j, b, hb⟩ := hy
      obtain ⟨k, hik, hjk⟩ := directed_of (· ≤ ·) i j
      refine ⟨k, f i k hik a * f j k hjk b, ?_⟩
      rw [map_mul, freeRingColimOf_apply_eq, freeRingColimOf_apply_eq, ha, hb, ← map_mul]

/-- For a directed system over a directed nonempty index, the free colimit is isomorphic to
`Ring.DirectLimit`, the isomorphism identifying the legs `freeRingColimOf i` with
`Ring.DirectLimit.of i`. -/
noncomputable def freeRingColimEquivDirectLimit [IsDirected ι (· ≤ ·)] [Nonempty ι]
    [DirectedSystem G (fun i j h => (f i j h : G i → G j))] :
    FreeRingColim G f ≃+* Ring.DirectLimit G (fun i j h => (f i j h : G i → G j)) := by
  have hfwd : ∀ i j (hij : i ≤ j),
      (Ring.DirectLimit.of G (fun i j h => (f i j h : G i → G j)) j).comp (f i j hij)
        = Ring.DirectLimit.of G (fun i j h => (f i j h : G i → G j)) i := by
    intro i j hij; ext x; simp only [RingHom.comp_apply]; exact Ring.DirectLimit.of_f hij x
  have hbwd : ∀ i j (hij : i ≤ j) (x : G i),
      freeRingColimOf G f j ((f i j hij : G i → G j) x) = freeRingColimOf G f i x := by
    intro i j hij x; exact freeRingColimOf_apply_eq G f i j hij x
  refine RingEquiv.ofRingHom
    (freeRingColimLift G f
      (fun i => Ring.DirectLimit.of G (fun i j h => (f i j h : G i → G j)) i) hfwd)
    (Ring.DirectLimit.lift G (fun i j h => (f i j h : G i → G j)) (FreeRingColim G f)
      (fun i => freeRingColimOf G f i) hbwd)
    ?_ ?_
  · ext z x
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [Ring.DirectLimit.lift_of, freeRingColimLift_apply_of]
  · ext z
    simp only [RingHom.comp_apply, RingHom.id_apply]
    change Ring.DirectLimit.lift G (fun i j h => (f i j h : G i → G j)) (FreeRingColim G f)
        (fun i => freeRingColimOf G f i) hbwd
        (freeRingColimLift G f
          (fun i => Ring.DirectLimit.of G (fun i j h => (f i j h : G i → G j)) i) hfwd
          (freeRingColimOf G f z.fst z.snd)) = freeRingColimOf G f z.fst z.snd
    rw [freeRingColimLift_apply_of, Ring.DirectLimit.lift_of]

end FreeRingColim
