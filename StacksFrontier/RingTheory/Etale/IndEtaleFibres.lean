/-!
# Fibres of ind-étale algebras

Let `A` be a commutative ring, let `B` be an `A`-algebra which is a filtered colimit of étale
`A`-algebras and a Noetherian ring, and let `p ⊆ A` be a prime ideal. Then there are finitely many
primes `q₁, …, q_r` of `B`, exactly the primes of `B` lying over `p`, such that
`B ⊗_A κ(p) ≅ ∏ᵢ κ(qᵢ)` as `κ(p)`-algebras and each extension `κ(qᵢ)/κ(p)` is separable algebraic
(Stacks 0AH1).

## Main definitions

* `IsFilteredColimitEtale`: `B` is a filtered colimit of étale `A`-algebras.

## Main results

* `IsFilteredColimitEtale.baseChange`: a base change of a filtered colimit of étale algebras is a
  filtered colimit of étale algebras.
* `IsFilteredColimitEtale.isReduced`, `IsFilteredColimitEtale.krullDimLE_zero`: a filtered colimit
  of étale algebras over a field is reduced, of Krull dimension zero.
* `IsFilteredColimitEtale.isSeparable_quotient`, `IsFilteredColimitEtale.isAlgebraic_quotient`: its
  residue fields are separable algebraic over the field.
* `IsFilteredColimitEtale.exists_fiber_algEquiv_pi_residueField`: the decomposition of the fibre
  `B ⊗_A κ(p)` above.

## Implementation notes

* The residue field `κ(p)` of a prime `p` is `Ideal.ResidueField p`; for a prime `q` of `B` lying
  over `p`, the map `κ(p) → κ(q)` is `Ideal.ResidueField.map`. The fibre `B ⊗_A κ(p)` is
  `TensorProduct A (Ideal.ResidueField p) B`, and "separable algebraic" is `Algebra.IsSeparable`
  together with `Algebra.IsAlgebraic`.
* A filtered colimit of `A`-algebras is encoded by its universal property: the transition maps and
  the cocone maps are `A`-algebra homomorphisms, the index preorder is nonempty and directed, and
  the cocone is compatible with the transition maps, jointly surjective and injective in the limit.
* In `IsFilteredColimitEtale.{u, v, x, y} A B` the four universe levels are independent. Base
  change along `A → K` with `K : Type w` raises the level of the carriers from `y` to `max w y` and
  leaves the index level `x` unchanged, so tying `x` to `y` (or either to `v`) would make
  `IsFilteredColimitEtale.baseChange` unstatable without reindexing the system through `ULift`.
-/

open TensorProduct

universe u v w x y

/-! ## Main definitions -/

/-- `B` is a *filtered colimit of étale `A`-algebras*: there is a nonempty directed
index type `ι`, a directed system `G` of `A`-algebras each of which is étale over
`A`, with `A`-algebra transition maps `f : G i →ₐ[A] G j` for `i ≤ j`, together with
`A`-algebra cocone maps `g i : G i →ₐ[A] B` such that `(B, g)` is the colimit of the
system `(G, f)`.

The colimit (universal) property is expressed concretely by three conditions:

* `g` is a cocone: `g j ∘ f i j h = g i`;
* `g` is jointly surjective: every `b : B` is `g i x` for some `i` and `x : G i`;
* `g` is injective in the limit: `g i x = g i y` implies `f i j h x = f i j h y`
  for some `j ≥ i`.

Together these say exactly that the canonical `A`-algebra map
`colim_i (G i) → B` is an isomorphism. All maps are honest `A`-algebra
homomorphisms, and `ι` is required to be nonempty (so the system is genuinely
filtered). -/
def IsFilteredColimitEtale (A : Type u) [CommRing A]
    (B : Type v) [CommRing B] [Algebra A B] : Prop :=
  ∃ (ι : Type x) (_ : Preorder ι) (_ : Nonempty ι) (_ : IsDirected ι (· ≤ ·))
    (G : ι → Type y) (_ : (i : ι) → CommRing (G i)) (_ : (i : ι) → Algebra A (G i)),
    (∀ i, Algebra.Etale A (G i)) ∧
    ∃ (f : (i j : ι) → i ≤ j → (G i →ₐ[A] G j))
      (_ : DirectedSystem G (fun i j h => (f i j h : G i → G j)))
      (g : (i : ι) → (G i →ₐ[A] B)),
      -- `g` is a cocone over the directed system `(G, f)`:
      (∀ i j (h : i ≤ j) (x : G i), g j (f i j h x) = g i x) ∧
      -- `g` is jointly surjective (colimit is generated by the `G i`):
      (∀ b : B, ∃ i, ∃ x : G i, g i x = b) ∧
      -- `g` is injective in the limit (no relations beyond those in the system):
      (∀ i (x y : G i), g i x = g i y → ∃ j, ∃ h : i ≤ j, f i j h x = f i j h y)

section BaseChange

variable {A : Type*} (K : Type*) [CommRing A] [CommRing K] [Algebra A K]

/-- Base change along `A → K` preserves a factorization `φ ∘ ψ = χ` of `A`-algebra maps. -/
theorem Algebra.TensorProduct.map_map_apply {B C D : Type*} [CommRing B] [CommRing C] [CommRing D]
    [Algebra A B] [Algebra A C] [Algebra A D] {φ : C →ₐ[A] D} {ψ : B →ₐ[A] C} {χ : B →ₐ[A] D}
    (h : ∀ x, φ (ψ x) = χ x) (y : K ⊗[A] B) :
    Algebra.TensorProduct.map (AlgHom.id K K) φ (Algebra.TensorProduct.map (AlgHom.id K K) ψ y) =
      Algebra.TensorProduct.map (AlgHom.id K K) χ y := by
  have hc : φ.comp ψ = χ := AlgHom.ext h
  rw [← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, AlgHom.comp_id, hc]

variable {ι : Type*} [Preorder ι] {G : ι → Type*} [∀ i, CommRing (G i)] [∀ i, Algebra A (G i)]
  (f : (i j : ι) → i ≤ j → (G i →ₐ[A] G j))

/-- Base change along `A → K` of a directed system of `A`-algebras is a directed system. -/
theorem Algebra.TensorProduct.directedSystem_baseChange
    (hds : DirectedSystem G (fun i j h => (f i j h : G i → G j))) :
    DirectedSystem (fun i => K ⊗[A] G i) (fun i j h =>
      (Algebra.TensorProduct.map (AlgHom.id K K) (f i j h) : K ⊗[A] G i → K ⊗[A] G j)) where
  map_self := @fun i x => by
    rw [show f i i le_rfl = AlgHom.id A (G i) from AlgHom.ext fun w => hds.map_self w,
      Algebra.TensorProduct.map_id]
    rfl
  map_map := @fun _ _ _ hij hjk x =>
    Algebra.TensorProduct.map_map_apply K (fun w => hds.map_map hij hjk w) x

variable [IsDirectedOrder ι] [Nonempty ι]

/-- A jointly surjective cocone of algebras which is injective in the limit identifies its
vertex with the direct limit. -/
theorem Ring.DirectLimit.exists_ringEquiv {B : Type*} [CommRing B] [Algebra A B]
    (g : (i : ι) → (G i →ₐ[A] B))
    (hcocone : ∀ i j (h : i ≤ j) (x : G i), g j (f i j h x) = g i x)
    (hsurj : ∀ b : B, ∃ i, ∃ x : G i, g i x = b)
    (hinj : ∀ i (x y : G i), g i x = g i y → ∃ j, ∃ h : i ≤ j, f i j h x = f i j h y) :
    ∃ e : B ≃+* Ring.DirectLimit G (fun i j h => ((f i j h : G i →+* G j) : G i → G j)),
      ∀ i w, e (g i w) = Ring.DirectLimit.of G _ i w := by
  set Lift := Ring.DirectLimit.lift G (fun i j h => ((f i j h : G i →+* G j) : G i → G j)) B
    (fun i => (g i : G i →+* B)) (fun i j h x => hcocone i j h x) with hLift
  have hLsurj : Function.Surjective Lift := fun b => by
    obtain ⟨i, x, hx⟩ := hsurj b
    exact ⟨Ring.DirectLimit.of G _ i x, by rw [hLift, Ring.DirectLimit.lift_of]; exact hx⟩
  have hLinj : Function.Injective Lift := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨i, x, rfl⟩ := Ring.DirectLimit.exists_of z
    rw [hLift, Ring.DirectLimit.lift_of] at hz
    obtain ⟨j, h, hfj⟩ := hinj i x 0 (by rw [map_zero]; exact hz)
    rw [map_zero] at hfj
    rw [← Ring.DirectLimit.of_f (f := fun i j h => ((f i j h : G i →+* G j) : G i → G j)) h]
    show Ring.DirectLimit.of G _ j (f i j h x) = 0
    rw [hfj, map_zero]
  refine ⟨(RingEquiv.ofBijective Lift ⟨hLinj, hLsurj⟩).symm, fun i w => ?_⟩
  rw [RingEquiv.symm_apply_eq]
  show g i w = Lift (Ring.DirectLimit.of G _ i w)
  rw [hLift, Ring.DirectLimit.lift_of]
  rfl

/-- The algebra maps `K → K ⊗[A] G i` assemble into a ring map `K → colimᵢ (K ⊗[A] G i)`. -/
theorem Ring.DirectLimit.exists_ringHom_baseChange_left :
    ∃ φ : K →+* Ring.DirectLimit (fun i => K ⊗[A] G i) (fun i j h =>
        ((Algebra.TensorProduct.map (AlgHom.id K K) (f i j h) : K ⊗[A] G i →+* K ⊗[A] G j) :
          K ⊗[A] G i → K ⊗[A] G j)),
      ∀ i a, φ a = Ring.DirectLimit.of _ _ i (algebraMap K (K ⊗[A] G i) a) := by
  obtain ⟨ip⟩ := (inferInstance : Nonempty ι)
  refine ⟨(Ring.DirectLimit.of _ _ ip).comp (algebraMap K _), fun i a => ?_⟩
  obtain ⟨k, hik, hjk⟩ := directed_of (· ≤ ·) ip i
  show Ring.DirectLimit.of _ _ ip (algebraMap K _ a) = _
  rw [← Ring.DirectLimit.of_f hik, ← Ring.DirectLimit.of_f hjk]
  congr 1
  exact ((Algebra.TensorProduct.map (AlgHom.id K K) (f ip k hik)).commutes a).trans
    ((Algebra.TensorProduct.map (AlgHom.id K K) (f i k hjk)).commutes a).symm

omit [IsDirectedOrder ι] [Nonempty ι] in
/-- An identification `B ≃ colimᵢ G i` yields a ring map `B → colimᵢ (K ⊗[A] G i)`. -/
theorem Ring.DirectLimit.exists_ringHom_baseChange_right {B : Type*} [CommRing B] [Algebra A B]
    (g : (i : ι) → (G i →ₐ[A] B))
    (e : B ≃+* Ring.DirectLimit G (fun i j h => ((f i j h : G i →+* G j) : G i → G j)))
    (he : ∀ i w, e (g i w) = Ring.DirectLimit.of G _ i w) :
    ∃ φ : B →+* Ring.DirectLimit (fun i => K ⊗[A] G i) (fun i j h =>
        ((Algebra.TensorProduct.map (AlgHom.id K K) (f i j h) : K ⊗[A] G i →+* K ⊗[A] G j) :
          K ⊗[A] G i → K ⊗[A] G j)),
      ∀ i w, φ (g i w) = Ring.DirectLimit.of _ _ i ((1 : K) ⊗ₜ[A] w) := by
  refine ⟨(Ring.DirectLimit.map (fun i => ((Algebra.TensorProduct.includeRight :
    G i →ₐ[A] K ⊗[A] G i) : G i →+* K ⊗[A] G i)) fun i j h => ?_).comp e.toRingHom,
    fun i w => ?_⟩
  · ext w
    show (Algebra.TensorProduct.includeRight : G j →ₐ[A] K ⊗[A] G j) (f i j h w)
        = Algebra.TensorProduct.map (AlgHom.id K K) (f i j h)
            ((Algebra.TensorProduct.includeRight : G i →ₐ[A] K ⊗[A] G i) w)
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.map_tmul]
    rfl
  · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, he,
      Ring.DirectLimit.map_apply_of]
    rfl

/-- An identification `B ≃ colimᵢ G i` yields a ring map `K ⊗[A] B → colimᵢ (K ⊗[A] G i)`
compatible with the base-changed cocone maps. -/
theorem Ring.DirectLimit.exists_ringHom_tensorProduct {B : Type*} [CommRing B] [Algebra A B]
    (g : (i : ι) → (G i →ₐ[A] B))
    (e : B ≃+* Ring.DirectLimit G (fun i j h => ((f i j h : G i →+* G j) : G i → G j)))
    (he : ∀ i w, e (g i w) = Ring.DirectLimit.of G _ i w) :
    ∃ Ψ : K ⊗[A] B →+* Ring.DirectLimit (fun i => K ⊗[A] G i) (fun i j h =>
        ((Algebra.TensorProduct.map (AlgHom.id K K) (f i j h) : K ⊗[A] G i →+* K ⊗[A] G j) :
          K ⊗[A] G i → K ⊗[A] G j)),
      ∀ i x, Ψ (Algebra.TensorProduct.map (AlgHom.id K K) (g i) x) =
        Ring.DirectLimit.of _ _ i x := by
  set L := Ring.DirectLimit (fun i => K ⊗[A] G i) (fun i j h =>
    ((Algebra.TensorProduct.map (AlgHom.id K K) (f i j h) : K ⊗[A] G i →+* K ⊗[A] G j) :
      K ⊗[A] G i → K ⊗[A] G j))
  obtain ⟨fKr, hfKr⟩ := Ring.DirectLimit.exists_ringHom_baseChange_left K f
  obtain ⟨fBr, hfBr⟩ := Ring.DirectLimit.exists_ringHom_baseChange_right K f g e he
  obtain ⟨ip⟩ := (inferInstance : Nonempty ι)
  let : Algebra A L :=
    ((Ring.DirectLimit.of _ _ ip).comp (algebraMap A (K ⊗[A] G ip))).toAlgebra
  have halgL : ∀ a : A,
      algebraMap A L a = Ring.DirectLimit.of _ _ ip (algebraMap A (K ⊗[A] G ip) a) :=
    fun _ => rfl
  let fK : K →ₐ[A] L := { fKr with
    commutes' := fun a => by
      show fKr (algebraMap A K a) = algebraMap A L a
      rw [hfKr ip, halgL, ← IsScalarTower.algebraMap_apply] }
  let fB : B →ₐ[A] L := { fBr with
    commutes' := fun a => by
      show fBr (algebraMap A B a) = algebraMap A L a
      rw [← (g ip).commutes a, hfBr ip, halgL]
      congr 1
      rw [← Algebra.TensorProduct.includeRight_apply, AlgHom.commutes] }
  let Ψ : K ⊗[A] B →ₐ[A] L := Algebra.TensorProduct.lift fK fB fun _ _ => mul_comm _ _
  have key : ∀ i (x : K ⊗[A] G i),
      Ψ (Algebra.TensorProduct.map (AlgHom.id K K) (g i) x) = Ring.DirectLimit.of _ _ i x := by
    intro i x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero]
    | tmul a w =>
        rw [Algebra.TensorProduct.map_tmul]
        show Algebra.TensorProduct.lift fK fB _ ((AlgHom.id K K a) ⊗ₜ[A] (g i w)) = _
        rw [Algebra.TensorProduct.lift_tmul]
        show fKr a * fBr (g i w) = _
        rw [hfKr i a, hfBr i w, ← map_mul]
        congr 1
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul]
        simp
    | add x₁ x₂ ih₁ ih₂ => simp only [map_add, ih₁, ih₂]
  exact ⟨Ψ.toRingHom, key⟩

/-- The canonical map `colimᵢ (K ⊗[A] G i) → K ⊗[A] B` induced by a presentation of `B`
as a direct limit of the `G i` is injective. -/
theorem Ring.DirectLimit.lift_baseChange_injective {B : Type*} [CommRing B] [Algebra A B]
    (g : (i : ι) → (G i →ₐ[A] B))
    (hcocone : ∀ i j (h : i ≤ j) (x : G i), g j (f i j h x) = g i x)
    (e : B ≃+* Ring.DirectLimit G (fun i j h => ((f i j h : G i →+* G j) : G i → G j)))
    (he : ∀ i w, e (g i w) = Ring.DirectLimit.of G _ i w) :
    Function.Injective (Ring.DirectLimit.lift (fun i => K ⊗[A] G i) (fun i j h =>
        ((Algebra.TensorProduct.map (AlgHom.id K K) (f i j h) : K ⊗[A] G i →+* K ⊗[A] G j) :
          K ⊗[A] G i → K ⊗[A] G j)) (K ⊗[A] B)
      (fun i => (Algebra.TensorProduct.map (AlgHom.id K K) (g i) : K ⊗[A] G i →+* K ⊗[A] B))
      (fun i j h x => Algebra.TensorProduct.map_map_apply K (hcocone i j h) x)) := by
  obtain ⟨Ψ, hΨ⟩ := Ring.DirectLimit.exists_ringHom_tensorProduct K f g e he
  refine Function.LeftInverse.injective (g := Ψ) fun z => ?_
  induction z using Ring.DirectLimit.induction_on with
  | _ i x =>
    rw [Ring.DirectLimit.lift_of]
    exact hΨ i x

end BaseChange

/-! ## Base change of an ind-étale algebra -/

/-- Base change of a filtered colimit of étale `A`-algebras along any `A`-algebra `K` is again a
filtered colimit of étale `K`-algebras. -/
theorem IsFilteredColimitEtale.baseChange {A : Type u} {B : Type v} (K : Type w) [CommRing A]
    [CommRing B] [Algebra A B] [CommRing K] [Algebra A K]
    (hcolim : IsFilteredColimitEtale.{u, v, x, y} A B) :
    IsFilteredColimitEtale.{w, max w v, x, max w y} K (K ⊗[A] B) := by
  obtain ⟨ι, _, _, _, G, _, _, hEt, f, hds, g, hcocone, hsurj, hinj⟩ := hcolim
  have : IsDirectedOrder ι := ⟨fun i j => IsDirected.directed i j⟩
  obtain ⟨e, he⟩ := Ring.DirectLimit.exists_ringEquiv f g hcocone hsurj hinj
  refine ⟨ι, inferInstance, inferInstance, inferInstance, fun i => K ⊗[A] G i,
    inferInstance, inferInstance, fun i => have := hEt i; Algebra.Etale.baseChange A (G i) K,
    fun i j h => Algebra.TensorProduct.map (AlgHom.id K K) (f i j h),
    Algebra.TensorProduct.directedSystem_baseChange K f hds,
    fun i => Algebra.TensorProduct.map (AlgHom.id K K) (g i),
    fun i j h x => Algebra.TensorProduct.map_map_apply K (hcocone i j h) x, fun c => ?_,
    fun i₀ x₁ x₂ hx => ?_⟩
  · induction c using TensorProduct.induction_on with
    | zero =>
        obtain ⟨i₀⟩ := (inferInstance : Nonempty ι)
        exact ⟨i₀, 0, by rw [map_zero]⟩
    | tmul a b =>
        obtain ⟨i, x, hx⟩ := hsurj b
        exact ⟨i, a ⊗ₜ[A] x, by rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hx]⟩
    | add c₁ c₂ ih₁ ih₂ =>
        obtain ⟨i₁, x₁, hx₁⟩ := ih₁
        obtain ⟨i₂, x₂, hx₂⟩ := ih₂
        obtain ⟨j, hj₁, hj₂⟩ := directed_of (· ≤ ·) i₁ i₂
        refine ⟨j, Algebra.TensorProduct.map (AlgHom.id K K) (f i₁ j hj₁) x₁
          + Algebra.TensorProduct.map (AlgHom.id K K) (f i₂ j hj₂) x₂, ?_⟩
        rw [map_add, Algebra.TensorProduct.map_map_apply K (hcocone i₁ j hj₁),
          Algebra.TensorProduct.map_map_apply K (hcocone i₂ j hj₂), hx₁, hx₂]
  · let F : (i j : ι) → i ≤ j → (K ⊗[A] G i →+* K ⊗[A] G j) := fun i j h =>
      (Algebra.TensorProduct.map (AlgHom.id K K) (f i j h) : K ⊗[A] G i →+* K ⊗[A] G j)
    have : DirectedSystem (fun i => K ⊗[A] G i) (fun i j h => (F i j h : _ → _)) :=
      Algebra.TensorProduct.directedSystem_baseChange K f hds
    have hofeq : Ring.DirectLimit.of (fun i => K ⊗[A] G i) (fun i j h => (F i j h : _ → _)) i₀ x₁ =
        Ring.DirectLimit.of (fun i => K ⊗[A] G i) (fun i j h => (F i j h : _ → _)) i₀ x₂ :=
      Ring.DirectLimit.lift_baseChange_injective K f g hcocone e he
        (by rw [Ring.DirectLimit.lift_of, Ring.DirectLimit.lift_of]; exact hx)
    obtain ⟨j, hj, hfj⟩ := Ring.DirectLimit.of.zero_exact (f' := F)
      (show Ring.DirectLimit.of (fun i => K ⊗[A] G i) (fun i j h => (F i j h : _ → _)) i₀
        (x₁ - x₂) = 0 by rw [map_sub, hofeq, sub_self])
    refine ⟨j, hj, ?_⟩
    have hsub : F i₀ j hj (x₁ - x₂) = 0 := hfj
    rwa [map_sub, sub_eq_zero] at hsub

/-! ## Ind-étale algebras over a field -/

/-- A filtered colimit `C` of étale `K`-algebras over a field `K` is reduced. -/
@[ega "IV 5.13.2" "special case"]
theorem IsFilteredColimitEtale.isReduced {K : Type u} {C : Type v} [Field K] [CommRing C]
    [Algebra K C] (hC : IsFilteredColimitEtale.{u, v, x, y} K C) :
    IsReduced C := by
  obtain ⟨ι, _, _, _, G, _, _, hEt, f, _, g, hcocone, hsurj, hinj⟩ := hC
  refine ⟨fun x ⟨n, hn⟩ => ?_⟩
  obtain ⟨i, y, hy⟩ := hsurj x
  obtain ⟨j, h, hfj⟩ := hinj i (y ^ n) 0 (by rw [map_pow, hy, hn, map_zero])
  rw [map_pow, map_zero] at hfj
  have : IsReduced (G j) := by
    have := hEt j
    exact Algebra.FormallyUnramified.isReduced_of_field K (G j)
  rw [← hy, ← hcocone i j h y, IsReduced.eq_zero _ ⟨n, hfj⟩, map_zero]

/-- In a filtered colimit `C` of étale `K`-algebras over a field `K`, every prime ideal is maximal
(`Ring.KrullDimLE 0 C`). -/
@[ega "0 16.1.5" "special case"]
theorem IsFilteredColimitEtale.krullDimLE_zero {K : Type u} {C : Type v} [Field K] [CommRing C]
    [Algebra K C] (hC : IsFilteredColimitEtale.{u, v, x, y} K C) :
    Ring.KrullDimLE 0 C := by
  have hCint : Algebra.IsIntegral K C := by
    obtain ⟨ι, _, _, _, G, _, _, hEt, f, _, g, _, hsurj, _⟩ := hC
    refine ⟨fun c => ?_⟩
    obtain ⟨i, y, hy⟩ := hsurj c
    have := hEt i
    have := Algebra.FormallyUnramified.finite_of_free K (G i)
    have : Algebra.IsIntegral K (G i) := Algebra.IsIntegral.of_finite K _
    rw [← hy]
    exact (Algebra.IsIntegral.isIntegral y).map (g i)
  rw [Ring.krullDimLE_zero_iff]
  intro I hI
  have hQint : Algebra.IsIntegral K (C ⧸ I) := by
    refine ⟨fun x => ?_⟩
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact (Algebra.IsIntegral.isIntegral c).map (Ideal.Quotient.mkₐ K I)
  exact Ideal.Quotient.maximal_of_isField I (isField_of_isIntegral_of_isField' (Field.toIsField K))

/-- A finite product of separable field extensions of `K` is separable over `K`. -/
theorem Algebra.IsSeparable.pi {K : Type*} [Field K] {I : Type*} [Finite I] {Ai : I → Type*}
    [∀ i, Field (Ai i)] [∀ i, Algebra K (Ai i)] [∀ i, Algebra.IsSeparable K (Ai i)] :
    Algebra.IsSeparable K (∀ i, Ai i) := by
  refine ⟨fun z => ?_⟩
  classical
  cases nonempty_fintype I
  have hsep : ∀ i, (minpoly K (z i)).Separable := fun i =>
    Algebra.IsSeparable.isSeparable K (z i)
  have hint : ∀ i, IsIntegral K (z i) := fun i =>
    _root_.IsSeparable.isIntegral (Algebra.IsSeparable.isSeparable K (z i))
  set S : Finset (Polynomial K) := Finset.univ.image (fun i => minpoly K (z i)) with hS
  set P : Polynomial K := ∏ p ∈ S, p with hP
  have hPsep : P.Separable := by
    rw [hP]
    apply Polynomial.separable_prod'
    · intro p hp q hq hpq
      simp only [hS, Finset.mem_image, Finset.mem_univ, true_and] at hp hq
      obtain ⟨i, rfl⟩ := hp
      obtain ⟨j, rfl⟩ := hq
      rw [Irreducible.coprime_iff_not_dvd (minpoly.irreducible (hint i))]
      intro hdvd
      have hassoc : Associated (minpoly K (z i)) (minpoly K (z j)) :=
        (minpoly.irreducible (hint i)).associated_of_dvd (minpoly.irreducible (hint j)) hdvd
      exact hpq (Polynomial.eq_of_monic_of_associated (minpoly.monic (hint i))
        (minpoly.monic (hint j)) hassoc)
    · intro p hp
      simp only [hS, Finset.mem_image, Finset.mem_univ, true_and] at hp
      obtain ⟨i, rfl⟩ := hp
      exact hsep i
  have haeval : (Polynomial.aeval z) P = 0 := by
    rw [funext_iff]
    intro i
    have key : (Polynomial.aeval z P) i = Polynomial.aeval (z i) P := by
      simpa using (Polynomial.aeval_algHom_apply (Pi.evalAlgHom K Ai i) z P).symm
    have hmem : minpoly K (z i) ∈ S := by
      rw [hS]; exact Finset.mem_image_of_mem _ (Finset.mem_univ i)
    rw [show (0 : ∀ i, Ai i) i = (0 : Ai i) from rfl, key, hP, map_prod]
    exact Finset.prod_eq_zero hmem (by rw [minpoly.aeval])
  exact hPsep.of_dvd (minpoly.dvd K z haeval)

/-- For a filtered colimit `C` of étale `K`-algebras over a field `K` and a maximal ideal `m` of
`C`, the residue field `C ⧸ m` is a separable extension of `K`. -/
theorem IsFilteredColimitEtale.isSeparable_quotient {K : Type u} {C : Type v} [Field K] [CommRing C]
    [Algebra K C] (hC : IsFilteredColimitEtale.{u, v, x, y} K C) (m : Ideal C) [m.IsMaximal] :
    Algebra.IsSeparable K (C ⧸ m) := by
  obtain ⟨ι, _, _, _, G, _, _, hEt, f, _, g, _, hsurj, _⟩ := hC
  rw [Algebra.isSeparable_def]
  intro x
  obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨i, y, hy⟩ := hsurj c
  have : Algebra.IsSeparable K (G i) := by
    obtain ⟨I, _, Ai, _, _, e, hAi⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K (G i)).mp (hEt i)
    choose _ hsepAi using hAi
    exact (AlgEquiv.Algebra.isSeparable_iff e.symm).mp Algebra.IsSeparable.pi
  rw [← hc, ← hy, ← Ideal.Quotient.mkₐ_eq_mk K, ← AlgHom.comp_apply]
  exact (Algebra.IsSeparable.isSeparable K y).of_dvd
    (minpoly.dvd K _ (by rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]))

/-- For a filtered colimit `C` of étale `K`-algebras over a field `K` and a maximal ideal `m` of
`C`, the residue field `C ⧸ m` is algebraic over `K`. -/
theorem IsFilteredColimitEtale.isAlgebraic_quotient {K : Type u} {C : Type v} [Field K] [CommRing C]
    [Algebra K C] (hC : IsFilteredColimitEtale.{u, v, x, y} K C) (m : Ideal C) [m.IsMaximal] :
    Algebra.IsAlgebraic K (C ⧸ m) := by
  have := hC.isSeparable_quotient m
  exact Algebra.IsSeparable.isAlgebraic K (C ⧸ m)

/-- A subring of a field which is itself a field is closed under inverses. -/
theorem Subring.inv_mem_of_isField {F : Type*} [Field F] {R : Subring F} (hR : IsField R)
    {x : F} (hx : x ∈ R) (hx0 : x ≠ 0) : x⁻¹ ∈ R := by
  obtain ⟨z, hz⟩ := hR.mul_inv_cancel (a := ⟨x, hx⟩)
    (by simpa [Subring.coe_eq_zero_iff] using hx0)
  have hxz : x * (z : F) = 1 := by simpa using congrArg (Subring.subtype R) hz
  rw [inv_eq_of_mul_eq_one_right hxz]
  exact z.property

/-- Let `P` be a maximal ideal of the fiber `C := κ(p) ⊗_A B`, and let `q` be the prime of `B`
lying over `p` that corresponds to `P` under `PrimeSpectrum.primesOverOrderIsoFiber`. Then there is
a `κ(p)`-algebra isomorphism `C ⧸ P.asIdeal ≃ₐ[κ(p)] κ(q)`, where `κ(q)` carries its `κ(p)`-algebra
structure from `Ideal.ResidueField.map`. Maximality of `P` is needed: otherwise `C ⧸ P.asIdeal`
need not be a field. -/
theorem Ideal.nonempty_fiber_residue_algEquiv {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [Algebra A B] (p : Ideal A) [p.IsPrime]
    {P : PrimeSpectrum (p.Fiber B)} [P.asIdeal.IsMaximal]
    (q : p.primesOver B) (hq : PrimeSpectrum.primesOverOrderIsoFiber A B p q = P) :
    letI : Algebra p.ResidueField ((q : Ideal B)).ResidueField :=
      (Ideal.ResidueField.map p _ (algebraMap A B)
        (Ideal.primesOver.liesOver p q).over).toAlgebra
    Nonempty ((p.Fiber B ⧸ P.asIdeal) ≃ₐ[p.ResidueField]
      ((q : Ideal B)).ResidueField) := by
  let hlo : (q : Ideal B).LiesOver p := Ideal.primesOver.liesOver p q
  let algκ : Algebra p.ResidueField (q:Ideal B).ResidueField :=
    (Ideal.ResidueField.map p _ (algebraMap A B) hlo.over).toAlgebra
  let φ1 : p.ResidueField →ₐ[A] (q:Ideal B).ResidueField :=
    Ideal.ResidueField.mapₐ p (q:Ideal B) (Algebra.ofId A B) hlo.over
  let φ2 : B →ₐ[A] (q:Ideal B).ResidueField := IsScalarTower.toAlgHom A B (q:Ideal B).ResidueField
  let Φ_A : p.ResidueField ⊗[A] B →ₐ[A] (q:Ideal B).ResidueField :=
    Algebra.TensorProduct.lift φ1 φ2 (fun x y => mul_comm _ _)
  -- `P.asIdeal` is the kernel of `Φ_A` definitionally, once `P` is recovered from `q`.
  have hker : P.asIdeal = RingHom.ker Φ_A.toRingHom := by rw [← hq]; rfl
  have key : ∀ r : p.ResidueField,
      Φ_A.toRingHom (algebraMap p.ResidueField (p.ResidueField ⊗[A] B) r)
      = algebraMap p.ResidueField (q:Ideal B).ResidueField r := by
    intro r
    rw [Algebra.TensorProduct.algebraMap_apply]
    show Φ_A (r ⊗ₜ[A] 1) = _
    rw [Algebra.TensorProduct.lift_tmul]
    simp only [map_one, mul_one]
    rfl
  let Φ : p.ResidueField ⊗[A] B →ₐ[p.ResidueField] (q:Ideal B).ResidueField :=
    { Φ_A.toRingHom with commutes' := key }
  set R : Subring (q:Ideal B).ResidueField := Φ_A.toRingHom.range
  have hfield : IsField R :=
    MulEquiv.isField ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp inferInstance)
      ((Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivRange _)).symm.toMulEquiv
  have hBmem : ∀ b : B, algebraMap B (q:Ideal B).ResidueField b ∈ R := by
    intro b
    refine ⟨Algebra.TensorProduct.includeRight b, ?_⟩
    show Φ_A ((1 : p.ResidueField) ⊗ₜ[A] b) = _
    rw [Algebra.TensorProduct.lift_tmul]
    simp [φ2, IsScalarTower.toAlgHom_apply]
  have hQmem : ∀ c : B ⧸ (q:Ideal B),
      algebraMap (B ⧸ (q:Ideal B)) (q:Ideal B).ResidueField c ∈ R := by
    intro c
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
    rw [show algebraMap (B ⧸ (q:Ideal B)) (q:Ideal B).ResidueField (Ideal.Quotient.mk (q:Ideal B) b)
        = algebraMap B (q:Ideal B).ResidueField b by
        rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply]]
    exact hBmem b
  have hsurjA : Function.Surjective Φ_A := by
    rw [← AlgHom.range_eq_top, eq_top_iff]
    rintro y -
    obtain ⟨x, d, hd, hxd⟩ := IsFractionRing.div_surjective (A := B ⧸ (q:Ideal B)) y
    have hadne : algebraMap (B ⧸ (q:Ideal B)) (q:Ideal B).ResidueField d ≠ 0 := by
      simp only [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective _ _)]
      exact nonZeroDivisors.ne_zero hd
    rw [← hxd, div_eq_mul_inv]
    exact R.mul_mem (hQmem x) (Subring.inv_mem_of_isField hfield (hQmem d) hadne)
  have hkerΦ : RingHom.ker Φ = P.asIdeal := hker.symm
  exact ⟨hkerΦ ▸ Ideal.quotientKerAlgEquivOfSurjective (f := Φ) hsurjA⟩

/-- The fiber `κ(p) ⊗[A] B` of a Noetherian `A`-algebra `B` at a prime `p` is Noetherian. -/
theorem Ideal.isNoetherianRing_fiber {A : Type u} [CommRing A] (p : Ideal A) [p.IsPrime]
    (B : Type v) [CommRing B] [Algebra A B] [IsNoetherianRing B] :
    IsNoetherianRing (p.Fiber B) := by
  let := Algebra.TensorProduct.rightAlgebra (R := A) (A := Localization.AtPrime p) (B := B)
  have hloc : IsLocalization (Algebra.algebraMapSubmonoid B p.primeCompl)
      (Localization.AtPrime p ⊗[A] B) := inferInstance
  have : IsNoetherianRing (Localization.AtPrime p ⊗[A] B) :=
    IsLocalization.isNoetherianRing (Algebra.algebraMapSubmonoid B p.primeCompl) _ inferInstance
  have hsurj : Function.Surjective
      ⇑(IsScalarTower.toAlgHom A (Localization.AtPrime p) p.ResidueField) := by
    show Function.Surjective (IsLocalRing.residue (Localization.AtPrime p))
    exact IsLocalRing.residue_surjective
  have hmap : Function.Surjective
      ⇑(Algebra.TensorProduct.map (S := A)
        (IsScalarTower.toAlgHom A (Localization.AtPrime p) p.ResidueField)
        (AlgHom.id A B)) :=
    Algebra.TensorProduct.map_surjective _ _ hsurj Function.surjective_id
  exact isNoetherianRing_of_surjective (Localization.AtPrime p ⊗[A] B)
    (p.Fiber B) (Algebra.TensorProduct.map _ _).toRingHom hmap

/-! ## Main result -/

/-- Let `A` be a commutative ring and `B` an `A`-algebra which is a filtered colimit of
étale `A`-algebras and which is a Noetherian ring. Let `p` be a prime of `A`. Then
there are finitely many primes `q : Fin r → Ideal B`, all lying over `p`, such that:

* the fiber `B ⊗_A κ(p)` is isomorphic, as a `κ(p)`-algebra, to the (finite) product
  `∏ᵢ κ(qᵢ)` of the residue fields;
* each extension `κ(qᵢ)/κ(p)` is separable algebraic;
* the `qᵢ` are exactly the primes of `B` lying over `p` (`q` is injective and its
  range is the set of primes lying over `p`).

The `κ(p)`-algebra structure on each residue field `κ(qᵢ)` is the canonical one
induced by `Ideal.ResidueField.map` from the structure map `A → B`. -/
@[stacks 0AH1,
  ega "IV 18.6.9" "more general",
  sga "1 IX 1.8" "decomposition direction",
  sga "1 IX 1.9" "partial, special case",
  sga "4½ Arcata 2.4.2" "Only-if direction"]
theorem IsFilteredColimitEtale.exists_fiber_algEquiv_pi_residueField
    {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B] [IsNoetherianRing B]
    (hcolim : IsFilteredColimitEtale.{u, v, x, y} A B) (p : Ideal A) [p.IsPrime] :
    ∃ (r : ℕ) (q : Fin r → Ideal B) (hq : ∀ i, (q i).IsPrime)
      (hlo : ∀ i, (q i).LiesOver p),
      -- (1) product decomposition of the fiber algebra, and
      -- (2) separable algebraicity of each factor:
      (letI : ∀ i, (q i).IsPrime := hq
       letI : ∀ i, Algebra p.ResidueField (q i).ResidueField := fun i =>
         (Ideal.ResidueField.map p (q i) (algebraMap A B) (hlo i).over).toAlgebra
       Nonempty
         (TensorProduct A p.ResidueField B ≃ₐ[p.ResidueField]
           (∀ i, (q i).ResidueField)) ∧
       (∀ i, Algebra.IsSeparable p.ResidueField (q i).ResidueField) ∧
       (∀ i, Algebra.IsAlgebraic p.ResidueField (q i).ResidueField)) ∧
      -- the `qᵢ` are precisely the primes of `B` lying over `p`:
      Function.Injective q ∧
      (∀ q' : Ideal B, ∀ _ : q'.IsPrime, q'.LiesOver p ↔ ∃ i, q i = q') := by
  set C := p.Fiber B
  have hCcolim : IsFilteredColimitEtale p.ResidueField C := hcolim.baseChange p.ResidueField
  have hCred : IsReduced C := hCcolim.isReduced
  have hCdim : Ring.KrullDimLE 0 C := hCcolim.krullDimLE_zero
  have hCnoeth : IsNoetherianRing C := p.isNoetherianRing_fiber B
  have hCart : IsArtinianRing C := IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
  have : Finite (MaximalSpectrum C) := IsArtinianRing.instFiniteMaximalSpectrum C
  set Θ := PrimeSpectrum.primesOverOrderIsoFiber A B p
  set Pm : MaximalSpectrum C → PrimeSpectrum C :=
    fun m => ⟨m.asIdeal, m.isMaximal.isPrime⟩
  set qm : MaximalSpectrum C → ↑(p.primesOver B) := fun m => Θ.symm (Pm m)
  let algκ : ∀ m : MaximalSpectrum C, Algebra p.ResidueField ((qm m : Ideal B)).ResidueField :=
    fun m => (Ideal.ResidueField.map p _ (algebraMap A B)
      (Ideal.primesOver.liesOver p (qm m)).over).toAlgebra
  have ek : ∀ m : MaximalSpectrum C,
      Nonempty ((C ⧸ m.asIdeal) ≃ₐ[p.ResidueField] ((qm m : Ideal B)).ResidueField) := fun m =>
    have : (Pm m).asIdeal.IsMaximal := m.isMaximal
    p.nonempty_fiber_residue_algEquiv (qm m) (Θ.apply_symm_apply (Pm m))
  classical
  let eke : ∀ m : MaximalSpectrum C,
      (C ⧸ m.asIdeal) ≃ₐ[p.ResidueField] ((qm m : Ideal B)).ResidueField := fun m => (ek m).some
  set r := Nat.card (MaximalSpectrum C)
  set e : MaximalSpectrum C ≃ Fin r := Finite.equivFin (MaximalSpectrum C)
  refine ⟨r, fun i => (qm (e.symm i) : Ideal B),
    fun i => Ideal.primesOver.isPrime p (qm (e.symm i)),
    fun i => Ideal.primesOver.liesOver p (qm (e.symm i)), ⟨?_, ?_, ?_⟩, ?_, ?_⟩
  · exact ⟨(((IsArtinianRing.equivPi C).restrictScalars p.ResidueField).trans
      (AlgEquiv.piCongrRight eke)).trans
      (AlgEquiv.piCongrLeft' p.ResidueField (fun m => ((qm m : Ideal B)).ResidueField) e)⟩
  · exact fun i => (AlgEquiv.Algebra.isSeparable_iff (eke (e.symm i))).mp
      (hCcolim.isSeparable_quotient (e.symm i).asIdeal)
  · exact fun i => (AlgEquiv.isAlgebraic_iff (eke (e.symm i))).mp
      (hCcolim.isAlgebraic_quotient (e.symm i).asIdeal)
  · intro i j h
    exact e.symm.injective (MaximalSpectrum.ext (congrArg PrimeSpectrum.asIdeal
      (Θ.symm.injective (Subtype.val_injective h))))
  · refine fun q' hq' => ⟨fun hlo' => ?_,
      fun ⟨i, h⟩ => h ▸ Ideal.primesOver.liesOver p (qm (e.symm i))⟩
    let x : ↑(p.primesOver B) := ⟨q', hq', hlo'⟩
    refine ⟨e ⟨(Θ x).asIdeal, Ring.krullDimLE_zero_iff.mp hCdim _ (Θ x).isPrime⟩, ?_⟩
    show (qm (e.symm (e _)) : Ideal B) = q'
    rw [e.symm_apply_apply]
    exact congrArg Subtype.val (Θ.symm_apply_apply x)
