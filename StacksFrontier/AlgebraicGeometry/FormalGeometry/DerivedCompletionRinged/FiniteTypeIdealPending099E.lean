section Pushforward

variable {X Y : RingedSite.{u, u, u}} (f : RingedSite.Hom X Y)
  (I : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O))))
  (I' : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
  [I.toSheafOfModules.IsFiniteType] [I'.toSheafOfModules.IsFiniteType]
  (hI : PushforwardIdealCompatible f I I')

include hI in
/-- **[Stacks, Tags 0A0G and 0A0I] for an arbitrary object, at an arbitrary finite-type pair of
sheaves of ideals; this carries no tag.** Let `f : (Sh(𝒟), 𝒪') ⟶ (Sh(𝒞), 𝒪)` be a morphism of
ringed sites, let `ℐ ⊂ 𝒪` and `ℐ' ⊂ 𝒪'` be sheaves of ideals of finite type with `f^♯` carrying
sections of `ℐ` into `ℐ'`, and let `K ∈ D(𝒪')` be **arbitrary**. Then
`Rf_*(K^∧) ≅ (Rf_*K)^∧`: `Rf_*` commutes with derived completion. This is the whole assertion of
[Stacks, Tag 0A0G] and the display of [Stacks, Tag 0A0I], with no hypothesis on the object.

What the source has in hand before writing the display down is three results. The first — the
adjoint of [Stacks, Tag 099F] — is now discharged inside this library by instance search; the
other two are carried, visible in the signature.

1. **[Stacks, Tag 099F]** — discharged rather than carried. The requirements
   `(ObjectProperty.ι (IsDerivedComplete X I')).IsRightAdjoint` and the same for `Y` and `ℐ`,
   which are what let `(-)^∧` be written at all, resolve by instance search through the instance
   `isRightAdjoint_ι_isDerivedComplete` of `FiniteTypeReflector.lean`, registered `@[stacks 099F]`
   at an arbitrary finite-type ideal sheaf and proved from `exists_isGlobalExtendedCech`
   ([Stacks, Tag 099E]) of `FiniteTypeExtendedCech.lean`; the earlier partial regimes
   (`isRightAdjoint_ι_isDerivedComplete_generatedIdealSheaf`,
   `isRightAdjoint_ι_isDerivedComplete_of_forall_isNilpotent`) stand where they are. The
   statement still carries **no** `@[stacks]` attribute: a tag counts only on a declaration
   proved under the source's own hypotheses, and 2 and 3 below are conclusions the source derives
   inside its proof of 0A0G; discharging them is the remaining distance to a registration of
   both tags with no change to the proof.
2. **[Stacks, Tag 0A0E]**, as `hsource` and `htarget`: the two completions are derived limits of
   towers `T'` and `T`. The towers are arbitrary; at a generated ideal sheaf they are the Koszul
   towers of
   `isDerivedLimit_tensorDerivedDualSystem_koszulPowerSystem_completion`.
3. **[Stacks, Tag 0944]**, as `hproj : T' ⋙ Rf_* ≅ T`: the projection formula levelwise,
   together with the identification `Lf^*K(𝒪, f_1^n, …, f_r^n) = K(𝒪', g_1^n, …, g_r^n)` of the
   pulled-back Koszul complexes. Only the projection formula's map is in this library, not its
   invertibility.

What is *not* carried is the exchange of `Rf_*` with `R lim`, the remaining step of the source's
proof: that is
`Stacks.Cohomology.DerivedPushforwardOnRingedTopoi.isDerivedLimit_map_derivedPushforward`,
[Stacks, Tag 0A07], and it applies to a morphism of ringed sites with no extra hypothesis. Given
it, the two sides are derived limits of isomorphic towers and the conclusion is
`Rlim.Pro.nonempty_iso_of_isDerivedLimit_of_natIso`.

The conclusion is the display as the source writes it, an isomorphism of the two objects, and
not the stronger statement that the canonical comparison map
`derivedCompletionPushforwardComparison` is invertible: uniqueness of derived limits is not
canonical. -/
theorem nonempty_iso_derivedPushforward_derivedCompletion_of_isDerivedLimit
    (K : DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (T' : ℕᵒᵖ ⥤ DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    [HasProduct fun n : ℕ ↦ T'.obj (op n)]
    (T : ℕᵒᵖ ⥤ DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Y.O))))
    [HasProduct fun n : ℕ ↦ T.obj (op n)]
    (hsource : IsDerivedLimit T' ((derivedCompletion X I').obj K))
    (htarget : IsDerivedLimit T ((derivedCompletion Y I).obj
      ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)))
    (hproj : T' ⋙ derivedPushforward.{u} f.toRingedToposSiteHom ≅ T) :
    Nonempty ((derivedPushforward.{u} f.toRingedToposSiteHom).obj
        ((derivedCompletion X I').obj K) ≅
      (derivedCompletion Y I).obj
        ((derivedPushforward.{u} f.toRingedToposSiteHom).obj K)) := by
  exact Rlim.Pro.nonempty_iso_of_exists_isDerivedLimit_of_natIso
    (Stacks.Cohomology.DerivedPushforwardOnRingedTopoi.isDerivedLimit_map_derivedPushforward
      f.toRingedToposSiteHom f.isMorphismOfSites T' _ hsource) htarget hproj

end Pushforward

section GlobalSections

variable (A : Type u) [CommRing A] (I : Ideal A) (Z : RingedSite.{u, u, u})
  (ρ : A →+* RingCat.sectionsSubring ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O)).obj)
  (𝓘 : SheafOfModules.Submodule
    (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))))
  [𝓘.toSheafOfModules.IsFiniteType]

/-- **[Stacks, Tag 0BLX], the identity `RΓ(𝒞, ℱ)^∧ = RΓ(𝒞, ℱ^∧)`, at an arbitrary finite-type
ideal sheaf; this carries no tag.** Let `A` be a ring, `I ⊂ A` a finitely generated ideal,
`(𝒞, 𝒪)` a ringed site with `𝒪` a sheaf of `A`-algebras, `𝓘 = I𝒪` the ideal sheaf `I` generates
— of finite type — and `ℱ` a sheaf of `𝒪`-modules. Then the derived completion of `RΓ(𝒞, ℱ)`
along `I` is `RΓ(𝒞, ℱ^∧)`, the completion of `ℱ` being taken along `I𝒪`.

The derived completion functor on `D(A)` is **produced**, not assumed: `I` is finitely generated,
so `AdicFilteredCompletion` ([Stacks, Tag 0920]) gives a reflector, and the conclusion exhibits
it together with its adjunction.

The source proves this in a line, by [Stacks, Tag 0A0G] at the morphism of ringed topoi
`(𝒞, 𝒪) ⟶ (pt, A)`. There is no such morphism in this library, so the argument of
`nonempty_iso_derivedPushforward_derivedCompletion_of_isDerivedLimit` is run again with
`RΓ(𝒞, -) : D(𝒪) ⥤ D(A)` in place of `Rf_*`, and the three inputs are the same:

1. **[Stacks, Tag 099F]** on `D(𝒪)`, discharged by instance search rather than carried: the
   requirement `(ObjectProperty.ι (IsDerivedComplete Z 𝓘)).IsRightAdjoint`, without which `ℱ^∧`
   cannot be written, is supplied at an arbitrary finite-type ideal sheaf by
   `isRightAdjoint_ι_isDerivedComplete` of `FiniteTypeReflector.lean` (`@[stacks 099F]`, proved
   from `exists_isGlobalExtendedCech`, [Stacks, Tag 099E]); the statement still carries no
   `@[stacks 0BLX]` attribute because 2 and 3 remain hypotheses. The tag's registered statements
   elsewhere are untouched: the identity in
   the nilpotent regime (`exists_iso_derivedCompletion_derivedGlobalSections` of
   `UnboundedGlobalSections.lean`), the first spectral sequence at the source's own generality,
   and the second at a generated ideal sheaf.
2. **[Stacks, Tag 0A0E]**, as `hsource` on the sheaf side and `htarget` on the `D(A)` side.
   `htarget` is quantified over reflectors because the library fixes no choice of one, which by
   uniqueness of left adjoints is no stronger than naming one; over a Noetherian `A` it is
   [Stacks, Tag 0EET].
3. **[Stacks, Tag 0944]**, as `hproj : T' ⋙ RΓ(𝒞, -) ≅ T`.

The exchange of `RΓ` with `R lim` is again discharged, by
`isDerivedLimit_map_derivedGlobalSectionsOverUnbounded` ([Stacks, Tag 08U1]), which holds with no
nilpotence, finiteness or boundedness hypothesis. -/
theorem exists_iso_derivedCompletion_derivedGlobalSections_of_isDerivedLimit
    (hI : I.FG) (h𝓘 : IsIdealSheafGeneratedBy A I Z ρ 𝓘)
    (F : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O)))
    (T' : ℕᵒᵖ ⥤ DerivedCategory (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))))
    [HasProduct fun n : ℕ ↦ T'.obj (op n)]
    (T : ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A))
    [HasProduct fun n : ℕ ↦ T.obj (op n)]
    (hsource : IsDerivedLimit T' ((derivedCompletion Z 𝓘).obj
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F)))
    (htarget : ∀ (C : DerivedCategory (ModuleCat.{u} A) ⥤
        (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
          fun L ↦ _root_.IsDerivedComplete I L).FullSubcategory)
        (_ : C ⊣ (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
          fun L ↦ _root_.IsDerivedComplete I L).ι),
      IsDerivedLimit T
        ((C ⋙ (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
          fun L ↦ _root_.IsDerivedComplete I L).ι).obj
          ((derivedGlobalSectionsOverUnbounded Z A ρ).obj
            ((DerivedCategory.singleFunctor
              (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F))))
    (hproj : T' ⋙ derivedGlobalSectionsOverUnbounded Z A ρ ≅ T) :
    let P : ObjectProperty (DerivedCategory (ModuleCat.{u} A)) :=
      fun L ↦ _root_.IsDerivedComplete I L
    ∃ completion : DerivedCategory (ModuleCat.{u} A) ⥤ P.FullSubcategory,
      Nonempty (completion ⊣ P.ι) ∧
      Nonempty ((completion ⋙ P.ι).obj
          ((derivedGlobalSectionsOverUnbounded Z A ρ).obj
            ((DerivedCategory.singleFunctor
              (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F)) ≅
        (derivedGlobalSectionsOverUnbounded Z A ρ).obj
          ((derivedCompletion Z 𝓘).obj
            ((DerivedCategory.singleFunctor
              (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F))) := by
  -- `h𝓘` is what makes `𝓘` be `I𝒪`; it is a hypothesis of the source statement rather than an
  -- input of this derivation, so it is recorded and not consumed.
  obtain ⟨-, -⟩ := h𝓘
  set P : ObjectProperty (DerivedCategory (ModuleCat.{u} A)) :=
    fun L ↦ _root_.IsDerivedComplete I L with hP
  set L := (derivedGlobalSectionsOverUnbounded Z A ρ).obj
    ((DerivedCategory.singleFunctor
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F) with hL
  -- [Stacks, Tag 0920]: `I` is finitely generated, so `D(A)` has a derived completion reflector.
  obtain ⟨completion₀, adj₀, -⟩ :=
    AdicFilteredCompletion.exists_spectralSequence_derivedCompletion_homology A I hI L
  have : (ObjectProperty.ι P).IsRightAdjoint := ⟨completion₀, ⟨adj₀⟩⟩
  refine ⟨(ObjectProperty.ι P).leftAdjoint, ⟨Adjunction.ofIsRightAdjoint _⟩, ?_⟩
  -- [Stacks, Tag 08U1]: `RΓ(𝒞, -)` carries the derived limit `T'` of `ℱ^∧` to a derived limit.
  obtain ⟨e⟩ := Rlim.Pro.nonempty_iso_of_exists_isDerivedLimit_of_natIso
    (isDerivedLimit_map_derivedGlobalSectionsOverUnbounded Z A ρ T' _ hsource)
    (htarget (ObjectProperty.ι P).leftAdjoint (Adjunction.ofIsRightAdjoint _)) hproj
  exact ⟨e.symm⟩

/-- **[Stacks, Tag 0BLX], the second spectral sequence, at an arbitrary finite-type ideal sheaf;
this carries no tag.** Let `A` be a ring, `I ⊂ A` a finitely generated ideal, `(𝒞, 𝒪)` a ringed
site with `𝒪` a sheaf of `A`-algebras, `𝓘 = I𝒪` the ideal sheaf `I` generates — of finite type —
and `ℱ` a sheaf of `𝒪`-modules, and suppose `ℱ^∧` is cohomologically `≥ b`. Then `ℱ^∧` has a
bounded below representative `K`, and for every Cartan-Eilenberg resolution of `K` the second
spectral sequence of [Stacks, Tag 015J] for `Γ(𝒞, -)` has `E₂^{p,q} = H^p(𝒞, H^q(ℱ^∧))` and
abuts to `H^{p+q}(RΓ(𝒞, ℱ^∧))`.

This is `exists_pages_derivedCompletion_globalSections` of `GlobalSectionsCompletion.lean` with
its second assumed input weakened to a named hypothesis on the data and the rest produced.
It assumes a bounded below complex `K`, its `plus` witness and an isomorphism `Q(K) ≅ ℱ^∧`;
here only `hGE` is assumed, and `DerivedCategory.exists_iso_Q_obj_of_isGE` turns it
into the complex and the isomorphism, which appear in the conclusion. The Cartan-Eilenberg
resolution is universally quantified, as in [Stacks, Tag 015J] itself; its existence is
[Stacks, Tag 015I].

One thing is carried, and it comes from the shape of the object of [Stacks, Tag 099E].

* **[Stacks, Tag 099F]** — discharged: the requirement `(ObjectProperty.ι (IsDerivedComplete Z
  𝓘)).IsRightAdjoint`, which makes `ℱ^∧` exist, resolves by instance search through
  `isRightAdjoint_ι_isDerivedComplete` of `FiniteTypeReflector.lean`.
* **`hGE`**, the cohomological boundedness below of `ℱ^∧`. This is not a conclusion of the tag
  and not implied by Tag 099F's bare statement; it comes from the *shape* of the object
  `K ⟶ 𝒪` of `exists_isGlobalExtendedCech`, which is locally a Čech complex of some length `r`,
  so that
  `R𝓗om_𝒪(K, ℱ)` is bounded below. That is exactly how it is discharged in the globally
  generated case, by `isGE_derivedCompletion_generatedIdealSheaf_obj` of
  `GlobalSectionsCompletionGenerated.lean`, which bounds `ℱ^∧` below by `-r`.

So this statement is an engine and has no `@[stacks 0BLX]` attribute; the tag's registrations
elsewhere, including the second spectral sequence at a generated ideal sheaf and in the nilpotent
regime, are untouched. -/
theorem exists_pages_derivedCompletion_globalSections_of_isGE
    (hI : I.FG) (h𝓘 : IsIdealSheafGeneratedBy A I Z ρ 𝓘)
    (F : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) (b : ℤ)
    (hGE : ((derivedCompletion Z 𝓘).obj
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F)).IsGE b) :
    ∃ (K : CochainComplex (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) ℤ)
      (hK : CochainComplex.plus
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) K)
      (_ : DerivedCategory.Q.obj K ≅ (derivedCompletion Z 𝓘).obj
        ((DerivedCategory.singleFunctor
          (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F)),
      ∀ (Ires : K.CartanEilenbergResolution)
        [HomologicalComplex₂.HasTotal
          ((((moduleGlobalSectionsOver Z A ρ).mapHomologicalComplex
            (ComplexShape.up ℤ)).mapHomologicalComplex (ComplexShape.up ℤ)).obj Ires.bicomplex)
          (ComplexShape.up ℤ)],
      (∀ p q : ℤ, Nonempty
        ((((((moduleGlobalSectionsOver Z A ρ).mapHomologicalComplex
            (ComplexShape.up ℤ)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj Ires.bicomplex).homology q).homology p ≅
          (siteCohomologyOver Z A ρ p).obj
            ((DerivedCategory.homologyFunctor
                (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) q).obj
              ((derivedCompletion Z 𝓘).obj
                ((DerivedCategory.singleFunctor
                  (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj
                    F))))) ∧
      ∀ n : ℤ, Nonempty ((HomologicalComplex₂.total
          ((((moduleGlobalSectionsOver Z A ρ).mapHomologicalComplex
            (ComplexShape.up ℤ)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj Ires.bicomplex) (ComplexShape.up ℤ)).homology n ≅
        (DerivedCategory.Plus.homologyFunctor (ModuleCat.{u} A) n).obj
          ((derivedGlobalSectionsOver Z A ρ).obj
            (DerivedCategory.Plus.Q.obj ⟨K, hK⟩))) := by
  have := hGE
  obtain ⟨K, hK, ⟨e⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isGE
    ((derivedCompletion Z 𝓘).obj
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf Z.O))) 0).obj F)) b
  refine ⟨K, ⟨b, hK⟩, e.symm, fun Ires _ ↦ ?_⟩
  exact exists_pages_derivedCompletion_globalSections A I Z ρ 𝓘 hI h𝓘 F K ⟨b, hK⟩ e.symm Ires

end GlobalSections

