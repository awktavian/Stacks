open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated Opposite
open AlgebraicGeometry
open Stacks.Cohomology.DerivedPullbackPushforwardAdjunction

universe u

namespace Rlim.Pro

/-- **Derived limits of isomorphic inverse systems are isomorphic.** If `F ≅ G` as functors
`ℕᵒᵖ ⥤ D` in a pretriangulated category, `K` is a derived limit of `F` and `M` is a derived
limit of `G`, then `K ≅ M` — not canonically.

This is [Stacks, Tag 0H9L], `nonempty_iso_of_isDerivedLimit_of_pro_isomorphism`, read at the
pro-isomorphism that an isomorphism of systems is (`InverseSequence.ProIso.ofNatIso`). It is the
step by which the source of [Stacks, Tag 0A0G] concludes, having rewritten both sides of its
display as derived limits of towers it has identified with each other. -/
theorem nonempty_iso_of_isDerivedLimit_of_natIso {D : Type*} [Category D]
    [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {F G : ℕᵒᵖ ⥤ D} [HasProduct fun n : ℕ ↦ F.obj (op n)]
    [HasProduct fun n : ℕ ↦ G.obj (op n)] {K M : D}
    (hK : IsDerivedLimit F K) (hM : IsDerivedLimit G M) (e : F ≅ G) :
    Nonempty (K ≅ M) :=
  nonempty_iso_of_isDerivedLimit_of_pro_isomorphism F G K M hK hM
    (InverseSequence.ProIso.ofNatIso e)

/-- Derived limits `K` of `F` and `M` of `G` are isomorphic when `F ≅ G`, the product for `F` being
given existentially (as the exchange lemmas for derived functors provide it). -/
private theorem nonempty_iso_of_exists_isDerivedLimit_of_natIso {D : Type*} [Category D]
    [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {F G : ℕᵒᵖ ⥤ D} [HasProduct fun n : ℕ ↦ G.obj (op n)] {K M : D}
    (hK : ∃ _ : HasProduct fun n : ℕ ↦ F.obj (op n), IsDerivedLimit F K)
    (hM : IsDerivedLimit G M) (e : F ≅ G) : Nonempty (K ≅ M) :=
  hK.elim fun _ hK ↦ nonempty_iso_of_isDerivedLimit_of_natIso hK hM e

end Rlim.Pro

